#compdef tando
# zsh completion for tando. Generated by completions/gen.sh: edit that, not this file.
# Install: put this file (named _tando) in a directory on $fpath before compinit
# (install.sh uses PREFIX/share/zsh/site-functions).

_tando_hosts() {
  local -a h
  h=(${TANDO_CONFIG_DIR:-$HOME/.config/tando}/hosts/*(N:t))
  compadd -a h
}
_tando_apps() {
  local -a a
  local d=${TANDO_CONFIG_DIR:-$HOME/.config/tando}
  [[ -f tando.conf ]] &&
    a+=(${(f)"$(sed -n 's/^[[:space:]]*app[[:space:]]*=[[:space:]]*\([a-z0-9-]*\).*/\1/p' tando.conf)"})
  a+=(${(f)"$(cat $d/cache/apps.*(N) 2> /dev/null)"})
  compadd -a a
}

_tando() {
  local -a cmds plugins
  local self=${commands[tando]}
  cmds=(
    'init:Write tando.conf for the project in this directory. It detects the recipe'
    'up:Create the app on the server if it does not exist yet, apply tando.conf and'
    'deploy:Build here, upload the changes, start the new release on a spare port, check'
    'rollback:Go back to the previous verified release, or to the release <id> (tando'
    'releases:The releases kept on the server, newest first, with their state and age.'
    'history:Deploys and rollbacks with their result and phase times, newest first. Without'
    'status:One app in detail - state, release, memory, cpu, the last 16 minutes, logs,'
    'ls:The apps of a server - state, when deployed, memory, cpu, uptime and link.'
    'logs:The apps output (stdout and stderr), from its own journal on the server.'
    'start:Start a stopped app. Requests are held while it starts, so none is dropped.'
    'stop:Stop the app. Visitors get 503 <app> is stopped until tando start; jobs'
    'restart:Restart the app (requests are held meanwhile, so none is dropped).'
    'top:A live full-screen dashboard of every registered server - apps, graphs, logs'
    'env:The apps environment variables, stored on the server (root, 640), never in'
    'jobs:run <name> runs a scheduled job now and shows its output and exit code.'
    'db:The apps PostgreSQL database (database = postgres in tando.conf). Without a'
    'backup:Backups of the apps data directory and database (daily when the app has one).'
    'restore:Put a backup back - the same as tando backup restore, and a backup that is only'
    'host:add registers a server (a fresh Ubuntu 24.04+ with sshd and a login with'
    'domain:Serve the app on your own domain with HTTPS (Lets Encrypt; Caddy renews it).'
    'doctor:Check a server - connection, sudo, every tando piece and its version, Caddy,'
    'version:The client version, and the agent version of the server.'
    'destroy:Remove the app from the server - its unit, Caddy site, user, releases, data and'
    'unlock:Clear the lock of a deploy whose terminal went away. A deploy that is still'
    'recipes:What tando init detects, how each recipe runs and what it needs on the server.'
    'ci:Deploy keys for CI, run by the admin in the apps directory. setup creates a'
    'alerts:What is firing on the server, and where alerts are sent. Checks run every'
    'health:Is it up, and was it - uptime over 24 hours and 7 days, incidents (start,'
    'errors:The errors in the apps own log, grouped - a stack trace (Node, Python, Go)'
    'requests:The apps request log as Caddy wrote it - counts, status codes, latency'
    'audit:Who changed what on the server - one row per deploy, env change, restart,'
    'adopt:Take over an app that was deployed by hand (a systemd unit behind Caddy) - plan'
    'help:The list of commands, or the help of one command (tando help alerts notifier'
    'cheat:the commands that matter, on one screen'
    'go:the setup wizard (docs/EASE.md)'
    'link:print the apps address (its own domain, else its link), for scripts'
    'next:what you could do next on this app and server, with the command'
    'open:open the app in the browser (prints the address when there is none)'
    'ssh:a shell on the server; with an app, as the apps user in its sandbox'
  )
  if [[ -n $self ]]; then
    self=${self:A}
    plugins=(${self:h}/../lib/cmd-*.sh(N:t:r))
    plugins=(${plugins#cmd-})
  fi
  local curcontext=$curcontext state line
  _arguments -C \
    '-a[app]:app:_tando_apps' \
    '-H[host]:host:_tando_hosts' \
    '1:command:->cmd' \
    '*::arg:->args'
  case $state in
    cmd) _describe -t commands 'tando command' cmds; (( ${#plugins} )) && compadd -a plugins ;;
    args)
      local subs="" flags="" args=""
      case $line[1] in
        init) subs="" flags="-H --yes" args="" ;;
        up) subs="" flags="-H --yes --force --wait" args="" ;;
        deploy) subs="" flags="-a -H --force --yes --wait" args="" ;;
        rollback) subs="" flags="-H -a" args="apps" ;;
        releases) subs="" flags="-H --json -a" args="apps" ;;
        history) subs="" flags="-n -H --json -a" args="apps" ;;
        status) subs="" flags="--watch -H --json -a" args="apps" ;;
        ls) subs="" flags="-H --all --watch --json" args="" ;;
        logs) subs="pull" flags="-f -n --since --until --grep -i --regex -E -a -H --level --release --deploy --json" args="apps" ;;
        start) subs="" flags="-H -a" args="apps" ;;
        stop) subs="" flags="-H -a" args="apps" ;;
        restart) subs="" flags="-H -a" args="apps" ;;
        top) subs="" flags="--watch --read-only -H" args="hosts" ;;
        env) subs="ls set unset import" flags="--show -a -H" args="apps" ;;
        jobs) subs="run ls" flags="-H -a" args="apps" ;;
        db) subs="psql url studio info" flags="-a -H --show --no-open --idle --stop" args="apps" ;;
        backup) subs="ls now restore pull offsite" flags="-a -H --yes --show --saved --import --rotate" args="apps" ;;
        restore) subs="" flags="-a --yes -H --from-host --all" args="" ;;
        host) subs="add setup ls rm status care update reboot" flags="--port --key --yes --force --insecure-test --no-check --deploy --json --watch --all --now --updates --reboot --window --tz --lead --even-with-other-sites" args=""
          [[ $CURRENT -eq 3 && $words[2] == (setup|rm) ]] && { _tando_hosts; return } ;;
        domain) subs="add rm ls" flags="--www --wait --force -a -H" args="apps" ;;
        doctor) subs="" flags="-H" args="hosts" ;;
        version) subs="" flags="-H" args="" ;;
        destroy) subs="" flags="-H --purge --yes -a" args="apps" ;;
        unlock) subs="" flags="-H -a" args="apps" ;;
        recipes) subs="" flags="" args="" ;;
        ci) subs="setup rotate ls revoke github hook" flags="-a -H --ref --repo --branch --node --env --force --remove" args="" ;;
        alerts) subs="enable disable test history set silence notifier rm ls heartbeat backup-ping show notifiers" flags="--watch -n -a -H" args="apps" ;;
        health) subs="" flags="--json -a -H --forget" args="apps" ;;
        errors) subs="" flags="--since -n --json -a -H --last" args="apps" ;;
        requests) subs="tail errors summary" flags="--since -a -H --last -n -f --4xx" args="apps" ;;
        audit) subs="" flags="-n -H -a" args="apps" ;;
        adopt) subs="plan apply undo status site" flags="--health --no-jobs --yes --accept-502 -H --apply" args="apps" ;;
        help) subs="" flags="" args="" ;;
        cheat) subs="" flags="" args="" ;;
        go) subs="" flags="--port --key --domain --dns --yes --forget" args="" ;;
        link) subs="" flags="" args="apps" ;;
        next) subs="" flags="-H" args="apps" ;;
        open) subs="" flags="" args="apps" ;;
        ssh) subs="" flags="" args="apps" ;;
      esac
      if [[ $PREFIX == -* ]]; then compadd -- ${=flags}
      elif [[ -n $subs && $CURRENT -eq 2 ]]; then compadd -- ${=subs}
      elif [[ $args == hosts ]]; then _tando_hosts
      elif [[ $args == apps ]]; then _tando_apps
      fi ;;
  esac
}

_tando "$@"
