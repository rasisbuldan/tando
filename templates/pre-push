#!/bin/bash
# tando pre-push hook: installed by `tando ci hook`; remove with `tando ci hook --remove`.
#
# When this push updates @BRANCH@, deploy the commit being pushed, built from a temporary
# checkout of exactly that commit (not the working tree). The deploy runs BEFORE the push
# reaches the remote. A failed deploy does not stop the push unless tando.hookstrict is true.
#   git config tando.deploybranch <branch>   branch that deploys (default @BRANCH@)
#   git config tando.hookstrict true          a failed deploy refuses the push
#   git config tando.hookdirty refuse         refuse (instead of warn) with uncommitted changes
#   TANDO_SKIP_HOOK=1 git push ...            push without deploying (or git push --no-verify)
set -u
TANDO='@TANDO@'
APPDIR='@APPDIR@'
remote=${1:-remote}
branch=$(git config tando.deploybranch 2> /dev/null) || branch='@BRANCH@'
strict=$(git config --bool tando.hookstrict 2> /dev/null) || strict=false
dirty=$(git config tando.hookdirty 2> /dev/null) || dirty=warn

sha=""
while read -r _ lsha rref _; do
  [ "$rref" = "refs/heads/$branch" ] || continue
  case $lsha in *[!0]*) sha=$lsha;; *) sha="";; esac    # all zeros: the branch is being deleted
done
[ -n "$sha" ] || exit 0
say() { printf 'tando hook: %s\n' "$*" >&2; }
if [ "${TANDO_SKIP_HOOK:-}" = 1 ]; then say "TANDO_SKIP_HOOK=1: pushing $branch without deploying"; exit 0; fi
[ -x "$TANDO" ] || TANDO=$(command -v tando) || { say "tando not found; pushing without deploying"; exit 0; }

say "pushing $branch to $remote: deploying commit ${sha:0:12} FIRST; the deploy happens before the push reaches $remote"
if [ -n "$(git status --porcelain --untracked-files=no 2> /dev/null)" ]; then
  if [ "$dirty" = refuse ]; then
    say "you have uncommitted changes and tando.hookdirty is refuse: push refused (commit or stash them)"
    exit 1
  fi
  say "warning: you have uncommitted changes; they are NOT deployed (deploying ${sha:0:12} as pushed)"
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/tando-push.XXXXXX") || exit 0
orig=$PWD
# shellcheck disable=SC2329  # called by the EXIT trap
cleanup() {
  cd "$orig" || return
  git worktree remove --force "$tmp/w" > /dev/null 2>&1
  rm -rf "${tmp:?}"; git worktree prune > /dev/null 2>&1
}
trap cleanup EXIT
trap 'exit 130' INT TERM
rc=0
if ! git worktree add -q --detach "$tmp/w" "$sha" > "$tmp/log" 2>&1; then
  say "could not check out ${sha:0:12}: $(tail -1 "$tmp/log")"; rc=1
elif ! cd "$tmp/w/$APPDIR" 2> /dev/null || [ ! -f tando.conf ]; then
  say "commit ${sha:0:12} has no $APPDIR/tando.conf"; rc=1
else
  if [ -f package-lock.json ] && grep -q '^[[:space:]]*build[[:space:]]*=' tando.conf; then
    say "npm ci (clean dependencies for the build)"
    npm ci --no-audit --no-fund > "$tmp/npm.log" 2>&1 || { say "npm ci failed: $(tail -3 "$tmp/npm.log")"; rc=1; }
  fi
  # the deploy comes from this repository's directory, built in a temporary checkout of it
  # (--yes: nobody can answer a prompt in a hook)
  [ $rc = 0 ] && { TANDO_ORIGIN="$orig/$APPDIR" "$TANDO" deploy --yes < /dev/null >&2 || rc=$?; }
fi
if [ $rc = 0 ]; then say "deployed ${sha:0:12}; now pushing to $remote"; exit 0; fi
if [ "$strict" = true ]; then say "deploy failed: push refused (tando.hookstrict is true)"; exit 1; fi
say "deploy failed; the push continues anyway (git config tando.hookstrict true to block it)"
exit 0
