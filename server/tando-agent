}

# doctor <client agent checksum>: rows "check <state> <name> <detail>", state ok|warn|fail
cmd_doctor() {
  load "$R/host.conf" H
  local mine a n=0 bad=() caps=0 mt=0 k v used avail pct wv
  # each installed piece against the client's copy (checksums: agent, gate, logs, metrics, watch, status, tandod)
  local name file want version cver=${6:-}
  version=$(cat "$R/VERSION" 2> /dev/null || echo unknown)
  [[ $cver =~ ^[0-9A-Za-z.+_-]{1,40}$ ]] || cver=""   # the client's version (6th argument, optional)
  # after the client's version: named sums (status=..., tandod=...), which an older agent ignores
  local -A NS=(); for a in "${@:7}"; do [[ $a =~ ^(status|tandod|offsite|host|studio)=([0-9,]*|none)$ ]] && NS[${a%%=*}]=${a#*=}; done
  # an install that was cut off between renames leaves its journal (see install_helpers_script in
  # the client): some programs are old and some new until the next host setup finishes or undoes it
  if [[ -e $R/bin/.install.pending ]]; then
    row check fail "install" "an install was cut off between files, so some programs on <host> may be old and some new: tando host setup <host> finishes or undoes it"
  fi
  for name in agent gate logs metrics watch status daemon offsite host studio; do
    case $name in
      agent) file=$AGENT want=${1:-};;
      gate) file=$R/bin/tando-gate want=${2:-};;
      logs) file=$R/bin/tando-logs want=${3:-};;
      metrics) file=$R/bin/tando-metrics want=${4:-};;
      watch) file=$R/bin/tando-watch want=${5:-};;
      status) file=$R/bin/tando-status want=${NS[status]:-};;
      daemon) file=$R/bin/tandod want=${NS[tandod]:-};;   # (the row "tandod" is its liveness, from tando-watch)
      offsite) file=$R/bin/tando-offsite want=${NS[offsite]:-}
               [[ -n $want || -x $file ]] || continue;;   # (an older client does not install it)
      host) file=$R/bin/tando-host want=${NS[host]:-}   # host care (srv/hostcare)
            [[ -n $want || -x $file ]] || continue;;
      studio) file=$STUDIO want=${NS[studio]:-}; [[ -n $want || -x $file ]] || continue;;   # tando db studio (srv/studio)
    esac
    if [[ ! -x $file ]]; then row check fail "$name" "not installed: run tando host setup"; continue; fi
    mine=$(cksum < "$file" | cut -d' ' -f1)
    # want: the client's checksum, or a list "a,b" (a Go program: one binary per CPU)
    if [[ -z $want || ,$want, == *,"$mine",* ]]; then row check ok "$name" "$version, same as the client"
    elif [[ -n $cver && $cver == "$version" ]]; then
      row check warn "$name" "the $name on <host> differs from this tando (same version $version): tando host setup <host>"
    elif [[ -n $cver ]]; then
      row check warn "$name" "$version here, $cver on the laptop: tando host setup <host>"
    else row check warn "$name" "$version, differs from the client: run tando host setup"; fi
  done
  if [[ -x $R/bin/tando-metrics ]]; then   # sampled by tando-watch.timer, before the checks
    local last
    last=$(stat -c %Y /var/lib/tando/metrics/host.tsv 2> /dev/null || echo 0)
    if (( $(now) - last < 180 )); then row check ok "metrics sample" "sampled $(( $(now) - last ))s ago"
    else row check warn "metrics sample" "no sample in the last 3 minutes (tando-watch.timer)"; fi
  fi
  if [[ -n ${H[port_min]:-} && -n ${H[port_max]:-} && -n ${H[apps_domain]:-} ]]; then
    row check ok "host.conf" "*.${H[apps_domain]} tls=${H[tls]:-off} ports ${H[port_min]}-${H[port_max]}, ${H[preflight_min]:-$PREFLIGHT_MIN}-${H[preflight_max]:-$PREFLIGHT_MAX}"
  elif [[ -f $R/host.conf ]]; then row check fail "host.conf" "empty or incomplete: tando host setup <host> rewrites it"
  else row check fail "host.conf" "missing: tando host setup <host>"; fi
  local PR_LO PR_HI PF_LO PF_HI; port_ranges
  local cv; cv=$(caddy version 2> /dev/null | cut -d' ' -f1); cv=${cv#v}
  if [[ -n ${H[public_port]:-} && $cv =~ ^2\.[0-6]\. ]]; then
    row check warn "caddy log" "Caddy $cv does not log requests whose Host has a port, and public_port=${H[public_port]} gives every one a port: their requests are not in tando requests"
  fi
  if systemctl -q is-active caddy; then row check ok caddy "$cv running"
  elif command -v caddy > /dev/null; then row check fail caddy "not running: sudo systemctl start caddy (sudo journalctl -u caddy -n 20 says why)"
  else row check fail caddy "not installed: tando host setup installs it"; fi
  # DNS: apps are <app>.<apps_domain>, so a name under it must point at this server
  local dom=${H[apps_domain]:-localhost} ip
  if [[ $dom != localhost && $dom != *.localhost ]]; then
    ip=$(getent ahostsv4 "tando-dns-check.$dom" 2> /dev/null | awk '{ print $1; exit }')
    if [[ -z $ip ]]; then
      row check warn dns "*.$dom does not resolve: add a DNS record  *.$dom A <this server's address>"
    elif ip -o addr show 2> /dev/null | grepq "inet $ip/"; then row check ok dns "*.$dom -> $ip (this server)"
    else row check ok dns "*.$dom -> $ip (not this server: fine behind NAT)"; fi
  fi
  if ss -Hltn 'sport = :2019' | grepq .; then
    row check fail "caddy admin" "Caddy's admin API listens on TCP 2019, open to every app: run tando host setup"
  elif grep -q "^[[:space:]]*admin unix/$CADDY_SOCK\$" /etc/caddy/Caddyfile 2> /dev/null &&
       curl -s -m 3 -o /dev/null --unix-socket "$CADDY_SOCK" -H "Host: " http://localhost/config/; then
    row check ok "caddy admin" "$CADDY_SOCK, caddy and root only"
  elif grep -q "^[[:space:]]*admin unix/$CADDY_SOCK\$" /etc/caddy/Caddyfile 2> /dev/null; then
    row check fail "caddy admin" "$CADDY_SOCK does not answer: sudo systemctl restart caddy (reloads fail until then)"
  else row check warn "caddy admin" "not on tando's unix socket: run tando host setup"; fi
  # slow clients: tando sets these only on a Caddy of its own (caddy_timeouts); here, say what to add
  if grep -qs '^[[:space:]]*read_header[[:space:]]' /etc/caddy/Caddyfile; then
    row check ok "caddy timeouts" "read_header and idle set"
  else
    row check warn "caddy timeouts" "none: slow clients can hold thousands of connections. Add to the global block ({ ... }) of /etc/caddy/Caddyfile: servers { timeouts { read_header 10s idle 2m } } then sudo systemctl reload caddy"
  fi
  local cst cstart=0   # when the running Caddy started (epoch), from its monotonic start time
  cst=$(systemctl show -P ExecMainStartTimestampMonotonic caddy 2> /dev/null)
  [[ $cst =~ ^[0-9]+$ ]] && cstart=$(( $(now) - $(awk '{ print int($1) }' /proc/uptime) + cst / 1000000 ))
  if [[ -f $CADDY_MEM ]] && systemctl -q is-active caddy && (( $(stat -c %Y "$CADDY_MEM") > cstart + 1 )); then
    row check ok "caddy memory" "GOMEMLIMIT from Caddy's next restart"
  elif systemctl show -P Environment caddy 2> /dev/null | grepq GOMEMLIMIT=; then
    row check ok "caddy memory" "GOMEMLIMIT set"
  else
    row check warn "caddy memory" "no GOMEMLIMIT: 20,000 keep-alive connections took 1.8 GB and got Caddy OOM-killed on a 2 GB server. Add /etc/systemd/system/caddy.service.d/memory.conf with [Service] Environment=GOMEMLIMIT=$(caddy_mem_mb)MiB, then sudo systemctl daemon-reload && sudo systemctl restart caddy"
  fi
  # a reload that failed while starting its servers left the ones it had started serving
  # (caddy_binds says how), whoever reloaded: tando, or the owner for a site tando does not own
  local cfail=""
  if ((cstart)) && systemctl -q is-active caddy; then
    cfail=$(journalctl -u caddy --since "@$cstart" --no-pager -o cat 2> /dev/null |
      grep -o '"ts":[0-9.]*,[^{]*"error":"loading config: loading new config: [a-z]* app module: start: [^"]*"' | tail -1)
  fi
  if [[ -n $cfail ]]; then
    local cts=${cfail#\"ts\":}; cts=${cts%%[.,]*}
    cfail=${cfail##*app module: start: }; cfail=${cfail%\"}
    row check fail "caddy reload" "a reload failed at $(date -d "@$cts" '+%F %T' 2> /dev/null) while starting ($(cut -c1-160 <<< "$cfail")): part of that configuration may still serve beside the running one, and there an app's restart gives 502 instead of holding requests. Fix the Caddyfile (sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile), then sudo systemctl restart caddy. After editing a site by hand: reload, and restart Caddy when the reload fails"
  elif ((cstart)); then
    row check ok "caddy reload" "every reload since Caddy started loaded completely"
  fi
  if command -v nft > /dev/null && nft list table inet tando &> /dev/null; then
    row check ok "loopback rules" "apps reach only their own ports (nftables)"
  else row check warn "loopback rules" "not loaded: apps can reach each other's ports on 127.0.0.1"; fi
  # per-app limits (fw_sync): how often they refused since the rules loaded
  if nft list counter inet tando app_conn &> /dev/null; then
    local ac ad an
    ac=$(nft list counter inet tando app_conn 2> /dev/null | sed -n 's/.*packets \([0-9]*\).*/\1/p')
    ad=$(nft list counter inet tando app_db 2> /dev/null | sed -n 's/.*packets \([0-9]*\).*/\1/p')
    an=$(nft list counter inet tando app_dns 2> /dev/null | sed -n 's/.*packets \([0-9]*\).*/\1/p')
    row check ok "app limits" "per app: ${H[conn_out]:-$CONN_OUT} conns, ${H[dns_rate]:-$DNS_RATE} DNS/s, db_pool x $DB_CONNS to the database; refused ${ac:-0}, ${an:-0}, ${ad:-0}"
  fi
  # per-client limits on the web ports (rate_limit_rules): how often they tripped since the rules loaded
  local rlc rlr
  if nft list counter inet tando rl_conn &> /dev/null; then
    rlc=$(nft list counter inet tando rl_conn 2> /dev/null | sed -n 's/.*packets \([0-9]*\).*/\1/p')
    rlr=$(nft list counter inet tando rl_rate 2> /dev/null | sed -n 's/.*packets \([0-9]*\).*/\1/p')
    row check ok "client limits" "${H[conn_limit]:-200} conns, ${H[conn_rate]:-100}/s per address; refused ${rlc:-0}, slowed ${rlr:-0}"
  elif [[ ${H[rate_limit]:-auto} != off ]]; then
    row check warn "client limits" "no per-client connection limits (other sites on this Caddy): tando host setup <host> rate_limit=on"
  fi
  origin_doctor
  if grep -q '^import /etc/caddy/tando/\*\.caddy' /etc/caddy/Caddyfile 2>/dev/null; then
    row check ok "caddy import" "/etc/caddy/tando/*.caddy"
  else row check fail "caddy import" "missing from /etc/caddy/Caddyfile"; fi
  [[ ${H[postgres]:-} == yes ]] && pg_doctor
  dn_is && dn_doctor
  if [[ -x $STUDIO ]]; then
    if systemctl is-active -q tando-studio.service; then
      row check ok "studio" "$(studio_rows | awk -F'\t' 'BEGIN { s = "running, no session" } { s = "running, " $2 " session(s), open: " ($3 == "-" ? "none" : $3) } END { print s }')"
    else row check warn "studio" "not running: tando host setup <host>"; fi
  fi
  if [[ -x $R/bin/tando-gate ]]; then   # CI: sshd reads deploy keys as tando-keys (docs/CI.md)
    if getent passwd tando-keys > /dev/null && [[ -f /etc/ssh/sshd_config.d/50-tando-ci.conf ]]; then
      row check ok "ci keys" "sshd reads them as tando-keys; $(ls -d "$R"/ci/*/ 2> /dev/null | wc -l) apps with keys"
    else row check fail "ci keys" "tando-keys or the sshd drop-in is missing: run tando host setup"; fi
  fi
  if [[ $EUID == 0 && -f $R/ctl/ca.pub && -x $R/bin/tando-gate ]]; then   # control plane mode (docs/CONTROL-PLANE.md)
    local ce
    if ce=$("$R/bin/tando-gate" admin ctl-check 2>&1 > /dev/null); then row check ok "control plane" "sshd admits tando-ctl by certificate only"
    else row check fail "control plane" "${ce#tando-gate: }"; fi
  fi
  if systemctl -q is-enabled tando-recover.service 2>/dev/null; then row check ok "recover unit" enabled
  else row check fail "recover unit" "not enabled"; fi
  for k in curl rsync systemd-run flock nft openssl; do
    command -v "$k" > /dev/null || bad+=("$k")
  done
  if ((${#bad[@]})); then row check fail tools "missing: ${bad[*]}: tando host setup <host> installs them"
  else row check ok tools "curl rsync nft openssl"; fi
  # runtimes: only what the apps here use (tando up installs them)
  local need_node=0 have
  grep -qs '^recipe=\(node\|next\)$' "$R"/apps/*/app.conf && need_node=1
  if have=$(node --version 2> /dev/null); then row check ok node "${have#v}"
  elif ((need_node)); then row check fail node "missing, and node/next apps are here: tando host setup <host> node=yes"; fi
  if swapon --show=NAME --noheadings 2> /dev/null | grepq .; then row check ok swap "$(swapon --show=SIZE --noheadings | head -1 | tr -d ' ')"
  elif (( $(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo) < 2000 )) && ! systemd-detect-virt -cq; then
    row check warn swap "none, with under 2 GB of RAM: tando host setup <host> swap=yes"; fi
  if command -v ufw > /dev/null && ufw status 2> /dev/null | grepq '^Status: active' &&
     ! ufw status | grepq '^443/tcp.*ALLOW'; then
    row check fail ufw "active, and ports 80/443 are closed: tando host setup <host> opens them"
  fi
  read -r _ _ used avail pct _ < <(df -Pk / | tail -1)
  pct=${pct%\%}
  if ((pct >= 97)); then row check fail disk "$pct% used"
  elif ((pct >= 90)); then row check warn disk "$pct% used"
  else row check ok disk "$pct% used, $((avail / 1048576)) GB free"; fi
  # inodes: many small files (node_modules in every kept release) run out before the bytes do
  local ipct; ipct=$(df -Pi "$R" 2> /dev/null | awk 'NR == 2 && $2 > 0 { sub(/%/, "", $5); print $5 }')
  if [[ $ipct =~ ^[0-9]+$ ]] && ((ipct >= 90)); then
    row check warn inodes "$ipct% of the inodes of $R used: fewer releases kept, or a bigger file system"
  fi
  # apps share the file system of /opt/tando (no quotas): name it, its root reserve (what root's
  # deploys and backups still get when an app has filled it) and the largest app (tando-watch)
  local fsrc fst lapp="" lmb=0 rb="" dv
  read -r fsrc fst < <(df --output=source,fstype "$R" 2> /dev/null | tail -1)
  while IFS='=' read -r k dv; do
    [[ $k == dumb.* && $dv =~ ^[0-9]+$ ]] && ((dv > lmb)) && { lmb=$dv lapp=${k#dumb.}; }
  done 2> /dev/null < /run/tando-watch/vstate   # (2> first: a missing file says nothing)
  [[ $fst == ext[234] ]] && rb=$(tune2fs -l "$fsrc" 2> /dev/null | sed -n 's/^Reserved block count: *//p')
  v="${lapp:+largest $lapp $lmb MB of }${H[app_max_mb]:-8192} MB per app; $fst"
  if [[ $rb == 0 ]]; then row check warn "app disk" "$v $fsrc for $R; no blocks reserved for root: an app filling it stops every deploy (sudo tune2fs -m 2 $fsrc)"
  else row check ok "app disk" "$v"; fi
  # backups and restores run pg_dump/tar as the app's user outside its sandbox: with
  # kernel.yama.ptrace_scope=0 the app could attach to them
  if [[ $(cat /proc/sys/kernel/yama/ptrace_scope 2> /dev/null) == 0 ]]; then
    row check warn ptrace "kernel.yama.ptrace_scope=0: an app can attach to its own backup and restore processes; set it to 1 (sysctl)"
  fi
  while read -r k v _; do [[ $k == MemTotal: ]] && mt=$((v * 1024)); done < /proc/meminfo
  bad=()
  for a in "$R"/apps/*/app.conf; do
    [[ -f $a ]] || continue
    a=${a%/app.conf}; a=${a##*/}; n=$((n + 1))
    if ! ( app "$a" ) > /dev/null 2>&1; then
      row check fail "app $a" "incomplete app directory: tando destroy -a $a removes it"; continue
    fi
    (
      app "$a"
      local cur=${S[current]:-} msg="" l
      l=$(cur_link)
      [[ -s $D/state ]] || msg="state file missing or empty"
      [[ -z $cur && -z $l ]] && msg="${msg:+$msg, }nothing deployed"
      [[ -n $cur && $l != "$cur" ]] && msg="${msg:+$msg, }current link points at ${l:-nothing}, the state says $cur (tando restart repairs it)"
      [[ -n $cur && ! -d $D/releases/$cur ]] && msg="${msg:+$msg, }the current release $cur is missing on disk: deploy again"
      [[ -d $D/releases ]] && [[ -z $(ls -A "$D/releases") && -n $cur ]] && msg="${msg:+$msg, }no releases on disk"
      [[ -n $cur && ${S[status_$cur]:-} != verified ]] && msg="current release $cur is ${S[status_$cur]:-unverified}"
      [[ ${S[phase]:-idle} != idle ]] && msg="activation in phase ${S[phase]}"
      [[ -n ${S[restore_cut]:-} ]] && row check fail "app $a" "${S[restore_cut]}"
      # a backup cut off left its temp directory (stale only while nothing holds the app's lock:
      # every backup is taken under it)
      local t nt=0
      for t in "$BK/$a"/.*.tmp; do [[ -d $t && ! -L $t && ${t##*/} =~ ^\.[0-9]{8}-[0-9]{6}-[a-z]+\.tmp$ ]] && nt=$((nt + 1)); done
      if ((nt)) && flock -n "$D/lock" true 2> /dev/null; then
        row check warn "app $a" "$nt unfinished backup temp director$( ((nt == 1)) && echo y || echo ies) in $BK/$a, left by a backup that was cut off: the next backup of $a removes it (tando backup now -a $a)"
      fi
      # (an app stopped with tando stop is meant not to run: ls and status say stopped)
      [[ -n $cur && -z ${S[stopped]:-} ]] && has_unit && ! systemctl -q is-active "tando-$a" && msg="${msg:+$msg, }unit not running"
      if [[ ${C[backup]:-off} == daily ]] && [[ ${S[last_backup]:-0} =~ ^[0-9]{1,12}$ ]] && (( $(now) - 10#${S[last_backup]:-0} > 2 * 86400 )); then
        msg="${msg:+$msg, }last backup older than 2 days"
      fi
      if [[ ${C[backup]:-off} == daily && ${S[drill_result]:-} == fail ]]; then
        msg="${msg:+$msg, }the last restore drill failed (${S[drill_why]:-no reason recorded}): tando backup drill -a $a"
      elif [[ ${C[backup]:-off} == daily && ${H[backup_drill]:-monthly} != off && ${C[created]:-0} =~ ^[0-9]+$ ]] &&
           (( $(now) - 10#${C[created]:-0} > 40 * 86400 )) &&
           (( $(now) - 10#${S[drill_at]:-0} > 40 * 86400 )); then
        msg="${msg:+$msg, }no restore drill in 40 days (tando backup drill -a $a)"
      fi
      [[ -n $msg ]] && row check warn "app $a" "$msg"
      exit 0
    )
    v=$(sed -n 's/^memory=//p' "$R/apps/$a/app.conf")
    case $v in *G) caps=$((caps + ${v%G} * 1073741824));; *M) caps=$((caps + ${v%M} * 1048576));;
      *K) caps=$((caps + ${v%K} * 1024));; esac
    # and its workers' (worker.<name>.memory, else the app's memory)
    for wv in $(awk -F= -v m="${v:-256M}" '$1 ~ /^worker\.[^.]+$/ { w[$1] = m } $1 ~ /^worker\..*\.memory$/ { sub(/\.memory$/, "", $1); x[$1] = $2 }
        END { for (k in w) print (k in x ? x[k] : w[k]) }' "$R/apps/$a/app.conf"); do
      caps=$((caps + $(size_mb "$wv") * 1048576))
    done
  done
  [[ -x $R/bin/tando-offsite ]] && "$R/bin/tando-offsite" doctor   # offsite backups (docs/BACKUP.md)
  if [[ -x $R/bin/tando-watch ]]; then "$R/bin/tando-watch" doctor
  else row check warn alerts "not set up: tando host setup"; fi
  # host care: one row from its last summary (tando host status is the machine's own view)
  [[ -x $R/bin/tando-host ]] && "$R/bin/tando-host" doctor 2> /dev/null
  local pn=$((PR_HI - PR_LO + 1))
  if ((n * 10 >= pn * 9)); then row check warn apps "$n apps, ports used $n of $pn ($PR_LO-$PR_HI): widen the range before it is full (tando host setup <host> port_max=<port>)"
  else row check ok apps "$n apps, ports used $n of $pn ($PR_LO-$PR_HI)"; fi
  local oc=${H[mem_overcommit]:-$MEM_OVERCOMMIT} lim
  lim=$(awk -v r="$((mt / 1048576))" -v o="$oc" 'BEGIN { print int(r * o) }')
  # (admission's count: an app with idle_stop at its idle cost plus a share of its cap)
  local adm; adm=$(mem_caps_mb -a "$R"/apps/*/app.conf | awk '{ s += $2 } END { print s + 0 }')
  if ((mt > 0 && lim > 0 && adm > lim)); then
    row check warn "memory caps" "$adm MB of caps counted over $lim MB ($((mt / 1048576)) MB RAM x $oc, mem_overcommit): a deploy that raises a cap is refused without --force; lower memory = of some apps"
  elif ((mt > 0 && caps > mt)); then
    row check ok "memory caps" "$((caps / 1048576)) MB of caps, $((mt / 1048576)) MB RAM (overcommitted, within x $oc)"
  else row check ok "memory caps" "$((caps / 1048576)) MB of caps, $((mt / 1048576)) MB RAM"; fi
  [[ -x $LOGS ]] && "$LOGS" log-doctor
  return 0
}

# ---- verbs: app lifecycle --------------------------------------------------------------

# configure <app>: create the app if missing, apply settings read from stdin as key=value
# name_free app: a new app's name must not make one of its names another's. App names may contain
# "-", and tando names things tando-<app>, tando-<app>-<kind>, tando-d-<app>, tando-m-<app>:
#   d-<x>, m-<x>      the user tando-d-x / group tando-m-x of app x (its deploy user, the group
#                     that reads its settings and state)
#   <x>-backup        app x's backup unit tando-x-backup.service and its timer
#   rx-<x>, adopt-<x>, unadopt-<x>: app x's upload receiver (tando-rx-x.service) and adopt units
#   watch, host, ...  tando's own units (tando-watch.service, tando-host.timer ...)
# Apps that exist keep working (this is checked when an app is created).
name_free() {
  NAME_WHY=""
  case $1 in
    d-*|m-*) NAME_WHY="$1 is reserved (tando-$1 is the deploy user or settings group of an app ${1#?-})";;
    rx-*|adopt-*|unadopt-*) NAME_WHY="$1 is reserved (tando-$1 is a unit tando uses for the app ${1#*-})";;
    *-backup) NAME_WHY="$1 is reserved (tando-$1 is the backup unit of an app ${1%-backup})";;
    watch|watch-fallback|host|host-boot|host-window|metrics|offsite|recover|firewall|down|backups|previews|drill)
      NAME_WHY="$1 is reserved (tando-$1 is one of tando's own units)";;
  esac
  [[ -z $NAME_WHY ]]
}

# ports_used: " <port> <pre-flight port> ... " of every app (its preflight_port, else port + 100)
ports_used() {
  local f p sp used=" "
  for f in "$R"/apps/*/app.conf; do
    [[ -f $f ]] || continue
    p=$(sed -n 's/^port=//p' "$f"); sp=$(sed -n 's/^preflight_port=//p' "$f")
    [[ $p =~ ^[0-9]+$ ]] && used+="$p ${sp:-$((p + 100))} "
    [[ $sp =~ ^[0-9]+$ ]] && used+="$sp "
  done
  echo "$used"
}
# app_port: C[port] and C[preflight_port] of an app that has none, from the host's ranges (under
# the ports lock, fd 8)
app_port() {
  local p PR_LO PR_HI PF_LO PF_HI
  port_ranges
  p=$(port_pick "$PR_LO" "$PR_HI" "$PF_LO" "$PF_HI") ||
    die "no free port in $PR_LO-$PR_HI (or pre-flight port in $PF_LO-$PF_HI): widen them with tando host setup <host> port_max=<port>, or remove an app"
  C[port]=${p% *} C[preflight_port]=${p#* }
}
# port_pick lo hi plo phi: the port of a new app from lo-hi and its pre-flight port from plo-phi
# (prints "port preflight"; fails when either range has none free). Neither is any app's port or
# pre-flight port (its preflight_port, else port + 100 for apps made before preflight_port: a
# stopped app listens on neither, so ss alone misses them), Caddy's admin port or PostgreSQL's,
# nor a port something listens on (one ss for the whole scan, not one per port)
port_pick() {
  local p q used
  used="$(ports_used) 2019 5432 $(ss -Hltn 2> /dev/null | awk '{ p = $4; sub(/.*:/, "", p); printf "%s ", p }') "
  for ((p = $1; p <= $2; p++)); do [[ $used == *" $p "* ]] || break; done
  ((p <= $2)) || return 1
  for ((q = $3; q <= $4; q++)); do [[ $used == *" $q "* || $q == "$p" ]] || { echo "$p $q"; return 0; }; done
  return 1
}
# port_ranges: PR_LO PR_HI (app ports) and PF_LO PF_HI (pre-flight ports) from host.conf, with the
# defaults: 4100-4999 and 14100-14999 (900 apps; a host set up before these keys keeps its own)
PORT_MIN=4100 PORT_MAX=4999 PREFLIGHT_MIN=14100 PREFLIGHT_MAX=14999
port_ranges() {
  PR_LO=${H[port_min]:-$PORT_MIN} PR_HI=${H[port_max]:-$PORT_MAX}
  PF_LO=${H[preflight_min]:-$PREFLIGHT_MIN} PF_HI=${H[preflight_max]:-$PREFLIGHT_MAX}
}
# port_ranges_ok: the ranges as host setup takes them, or PR_WHY says what is wrong
port_ranges_ok() {
  local x; PR_WHY=""
  for x in "$PR_LO" "$PR_HI" "$PF_LO" "$PF_HI"; do
    [[ $x =~ ^[1-9][0-9]{3,4}$ ]] && ((x >= 1024 && x <= 65535)) || { PR_WHY="ports are 1024 to 65535 (got $x)"; return 1; }
  done
  ((PR_LO <= PR_HI && PF_LO <= PF_HI)) || { PR_WHY="a range goes from its lower port to its higher one"; return 1; }
  ((PR_HI < PF_LO || PF_HI < PR_LO)) || { PR_WHY="the app ports ($PR_LO-$PR_HI) and the pre-flight ports ($PF_LO-$PF_HI) must not overlap"; return 1; }
  for x in 2019 5432; do
    ((x >= PR_LO && x <= PR_HI || x >= PF_LO && x <= PF_HI)) && { PR_WHY="the port ranges must not contain $x (Caddy's admin port, PostgreSQL)"; return 1; }
  done
  ((PF_HI - PF_LO >= PR_HI - PR_LO)) || { PR_WHY="the pre-flight range needs at least as many ports as the app range"; return 1; }
  return 0
}
cmd_configure() {
  need_root
  valid_app "${1:-}" || die "invalid app name"
  A=$1 D=$R/apps/$1
  load "$R/host.conf" H
  [[ -n ${H[port_min]:-} ]] || die "host not set up (tando host setup)"
  local k v new=0 jobs=() workers=() owner="${SUDO_USER:-root}" f p parts check=0 origin="" force=0 confdom="" confwww="" x
  # the settings first; then, for an existing app, its lock before app.conf is read: a domain add
  # or another configure in between would otherwise be overwritten by this one's stale copy
  local input; input=$(cat)
  # (a preview being made: an app of that name made in the meantime is not taken over)
  [[ -n ${CONF_CREATE_ONLY:-} && -f $D/app.conf ]] && die "$A was created by another command a moment ago; it is not taken over"
  if [[ -f $D/app.conf ]]; then
    [[ $'\n'$input$'\n' == *$'\n'check=1$'\n'* ]] || lock
    load "$D/app.conf" C
    load "$D/state" S
    held_refuse
    # the live release's jobs are those it was deployed with: keep them before app.conf changes
    [[ -n ${S[current]:-} && ! -f $D/jobs/${S[current]} ]] && valid_id "${S[current]}" && jobs_snap "${S[current]}"
    # and so are its settings (start, health, memory, path...): a deploy that does not go live must
    # not change how the live one starts, is checked or runs (a file from before has only four)
    if valid_id "${S[current]:-}" && ! grepq -x conf=1 "$D/start/${S[current]}" 2> /dev/null; then
      start_snap "${S[current]}" || die "could not record the live release's settings - disk full?"
    fi
  else
    # a user of that name is only taken over when an earlier configure of this app made it and was
    # interrupted before app.conf existed (its marker .creating is in the app's directory)
    id "tando-$A" &> /dev/null && [[ ! -f $D/.creating ]] && die "user tando-$A exists but was not created by tando"
    name_free "$A" || die "$NAME_WHY: choose another app name (app = in tando.conf)"
    new=1
  fi
  app_vars
  # optional settings are cleared unless given again
  unset "C[path]" "C[data]" "C[start_shell]" "C[writable]" "C[backup]" "C[database]" "C[image]" "C[soak]" \
    "C[container_port]" "C[build_memory]" "C[log_max]" "C[log_keep]" "C[log_rate]" "C[access_log]" \
    "C[request_log_max]" "C[health_expect]" "C[health_fails]" "C[health_recover]" \
    "C[cpu]" "C[tasks]" "C[max_conns]" "C[max_requests]" "C[stop_timeout]" "C[hold]" "C[priority]" \
    "C[db_statement_timeout]" "C[db_idle_tx_timeout]" "C[db_temp_limit]" "C[db_pool]" "C[db_direct]" \
    "C[release]" "C[release_shell]" "C[release_timeout]" "C[job_timeout]" "C[assets]" "C[job_spread]" "C[job_missed]" "C[spa]" "C[compress]" "C[idle_stop]" \
    "C[tmp_size]" "C[io]" "C[disk]" "C[response_timeout]" "C[body_max]" "C[cold_timeout]" "C[preview_skip]" "C[preview_ttl]" "C[preview_env]" "C[preview_release]" "C[node_lite]"
  local line
  while IFS= read -r line; do
    k=${line%%=*} v=${line#*=}; [[ $line == *=* ]] || { k=$line v=""; }
    no_ctrl "$v" || die "control characters in $k"
    case $k in
      node_lite) [[ $v =~ ^(true|false)$ ]] || die "node_lite must be true or false";;
      recipe) [[ $v =~ ^(node|static|next|python|container|workerd)$ ]] || die "bad recipe: $v";;
      image) [[ $v =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ ]] || die "bad image: $v";;
      container_port) [[ $v =~ ^[0-9]{1,5}$ ]] || die "bad container_port: $v";;
      build_memory) [[ $v =~ ^[0-9]+[KMG]$ ]] || die "bad build_memory: $v";;
      start) [[ -n $v ]] || die "empty start command";;
      start_shell) [[ $v =~ ^(true|false)$ ]] || die "start_shell must be true or false";;
      # the release command (run_release): once per deploy, before the switch
      release) [[ -n $v && ${#v} -le 1000 ]] || die "bad release command (empty, or longer than 1000 characters)";;
      release_shell) [[ $v =~ ^(true|false)$ ]] || die "release_shell must be true or false";;
      release_timeout) [[ $v =~ ^[1-9][0-9]{0,3}$ ]] && ((v <= 3600)) || die "bad release_timeout: $v (seconds, 1 to 3600)";;
      health) [[ $v =~ ^/[A-Za-z0-9._~/?=\&%-]*$ ]] || die "bad health path: $v";;
      path) [[ $v =~ ^(/[A-Za-z0-9._~-]+)+$ ]] || die "bad path: $v (like /shop)";;
      spa) [[ $v =~ ^(true|false)$ ]] || die "spa must be true or false";;
      compress) [[ $v =~ ^(on|off)$ ]] || die "compress must be on or off";;
      # previews (docs/COMMANDS.md "Preview apps"): the parent's rules, and a preview's own marks
      preview_skip) [[ $v =~ ^[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*$ && ${#v} -le 500 ]] || die "bad preview_skip: $v (env names, comma separated)";;
      preview_env) [[ $v =~ ^[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*$ && ${#v} -le 1000 ]] || die "bad preview_env: $v (env names, comma separated)";;
      preview_release) [[ $v == on || $v == off ]] || die "bad preview_release: $v (on or off)";;
      preview_ttl) preview_secs "$v" > /dev/null && (($(preview_secs "$v") <= 7776000)) || die "bad preview_ttl: $v (like 7d or 12h; 90 days at most)";;
      preview_of) valid_app "$v" || die "bad preview_of: $v";;
      preview_expires) [[ $v =~ ^[0-9]{9,11}$ ]] || die "bad preview_expires: $v";;
      idle_stop) [[ $v =~ ^(on|off)$ || $v =~ ^[1-9][0-9]{0,3}[smh]$ ]] || die "bad idle_stop: $v (like 6h, 10m, 30s; on = 6h; off)";;
      # Caddy's limits per request of the app (write_caddy): how long it waits for the answer's
      # headers, the largest request body, and how long a visitor waits for an idle app to start
      response_timeout) [[ $v == off || $v =~ ^[1-9][0-9]{0,4}$ ]] || die "bad response_timeout: $v (seconds, like 60, or off)";;
      body_max) [[ $v == off || $v =~ ^[1-9][0-9]{0,5}[KMG]B?$ ]] || die "bad body_max: $v (a size like 100MB or 2GB, or off)";;
      cold_timeout) [[ $v =~ ^[1-9][0-9]{0,2}$ ]] || die "bad cold_timeout: $v (seconds, 1 to 999)";;
      data) if [[ ${C[recipe]:-} == container ]]; then   # the volume's path inside the container
              [[ $v =~ ^(/[A-Za-z0-9_.-]+)+$ && $v != */../* ]] || die "bad data path: $v (like /data)"
            else
              [[ $v =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$ ]] ||
                die "bad data directory: $v (a relative path inside the release)"
            fi;;
      writable) read -ra parts <<< "${v//,/ }"
                for f in "${parts[@]}"; do
                  [[ $f =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ && /$f/ != */../* && /$f/ != */./* ]] ||
                    die "bad writable directory: $f (a relative path inside the release)"
                done;;
      backup) [[ $v =~ ^(daily|off)$ ]] || die "backup must be daily or off";;
      database) [[ $v =~ ^(postgres|sqlite)$ ]] || die "database must be postgres or sqlite";;
      db_statement_timeout|db_idle_tx_timeout|db_temp_limit) db_guc "$k" "$v" > /dev/null || die "bad $k: $v ($DB_GUC_HINT)";;
      db_pool) [[ $v =~ ^[1-9][0-9]{0,2}$ ]] || die "bad db_pool: $v (connections, 1 to 999)";;
      db_direct) [[ $v =~ ^(true|false)$ ]] || die "db_direct must be true or false";;
      memory) [[ $v =~ ^[0-9]+[KMG]$ ]] || die "bad memory: $v";;
      health_timeout) [[ $v =~ ^[0-9]{1,3}$ ]] || die "bad health_timeout: $v";;
      soak) [[ $v =~ ^[0-9]{1,3}$ ]] || die "bad soak: $v (seconds)";;
      # limits of the app (docs/COMMANDS.md "Limits and load"): its CPU (a % of one core, or
      # cores), its processes and threads, and its connections and requests in flight through Caddy
      cpu) [[ $v =~ ^[1-9][0-9]{0,3}%$ || $v =~ ^[0-9]{1,2}(\.[0-9]{1,2})?$ && $v != 0 && $v != 0.0 ]] || die "bad cpu: $v (like 50% or 1.5 cores)";;
      tasks) [[ $v =~ ^[1-9][0-9]{1,5}$ ]] || die "bad tasks: $v (processes and threads, like 512)";;
      max_conns|max_requests) [[ $v =~ ^[1-9][0-9]{0,4}$ ]] || die "bad $k: $v";;
      stop_timeout) [[ $v =~ ^[1-9][0-9]{0,2}$ ]] || die "bad stop_timeout: $v (seconds)";;
      priority) [[ $v == high || $v == low || $v == normal ]] || die "bad priority: $v (high, normal or low)";;
      # the app's /tmp (tmpfs, in its memory), its disk bandwidth (MB/s) and its disk share (alerts)
      tmp_size) [[ $v =~ ^[1-9][0-9]{0,5}[KMG]$ ]] || die "bad tmp_size: $v (like 64M)";;
      io) [[ $v =~ ^[1-9][0-9]{0,4}$ ]] || die "bad io: $v (MB/s, like 50)";;
      disk) [[ $v =~ ^[1-9][0-9]{0,5}[MG]$ ]] || die "bad disk: $v (like 2G)";;
      # the fingerprinted files of the release (assets_spec): off, a directory in the release and
      # optionally the URL prefix they are served under
      assets) [[ $v == off || $v =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*(\ *,\ *(/[A-Za-z0-9_.~-]+)+/?)?$ && /$v/ != */../* && /$v/ != */./* ]] ||
                die "bad assets: $v (off, or a directory in the release like assets, and optionally a URL prefix: assets, /static/)";;
      hold) [[ $v =~ ^[1-9][0-9]{0,2}$ ]] || die "bad hold: $v (seconds)";;
      log_max|log_keep|log_rate|access_log|request_log_max) "$LOGS" valid "$k" "$v" 2> /dev/null || die "bad $k: $v";;
      # health check of tando-watch: expected status and/or text, failures to fire, successes to resolve
      health_expect) [[ $v =~ ^([1-5]([0-9]{2}|xx))?( ?[\ -~]{1,100})?$ && -n $v && $v != *[\"\\]* ]] ||
                       die "bad health_expect: $v (like 200, 2xx or 200 ok)";;
      health_fails|health_recover) [[ $v =~ ^[1-9][0-9]?$ ]] || die "bad $k: $v (1 to 99)";;
      # how a job runs (sync_jobs), for all of the app's jobs or for one: its time limit, the spread of
      # its start (RandomizedDelaySec) and whether a run missed while the server was off is made up
      job_timeout) [[ $v =~ ^[1-9][0-9]{0,4}$ ]] && ((v <= 86400)) || die "bad job_timeout: $v (seconds, 1 to 86400)";;
      job_spread) [[ $v =~ ^[0-9]{1,4}$ ]] && ((v <= 3600)) || die "bad job_spread: $v (seconds, 0 to 3600)";;
      job_missed) [[ $v == run || $v == skip ]] || die "bad job_missed: $v (run or skip)";;
      job.*.timeout|job.*.spread|job.*.missed|job.*.cron) x=${k#job.}; x=${x%.*}
             [[ $x =~ ^[a-z][a-z0-9-]{0,20}$ ]] || die "bad job name in $k: $x (lower case letters, digits and dashes, starting with a letter, at most 21 characters)"
             case ${k##*.} in
               timeout) [[ $v =~ ^[1-9][0-9]{0,4}$ ]] && ((v <= 86400)) || die "bad $k: $v (seconds, 1 to 86400)";;
               spread) [[ $v =~ ^[0-9]{1,4}$ ]] && ((v <= 3600)) || die "bad $k: $v (seconds, 0 to 3600)";;
               missed) [[ $v == run || $v == skip ]] || die "bad $k: $v (run or skip)";;
               cron) [[ $v =~ ^[-0-9A-Za-z@*/,\ ]{1,100}$ ]] || die "bad $k";;   # (what was written: the client translated it)
             esac
             jobs+=("$k");;
      job.*) [[ ${k#job.} =~ ^[a-z][a-z0-9-]{0,20}$ ]] || die "bad job name: ${k#job.} (lower case letters, digits and dashes, starting with a letter, at most 21 characters)"
             [[ $v == *'|'* ]] || die "bad job: $k (a schedule, |, then the command)"
             systemd-analyze calendar "$(trim "${v%%|*}")" &> /dev/null || die "bad schedule for job ${k#job.}: $(trim "${v%%|*}") (a cron schedule like */15 * * * * or a systemd one like daily or Mon..Fri 09:00: tando help jobs)"
             jobs+=("$k");;
      # workers (workers_follow): a command each, its memory and the time it gets to stop
      worker.*.memory|worker.*.stop_timeout)
             x=${k#worker.}; x=${x%.*}
             [[ $x =~ ^[a-z][a-z0-9-]{0,20}$ ]] || die "bad worker name: $x (lower case letters, digits and -, at most 21)"
             if [[ $k == *.memory ]]; then [[ $v =~ ^[1-9][0-9]*[KMG]$ ]] || die "bad $k: $v (a size like 256M)"
             else [[ $v =~ ^[1-9][0-9]{0,3}$ ]] && ((v <= 3600)) || die "bad $k: $v (seconds, 1 to 3600)"; fi
             workers+=("$k");;
      worker.*) x=${k#worker.}
             [[ $x == *.* ]] && die "unknown setting: $k (a worker has .memory and .stop_timeout)"
             [[ $x =~ ^[a-z][a-z0-9-]{0,20}$ ]] || die "bad worker name: $x (lower case letters, digits and -, at most 21)"
             [[ -n $v && ${#v} -le 1000 ]] || die "bad $k: a command, at most 1000 characters"
             workers+=("$k");;
      # check=1: only validate and say whether the app exists (before a build); origin: where the
      # client deploys from (user@machine:directory), force=1: deploy although it differs
      check) check=1; continue;;
      domain) for x in $v; do
                valid_domain "$x" || die "not a domain name: $x"
                [[ $x == *.${H[apps_domain]:-localhost} ]] && die "$x is under the server's apps_domain: it is already an app's link"
                confdom+=" $x"
              done; continue;;
      www) [[ $v =~ ^(redirect|serve|off)$ ]] || die "www must be redirect, serve or off"; confwww=$v; continue;;
      origin) [[ ${#v} -le 300 ]] || die "origin too long"; origin=$v; continue;;
      force) [[ $v == 1 ]] && force=1; continue;;
      "") continue;;
      *) die "unknown setting: $k";;
    esac
    v=$(int_norm "$v")
    C[$k]=$v
  done <<< "$input"
  release_ok
  # the apps' database pools must fit in PostgreSQL's connections (before anything is written)
  [[ ${C[database]:-} == postgres && ${H[postgres]:-} == yes ]] &&
    db_pool_check "${C[db_pool]:-$DB_POOL}" "/etc/postgresql/${H[postgres_version]:-}/main/conf.d/tando.conf"
  [[ -n ${C[assets]:-} && ${C[assets]} != off && ${C[recipe]:-} == container ]] &&
    die "assets is not supported for a container app (its files are inside the image)"
  for k in "${jobs[@]}"; do   # a job setting is for a job of this tando.conf
    [[ $k != job.*.* || " ${jobs[*]} " == *" ${k%.*} "* ]] || die "$k is set but there is no ${k%.*}"
  done
  # workers: their settings need the worker; a name is a job's or a worker's; not every recipe
  for k in ${workers[@]+"${workers[@]}"}; do
    x=${k#worker.}; x=${x%%.*}
    [[ $k == worker.*.* && " ${workers[*]} " != *" worker.$x "* ]] && die "$k is set but there is no worker.$x = <command>"
    [[ " ${jobs[*]} " == *" job.$x "* ]] && die "worker $x has the name of a job: give one of them another name"
  done
  if [[ ${C[node_lite]:-} == true && ${C[recipe]:-node} != node && ${C[recipe]:-} != next ]]; then
    die "node_lite is for recipe = node or next (this app is ${C[recipe]:-node})"
  fi
  if [[ ${C[recipe]:-} == workerd ]]; then
    [[ ${C[start]:-} =~ ^[A-Za-z0-9._/@-]+$ && ${C[start]} != *..* && ${C[start]} != /* ]] ||
      die "recipe = workerd: start is the Workers module in the release, like src/index.js (got \"${C[start]:-}\")"
  fi
  if [[ -n ${C[idle_stop]:-} && ${C[idle_stop]} != off ]]; then
    case ${C[recipe]:-node} in
      static) die "idle_stop is not for a static site: it has no process (Caddy serves it)";;
      container) die "idle_stop is not supported for recipe = container yet";;
    esac
  fi
  if ((${#workers[@]})); then
    case ${C[recipe]:-node} in
      static) die "workers are not supported for a static site: it has no process (recipe = static)";;
      container) die "workers are not supported for recipe = container yet: run the process in its own app";;
    esac
    x=0; for k in "${workers[@]}"; do [[ $k == *.* && $k != worker.*.* ]] && x=$((x + 1)); done
    ((x <= 20)) || die "$x workers: at most 20 per app"
  fi
  if [[ -n $origin && -n ${C[origin]:-} && ${C[origin]} != "$origin" ]] && ((!force)); then
    die "$A on <host> was last deployed from ${C[origin]}, not from here ($origin). Deploy from here anyway: tando deploy --force (or tando up --force)"
  fi
  # admission: the memory caps of every app against RAM (--force: deploy anyway)
  if ((!force)) && ! mem_admit "$(mem_caps_mb -a <(for x in "${!C[@]}"; do printf '%s=%s\n' "$x" "${C[$x]}"; done) | awk '{ print $2 }')"; then
    die "$ADMIT_WHY"
  fi
  # runtimes this app needs and the server lacks: the client installs them (tando-agent runtime)
  local needs=""
  case ${C[recipe]:-node} in
    node|next) command -v node > /dev/null || needs+=" node";;
    python) python3 -c 'import venv, ensurepip' 2> /dev/null || needs+=" python";;
    container) [[ ${H[podman]:-} == yes ]] && command -v podman > /dev/null || needs+=" podman";;
    workerd) workerd_ok || needs+=" workerd";;
  esac
  [[ ${C[database]:-} == postgres && ${H[postgres]:-} != yes && -z ${H[db_host]:-} ]] && needs+=" postgres"
  if ((check)); then
    AUDIT_VERB=""   # only a look: nothing to record
    echo "exists=$((1 - new))"; echo "current=${S[current]:-}"; echo "needs=${needs# }"
    echo "node=$(node --version 2> /dev/null | tr -d v)"
    echo "domains=$(app_domains)"
    # another activation (or a rollback, backup, env change) holds the app: the deploy will wait
    # for it in configure; the client says what for and about how long (busy_left: seconds of
    # soak left, "-" when unknown)
    # (supersede=1: a soak ends when this deploy's configure waits for it; finish, deploy_waits)
    ((new)) || { busy_info; echo "supersede=1"; }
    return 0
  fi
  [[ -z $needs ]] || die "$A needs${needs} on <host>, which is not installed: tando up installs it (or tando host setup <host>${needs// / }=yes)"
  [[ -n $origin ]] && C[origin]=$origin
  # domains in tando.conf are added to the app's domains (tando domain rm removes one); who owns
  # a domain is checked under the host-wide domain lock (two apps, one domain). With a live
  # release they wait with this deploy's settings (DOM_STAGE: domain_add= in confs/<id>) and are
  # added at its switch, checked again there (run-activation): a deploy that does not go live
  # adds none and holds none. Without one (a new app) app.conf takes them at once
  [[ -n $confdom ]] && domains_lock
  DOM_STAGE=""
  for x in $confdom; do
    [[ " ${C[domains]:-} " == *" $x|"* ]] && continue
    domain_free "$x" "${confwww:-$(default_www "$x")}"
    if ((!new)) && valid_id "${S[current]:-}"; then DOM_STAGE+="${DOM_STAGE:+ }$x|${confwww:-$(default_www "$x")}"
    else C[domains]="${C[domains]:+${C[domains]} }$x|${confwww:-$(default_www "$x")}"; fi
  done
  if ((new)); then
    lockfile "$R/.ports.lock"; exec 8>"$R/.ports.lock"
    flock -w 120 8 || die "another app is being created on this server and takes too long ($R/.ports.lock); try again"
    # another `tando up` of this same app created it while this one waited
    [[ -f $D/app.conf ]] && die "another tando up created $A a moment ago; run this one again${CONF_CREATE_ONLY:+ with another name}"
    # (a static app gets none: Caddy serves its files, nothing of it listens; app_port gives it
    # one if a later deploy makes it a process)
    [[ ${C[recipe]:-} == static ]] || app_port
    C[created]=$(now)
    # what an earlier app of this name left (an interrupted destroy: no app.conf, no user, not a
    # creation in progress) is removed first, so the new app starts with no old state or history
    if [[ -d $D && ! -f $D/.creating ]] && ! id "tando-$A" &> /dev/null; then rm -rf "${D:?}"; fi
    install -d -m 755 -o root -g root "$D" && : > "$D/.creating" || die "could not create $D (disk full?)"
    if ! id "tando-$A" &> /dev/null; then
      # its group first, with the same id from the band: useradd --user-group gave the group a
      # system gid (under 1000), which destroy did not retire (userdel removes the group first)
      local nu; uid_lock; nu=$(new_uid)
      getent group "tando-$A" > /dev/null || groupadd --system -g "$nu" "tando-$A" || die "groupadd tando-$A failed"
      useradd --system -g "tando-$A" --no-create-home --home-dir /nonexistent -u "$nu" \
        --shell /usr/sbin/nologin "tando-$A" || die "useradd failed"
      exec 14>&-
    fi
    install -d -m 755 -o root -g root "$D" "$D/releases"
    install -d -m 755 -o "$owner" "$D/incoming"
    install -d -m 750 -o "tando-$A" -g "tando-$A" "$D/shared"
    install -m 640 -o root -g "tando-$A" /dev/null "$D/env"
    # values set with tando env set before the app existed (env_staged) become its env
    staged_lock
    if [[ -f $R/staged/$A/env && ! -L $R/staged/$A/env ]]; then
      # (its changelog goes with it: the app's log starts with what was set before it existed)
      [[ -f $R/staged/$A/env.log && ! -L $R/staged/$A/env.log ]] && install -m 600 -o root -g root "$R/staged/$A/env.log" "$D/env.log"
      cat "$R/staged/$A/env" > "$D/env" && rm -rf "${R:?}/staged/$A"
    fi
    : > "$D/history.tsv"
    save "$D/state" S && save "$D/app.conf" C || die "could not write the app's files (disk full?)"
    rm -f "$D/.creating"
    # (both given back now: the rest of a new app's configure, its units, Caddy site and a
    # daemon-reload, took long enough with many apps that parallel new apps waited over 60 s here)
    flock -u 8; exec 3>&-
  elif [[ ${C[recipe]:-} != static && ! ${C[port]:-} =~ ^[0-9]+$ ]]; then
    # a static app (no port) that becomes a process: its port and pre-flight port now, kept in
    # app.conf at once (the pre-flight of this release listens on it, and the next app's pick
    # must see them)
    lockfile "$R/.ports.lock"; exec 8>"$R/.ports.lock"
    flock -w 120 8 || die "another app is being created on this server and takes too long ($R/.ports.lock); try again"
    app_port
    local -A PC=()
    # shellcheck disable=SC2034  # PC is read by load and save through their namerefs
    { load "$D/app.conf" PC; PC[port]=${C[port]} PC[preflight_port]=${C[preflight_port]}; }
    save "$D/app.conf" PC || die "could not write the app's files (disk full?)"
    flock -u 8
  fi
  for k in "${!C[@]}"; do   # drop jobs (and their timeouts) no longer configured
    [[ $k == job.* && " ${jobs[*]} " != *" $k "* ]] && unset "C[$k]"
    [[ $k == worker.* && " ${workers[*]-} " != *" $k "* ]] && unset "C[$k]"   # (workers too)
  done
  [[ ${C[database]:-} == sqlite && -z ${C[data]:-} ]] && C[data]=data   # the file lives in data/
  if [[ -z ${C[backup]:-} && ( -n ${C[data]:-} || -n ${C[database]:-} ) ]]; then C[backup]=daily; fi
  # this deploy's settings wait in confs/<id> (id: their checksum, printed as conf=; the client
  # hands it to activate) until its activation applies them at the switch. Until then app.conf,
  # the unit file and Caddy's site stay the live release's: a deploy that does not go live (refused,
  # cut off, an upload that failed) changes none of them, and a second client's configure in
  # between never hands its settings to this one's activation. (Not for a new app or one with no
  # live release: there is nothing live to keep, app.conf takes them at once.) The server's own
  # key origin is app.conf's at once; new domains of tando.conf wait with them (DOM_STAGE).
  local -A NC=() LC=()
  conf_copy C NC
  local conf; conf=$(conf_stage) || die "could not write the settings of this deploy (disk full?)"
  # a database on the data node: its URLs follow these settings; what the client provisions there
  local dbro=""; db_remote && { dbro=$(db_remote_conf) || exit 1; }
  if ((!new)) && valid_id "${S[current]:-}"; then
    load "$D/app.conf" LC
    for k in "${!C[@]}"; do conf_key "$k" && unset "C[$k]"; done
    for k in "${!LC[@]}"; do conf_key "$k" && C[$k]=${LC[$k]}; done
  fi
  rm -f "$D/pending.conf"      # (an agent before staged settings)
  save "$D/app.conf" C
  [[ ${S[staged]:-} == "$conf" ]] || st staged "$conf"
  # nothing changed since the last configure by this agent (every deploy calls it): done
  # (app.conf's own keys, the staged settings and this agent: the same before and after the
  # switch that applies them, so the next deploy with these settings changes nothing here)
  local applied
  applied=$( { for k in "${!C[@]}"; do conf_key "$k" || printf '%s=%s\n' "$k" "${C[$k]}"; done | sort
               cat "$D/confs/$conf" "$AGENT"; } | cksum | cut -d' ' -f1)
  if ((!new)) && [[ ${S[applied]:-} == "$applied" ]] && [[ -f /etc/caddy/tando/$A.caddy || ${C[caddy]:-} == external ]]; then
    echo "port=${C[port]:-}"; echo "link=$(link)"; echo "created=0"; echo "changed=0"; echo "conf=$conf"
    [[ -z $dbro ]] || echo "$dbro"
    AUDIT_VERB=""   # nothing changed (every deploy asks): nothing to record
    return 0
  fi
  # what the new release needs before its pre-flight (its database, its shared directories) is
  # made from its own settings; the live app's unit, site and jobs from the live ones
  conf_copy C LC; conf_copy NC C; app_vars
  local ndb=${C[database]:-} ndirect=${C[db_direct]:-}
  # the reloads the steps below ask for are only noted (dreload): one at the end, and for a new
  # app none at all where it can be done without (cfg_reload)
  local DR_FLAG=/run/tando-configure-reload.$$
  rm -f "$DR_FLAG"
  # (the namespace's drop-in before app-setup, which asks systemd about its journald: a unit
  # loaded before its drop-in is written needs a reload)
  journal_dir
  [[ -x $LOGS ]] && { "$LOGS" app-setup "$A" > /dev/null || die "log setup failed"; }
  app_perms
  # the shared/ directories the app uses, created once now by its own user (see ensure_shared)
  fail() { die "$1"; }
  [[ -n ${C[data]:-} ]] && ensure_shared data
  [[ ${C[recipe]:-} == next && ${C[next_cache]:-} != release ]] && ensure_shared next-cache
  [[ ${C[recipe]:-} == python ]] && ensure_shared .cache
  conf_copy LC C; app_vars
  # the role and its database now (the pre-flight and the release command use them), with the live
  # release's limits: this release's are set when it goes live (db_follow, from conf_put). Its
  # DATABASE_URL follows this release's db_direct (pgbouncer's or PostgreSQL's port)
  [[ $ndb == postgres && -z ${H[db_host]:-} ]] && DB_DIRECT=$ndirect db_ensure deploy
  write_unit || die "could not write the unit of $A (disk full?)"
  write_caddy || die "$WC_WHY"
  jobs_follow || die "could not write the job units of $A (disk full?)"
  sync_backup_timer
  [[ -f $D/.reserve ]] || { head -c 1048576 /dev/zero > "$D/.reserve" 2> /dev/null && chmod 600 "$D/.reserve"; }
  # (not marked applied on failure: the next deploy tries again)
  fw_sync || die "the per-app loopback rules could not be loaded (above), so $A was not deployed: tando doctor"
  rm -f "$DR_FLAG"
  cfg_reload "$new"
  st applied "$applied"
  echo "port=${C[port]:-}"; echo "link=$(link)"; echo "created=$new"; echo "changed=1"; echo "conf=$conf"
  [[ -z $dbro ]] || echo "$dbro"
}

# cfg_reload new: configure's one daemon-reload (with 200 apps 4.5-8 s of PID 1, and new apps
# wait for each other's), then the app's unit enabled if a release is live (unit_boot). A new
# app's units are new to systemd, which reads a unit from disk when it is first used (systemd
# retries a name it did not find), so it needs none: only when one of them is loaded already from
# files that changed since (the names of an app destroyed before; NeedDaemonReload). A new app has
# no release yet, so its unit is not enabled here at all: op_trailer's unit_boot enables it once
# its first release is verified, without a reload either (unit_enable). An app that exists gets
# the reload as before (its units are loaded).
cfg_reload() {
  local u=() f
  if (($1)); then
    for f in "/etc/systemd/system/tando-$A".* "/etc/systemd/system/tando-${A}_"* "/etc/systemd/system/tando-$A-"*; do
      [[ -f $f ]] && u+=("${f##*/}")
    done
    u+=("$(app_slice)" "systemd-journald@tando-$A.service")
    systemctl show -P NeedDaemonReload "${u[@]}" 2> /dev/null | grepq -x yes || return 0
    systemctl daemon-reload
  else
    systemctl daemon-reload
    # enabled (started at boot) once a release is live: a first deploy that fails leaves no unit
    # that fails at every boot (op_trailer's unit_boot enables it when that release is verified)
    has_unit && [[ -z ${S[stopped]:-} && -n ${S[current]:-} ]] && unit_enable enable
  fi
  return 0
}

# activate <app> <token> <build s> <upload s>: start a detached activation, print its id
# activate <app> <build s> <upload s>, the lease token on stdin (kept out of process lists);
# the older form activate <app> <token> <build s> <upload s> is still accepted
cmd_activate() {
  need_root; app "$1"; shift
  local token b u id base n=1
  local conf=""
  if (($# == 3)); then token=$1; shift; else IFS= read -r token || token=""; IFS= read -r conf || true; fi
  b=${1:-0} u=${2:-0}
  # conf: the id of this deploy's settings (configure printed it); none from an older client or a
  # deploy key: the activation takes the last configure's
  [[ -z $conf || $conf =~ ^[0-9]{1,10}$ ]] || die "bad settings id"
  [[ -z $conf || -f $D/confs/$conf ]] || die "the settings of this deploy are no longer on the server: run the deploy again"
  # this activate holds the lease until it writes the release id into it: killed before that,
  # recovery gives the lease back (lease_orphaned)
  lease_lock; load "$D/upload" L
  if [[ -n $token && ${L[token]:-} == "$token" && -z ${L[id]:-} ]]; then
    L[holder]="$$ $(pstart $$)"; save "$D/upload" L
  fi
  flock -u 7
  recover
  load "$D/state" S; held_refuse
  [[ $b =~ ^[0-9]+(\.[0-9])?$ && $u =~ ^[0-9]+(\.[0-9])?$ ]] || die "bad timings"
  lease_lock
  load "$D/upload" L
  if ! [[ -n $token && ${L[token]:-} == "$token" && -z ${L[id]:-} ]]; then
    # another client's lease now (it took over this one): say so; no lease at all: it expired
    [[ -n ${L[token]:-} && ${L[token]} != "$token" ]] &&
      die "another deploy of $A started while this one was uploading; run the deploy again"
    [[ -n $token && ${L[token]:-} == "$token" ]] && die "this upload was already activated as release ${L[id]}"
    die "this upload's lease expired; run the deploy again"
  fi
  [[ -n $(ls -A "$D/incoming") ]] || die "nothing uploaded"
  # this client's rsync has ended; another one still writing would mix its files into the release
  upload_writing && die "another upload into $A's incoming/ is still running, so this upload may be mixed with it; nothing was activated: run the deploy again"
  # the same upload as the live, verified release, with the same settings: nothing to do (no new
  # release, no restart). Exact: incoming/ is compared by its entries' change times and inodes,
  # which any write by rsync changes. Not for containers (image = may name a newer image), and not
  # with a release command: that runs on every deploy, of unchanged code too
  local cur=${S[current]:-}
  if [[ -n $cur && ${S[inc_id]:-} == "$cur" && ${S[status_$cur]:-} == verified && ${S[phase]:-idle} == idle &&
        -z ${S[stopped]:-}${S[down]:-} && ${C[recipe]:-node} != container && -n ${S[applied]:-} &&
        -z ${C[release]:-} &&
        ${S[inc_applied]:-} == "${conf:-${S[staged]:-}} ${S[applied]}" && $(cur_link) == "$cur" && $(inc_sum) == "${S[inc_sum]:-}" ]] &&
     { ! has_unit || idle_app || systemctl -q is-active "tando-$A"; }; then
    rm -f "$D/upload"
    AUDIT_NOTE="unchanged: release $cur stays live"
    echo "id=$cur"; echo "same=1"
    return 0
  fi
  # the copy needs room: the upload's size plus a margin, or nothing starts
  local need free
  need=$(du -sk "$D/incoming" 2> /dev/null | cut -f1); [[ $need =~ ^[0-9]+$ ]] || need=0; need=$((need + 8192))
  free=$(df -Pk "$D/releases" | awk 'NR == 2 { print $4 }'); [[ $free =~ ^[0-9]+$ ]] || free=0
  # (a refusal from here on gives the lease back, so the next deploy need not wait for it to age)
  ((free >= need)) || { rm -f "$D/upload"; die "not enough disk space on <host> for this release: it needs $((need / 1024)) MB, $((free / 1024)) MB are free (tando doctor)"; }
  # and as many free inodes as the upload has entries (a release of many small files)
  local nf ifree
  # (a file system without a fixed inode count, btrfs, reports 0 of 0: no limit)
  nf=$(find "$D/incoming" -xdev 2> /dev/null | wc -l); [[ $nf =~ ^[0-9]+$ ]] || nf=0; ifree=$(df -Pi "$D/releases" | awk 'NR == 2 { print ($2 > 0 ? $4 : "") }')
  [[ $ifree =~ ^[0-9]+$ ]] && ((ifree < nf + 1000)) && rm -f "$D/upload" &&
    die "not enough free inodes on <host> for this release: it has $nf files, $ifree inodes are free (tando doctor; old releases: tando releases)"
  base=$(date -u +%Y%m%d-%H%M%S); id=$base
  fp act.mkdir || { rm -f "$D/upload"; die "could not reserve a release id (test fault)"; }
  until mkdir "$D/releases/$id" 2> /dev/null; do
    n=$((n + 1)); id="$base-$n"; ((n < 100)) || { rm -f "$D/upload"; die "could not reserve a release id"; }
  done
  L[id]=$id; save "$D/upload" L || { rmdir "$D/releases/$id"; rm -f "$D/upload"; die "could not record the release (disk full?)"; }
  # (its number in deploy order is given by the activation once it holds the app's lock: activate
  # itself never waits for another activation's soak; the client sees "queued" and says for what)
  local who=() w f
  [[ -x $LOGS ]] && read -r w f < <("$LOGS" audit-origin) && who=(-E "TANDO_AUDIT_WHO=$w" -E "TANDO_AUDIT_FROM=$f")
  # ExecStopPost: whatever ends the activation (an OOM kill, SIGKILL, a full disk), recover runs
  # at once and finishes or reverts it, so no release stays half-activated. Bounds: the whole
  # activation (an hour of waiting for the app's lock, the copy, build or image pull, the release
  # command, two health checks, the soak: RuntimeMaxSec, then ExecStopPost reverts it), and that
  # recovery itself, which may verify and soak the release again (TimeoutStopSec)
  local ht=${C[health_timeout]:-60} sk=${C[soak]:-${H[soak]:-$SOAK}} rt=0
  [[ -n ${C[release]:-} ]] && rt=${C[release_timeout]:-300}
  [[ $ht =~ ^[0-9]+$ ]] || ht=60; [[ $sk =~ ^[0-9]+$ ]] || sk=$SOAK; [[ $rt =~ ^[0-9]+$ ]] || rt=300
  if ! fp act.spawn || ! systemd-run --quiet --collect --unit="tando-$A-act-$id" "${who[@]}" \
      -p Description="tando activation $A $id" -p "ExecStopPost=$AGENT recover $A" \
      -p "RuntimeMaxSec=$((3600 + 3600 + rt + 3 * ht + sk + 600))" -p "TimeoutStopSec=$((3 * ht + sk + 180))" \
      "$AGENT" run-activation "$A" "$id" "$b" "$u" ${conf:+"$conf"}; then
    rmdir "$D/releases/$id"; rm -f "$D/upload"
    die "systemd-run failed"
  fi
  AUDIT_VERB=""   # the activation writes the deploy's audit line when it ends
  echo "id=$id"
}

# map the data directory and the Next cache into shared/ (never over shipped files)
# Directories in shared/ (app-owned) are created by the app user itself, so the kernel applies the
# app's rights: root never creates, chowns or chmods anything there (a planted symlink would make
# root act on its target). At activation root only verifies them.
shared_ok() { local p=$D/shared/$1; [[ -d $p && ! -L $p && $(stat -c %U "$p") == "$AU" ]]; }
ensure_shared() { # name: create if missing (as the app user), then verify
  [[ -e $D/shared/$1 || -L $D/shared/$1 ]] || as_app mkdir -m 750 "$D/shared/$1" ||
    fail "could not create shared/$1"
  shared_ok "$1" || fail "shared/$1 is not a directory of $AU (a symbolic link?): refusing to use it"
}

link_shared() { # release dir
  local rel=$1 d
  # TANDO_DATA_DIR is in every unit's environment and HOME is read-only: the directory must exist
  [[ -n ${C[data_dir]:-} ]] || ensure_shared data
  if [[ -n ${C[data]:-} ]]; then
    d=${C[data]}
    [[ -e $rel/$d || -L $rel/$d ]] && fail "data directory '$d' ships in the release; remove it from the upload"
    ensure_shared data
    mkdir -p "$(dirname "$rel/$d")"
    ln -s "$D/shared/data" "$rel/$d"
  fi
  if [[ ${C[recipe]:-node} == next && -d $rel/.next ]]; then
    [[ -e $rel/.next/cache ]] && fail ".next/cache ships in the release; it must not be uploaded"
    if [[ ${C[next_cache]:-} == release ]]; then   # adopted: the image cache lives and dies with the release
      install -d -m 750 -o "$AU" -g "$AU" "$rel/.next/cache"
    else
      ensure_shared next-cache
      ln -s "$D/shared/next-cache" "$rel/.next/cache"
    fi
  fi
}

# next_images port release-dir: load sharp as Next itself finds it (Node's resolution from next's
# own directory: a copy nested under node_modules/next/node_modules when the project asks for
# another version), and every other copy the release ships, as the app's user in its sandbox;
# (a copy whose entry file is not in the release is not counted: nothing can load it);
# then request every /_next/image URL of the health page and the start page once (at most 60, for
# at most 60 s). False, with PROBE_WHY, when a sharp does not load (which one, and whether it is
# the one Next uses) or the optimiser answers 5xx.
next_images() { # port release-dir
  local base="http://127.0.0.1:$1" pg u code n=0 bad=0 first="" end err out l rel=$2 others=()
  local -A seen=()
  # the module itself first: images already in the cache are served without it, so the requests
  # below would not notice a sharp that cannot load
  while IFS= read -r l; do others+=("${l%/package.json}"); done < <(
    find "$rel" -path '*/node_modules/sharp/package.json' -not -path '*/.next/cache/*' 2> /dev/null | sort | head -20)
  if command -v node > /dev/null && { ((${#others[@]})) || [[ -d $rel/node_modules/next ]]; }; then
    # (node prints one line per copy: ok|bad <TAB> path <TAB> next|- <TAB> error; it reads only
    # the paths given, and loads sharp the way the app does)
    local js='
      const path = require("path"), fs = require("fs"), { createRequire } = require("module");
      const rel = process.argv[1];
      const clean = (s) => String(s).split("\n")[0].replace(/[^\x20-\x7e]/g, "?").slice(0, 200);
      const pkgDir = (f, name) => {   // the directory of the package that holds file f
        for (let d = path.dirname(f); d !== path.dirname(d); d = path.dirname(d)) {
          try { if (JSON.parse(fs.readFileSync(path.join(d, "package.json"))).name === name) return d; } catch (e) {}
        }
        return "";
      };
      let next = "", sharp = "";
      try { next = pkgDir(require.resolve("next", { paths: [rel] }), "next"); } catch (e) {}
      if (!next && fs.existsSync(path.join(rel, "node_modules/next/package.json"))) next = path.join(rel, "node_modules/next");
      if (next) {
        try { sharp = pkgDir(createRequire(path.join(next, "package.json")).resolve("sharp"), "sharp"); } catch (e) {}
      }
      const real = (p) => { try { return fs.realpathSync(p); } catch (e) { return ""; } };
      sharp = sharp && real(sharp);
      const all = [...new Set([sharp, ...process.argv.slice(2).map(real)].filter(Boolean))];
      for (const p of all) {
        const who = p === sharp ? "next" : "-";
        // a copy without its entry file (Next traced only its package.json) is not loaded by
        // anything; the copy Next resolves must load
        if (who === "-") { try { require.resolve(p); } catch (e) { console.log(["skip", p, who, ""].join("\t")); continue; } }
        try { require(p); console.log(["ok", p, who, ""].join("\t")); }
        catch (e) { console.log(["bad", p, who, clean(e.message)].join("\t")); }
      }'
    out=$(as_app_unit node -e "$js" "$rel" ${others[@]+"${others[@]}"} 2>&1)
    err=$(awk -F'\t' '$1 == "bad" { print; exit }' <<< "$out")
    if [[ -n $err ]]; then
      IFS=$'\t' read -r _ l u code <<< "$err"
      l=${l#"$rel"/}; l=${l#"$(readlink -f "$rel")"/}
      [[ $u == next ]] && u=" (the copy Next.js uses)" || u=""
      n=$(grep -c '^bad' <<< "$out")
      PROBE_WHY="the image optimiser cannot start: sharp does not load in this release: $l$u: ${code:0:200}"
      ((n > 1)) && PROBE_WHY+=" ($((n - 1)) more copies do not load either)"
      PROBE_WHY+=". A release built on another kind of machine needs sharp for this server's platform (docs/CROSS-ARCH.md)"
      return 1
    elif ! grep -qE '^(ok|skip)' <<< "$out" && ((${#others[@]})); then
      PROBE_WHY="the image optimiser cannot start: sharp could not be checked in this release ($(head -c 200 <<< "$out" | tr '\n' ' '))"
      return 1
    fi
  fi
  mono; end=$((MONO + 60))
  for pg in "$(health_path)" "${C[path]:-/}"; do
    while IFS= read -r u; do
      [[ -n $u && -z ${seen[$u]:-} ]] || continue
      seen[$u]=1
      mono; ((n < 60 && MONO < end)) || break 2
      code=$(curl -s -o /dev/null -m 20 -w '%{http_code}' -H 'Accept: image/avif,image/webp,*/*' "$base$u" 2> /dev/null)
      n=$((n + 1))
      if [[ $code == 5* ]]; then bad=$((bad + 1)); [[ -n $first ]] || first="HTTP $code for $u"; fi
    done < <(curl -s -m 10 "$base$pg" 2> /dev/null | grep -o '/[^" ]*_next/image?url=[^" ]*' | sed 's/&amp;/\&/g' | head -100)
  done
  ((bad == 0)) && return 0
  PROBE_WHY="the image optimiser failed for $bad of $n images of the page (${first:0:160}). On a release built on another kind of machine this is usually the sharp package: tando logs --release shows its error"
  return 1
}

# metadata of every entry in incoming/ (ctime catches any change); compared around the copy
upload_sum() { find "$D/incoming" -printf '%P\t%y\t%s\t%C@\t%i\t%n\n' | sort | cksum; }
# the same without incoming/ itself (its mode is changed after each copy): what was activated last
inc_sum() { find "$D/incoming" -mindepth 1 -printf '%P\t%y\t%s\t%C@\t%i\t%n\t%m\n' | sort | cksum; }

# run-activation <app> <id> <build> <upload>: runs inside its own transient unit
cmd_run_activation() {
  need_root; app "$1"
  local id=$2 rel=$D/releases/$2 t l bad x
  valid_id "$id" || die "bad id"
  # queued for an hour: the reason goes with the reservation (its lease), so the deploy ends
  # "failed: waited an hour for ..." (rec_reap), not as if the server had restarted
  ra_giveup() {
    local why; why="it waited an hour for $(lock_holder) on $A and gave up; nothing was changed: run the deploy again"
    lease_lock; load "$D/upload" L
    [[ ${L[id]:-} == "$id" ]] && { L[why]=$why; save "$D/upload" L; }
    flock -u 7
  }
  # (test fault point: fail = the hour of waiting ran out)
  fp run.queue || { ra_giveup; die "$A is busy (test fault)"; }
  LOCK_GIVEUP=ra_giveup lock 3600
  fp run.locked
  AUDIT_NOTE="release $id"
  load "$D/state" S
  if [[ -n ${S[hold]:-} ]]; then   # held while it was queued: given up (rec_reap reports the reason)
    local hw="$A is held (${S[hold]}): release it first"
    lease_lock; load "$D/upload" L
    [[ ${L[id]:-} == "$id" ]] && { L[why]=$hw; save "$D/upload" L; }
    flock -u 7
    die "$hw"
  fi
  # its number in deploy order (rollback and prune go by it, not by the clock); a damaged value
  # starts again after the highest number a release still has
  if ! [[ ${S[seq]:-0} =~ ^[0-9]{1,9}$ ]]; then
    local k m=0; for k in "${!S[@]}"; do [[ $k == seq_* && ${S[$k]} =~ ^[0-9]{1,9}$ ]] && ((10#${S[$k]} > m)) && m=$((10#${S[$k]})); done
    S[seq]=$m
  fi
  S[seq]=$(( 10#${S[seq]:-0} + 1 )); S[seq_$id]=${S[seq]}
  # the reservation was given up meanwhile (recover found its unit gone: a stale one)
  [[ -d $rel && -z ${S[status_$id]:-} ]] || die "release $id was given up while it waited"
  P=([id]=$id [kind]=deploy [phase]=copy [result]=running [started]=$(now) [started_ds]=$(ds) [t_build]=$3 [t_upload]=$4); pg
  # what to go back to: the last good release; with a lost or emptied state, whatever current points
  # at now (a failed deploy must never stop an app that was serving)
  local l0; l0=$(cur_link)
  if [[ -z ${S[current]:-} && -n $l0 && -d $D/releases/$l0 ]]; then   # it was serving: say so again
    S[current]=$l0 S[status_$l0]=verified; [[ -n ${S[last_good]:-} ]] || S[last_good]=$l0
  fi
  local prev=${S[current]:-$l0} fb=${S[last_good]:-}
  [[ -n $fb && -d $D/releases/$fb ]] || fb=$prev
  # (pre_stopped: a deploy to a stopped app that does not go live leaves it stopped)
  st phase copy target "$id" kind deploy prev "$prev" fallback "$fb" pre_stopped "${S[stopped]:-}"
  # this deploy's settings (configure staged them; activate passes their id; without one, an older
  # client's or a deploy key's, the last configure's): in memory now, for the copy and pre-flight;
  # app.conf, the unit file and the site take them at the switch. LC: the live release's
  local cf=${5:-${S[staged]:-}} k CONF_PUT=0
  local -A LC=() NC=(); conf_copy C LC
  fail() {
    AUDIT_NOTE="release $id: $1"
    S[status_$id]=bad
    # the live release's settings: never this release's (applied at the switch: put back)
    conf_copy LC C
    { fp fail.start_back && start_back "$prev" && { ((!CONF_PUT)) || conf_put; }; } ||
      echo "tando-agent: could not put back the live release's settings (disk full?)" >&2
    db_follow   # (the role's limits: the live release's again, when the release command had this one's)
    end_op "$id" deploy failed "$1"
    free_lease 2> /dev/null   # (a failure before the copy ended: the upload's lease goes with it)
    exit 1
  }
  if [[ -n $cf ]]; then
    [[ $cf =~ ^[0-9]{1,10}$ && -f $D/confs/$cf ]] ||
      fail "the settings of this deploy are no longer on the server (staged over a day ago?): run the deploy again"
    load "$D/confs/$cf" NC
    for k in "${!C[@]}"; do conf_key "$k" && unset "C[$k]"; done
    for k in "${!NC[@]}"; do conf_key "$k" && C[$k]=${NC[$k]}; done
    app_vars
  elif [[ -f $D/pending.conf ]]; then   # (staged by an agent before conf ids: start and health only)
    local -A PD=(); load "$D/pending.conf" PD
    for k in start start_shell health health_expect; do
      [[ -n ${PD[$k]+x} ]] || continue
      if [[ -n ${PD[$k]} ]]; then C[$k]=${PD[$k]}; else unset "C[$k]"; fi
    done
  fi
  rm -f "$D/pending.conf"
  CONF_ID="$cf ${S[applied]:-}"      # (for an unchanged next deploy: import_release records it)
  # how this release starts, is checked and runs, and its jobs: as configured for it
  { fp run.jobs_snap && jobs_snap "$id" && start_snap "$id"; } || fail "could not record the release's jobs (disk full?)"

  # one limit for the upload and the releases kept, in real bytes (du counts a hardlink once)
  local used max=$(( ${H[app_max_mb]:-8192} * 1048576 ))
  used=$(du -sbc "$D/incoming" "$D/releases" 2> /dev/null | awk 'END { print $1 }'); [[ $used =~ ^[0-9]+$ ]] || used=0
  # (refused for its size: the upload is cleared, so incoming/ does not keep holding it)
  ((used <= max)) || { find "$D/incoming" -mindepth 1 -delete 2> /dev/null; fail "the upload and the releases kept use $((used / 1048576)) MB, over this server's limit of $((max / 1048576)) MB per app (host setup app_max_mb=N); the upload was cleared"; }

  t=$(ds)
  import_release
  pg t_copy "$(el "$t")" phase preflight

  # pre-flight: run the new release on a spare port beside the live app
  t=$(ds); st phase preflight
  preflight_static
  local spare=${C[preflight_port]:-$((${C[port]:-0} + 100))} unit="tando-$A-pre-$id" args=() x
  # another process answering on the spare port could pass the pre-flight in the new release's place
  has_unit && ss -Hltn "sport = :$spare" | grepq . && fail "pre-flight port $spare is in use by another process"
  while IFS= read -r x; do args+=(-p "$x"); done < <(props "$spare" preflight)
  has_unit && { fp pre.spawn && systemd-run --quiet --collect --unit="$unit" "${args[@]}" -p "WorkingDirectory=$rel" \
    "$AGENT" exec-app "$A" "$rel" || fail "could not start the pre-flight unit"; }
  if has_unit && ! { probe "${C[health_timeout]:-60}" "$unit" "http://127.0.0.1:$spare$(health_path)" &&
                     own_listener "$spare" "$unit.service"; }; then
    app_journal -u "$unit" -n 60 --no-pager -o cat > "$D/activation.log" 2>&1
    systemctl stop "$unit" 2> /dev/null
    P[t_preflight]=$(el "$t")     # written with the failure itself, in one pg (no ✓ in between)
    fail "pre-flight: $PROBE_WHY"
  fi
  # Next.js: the pages' optimised images are asked for once on the spare port. A sharp binary for
  # another platform answers 500 here, before any visitor sees it; and the image cache is warm
  # when the release goes live (same release directory, or the shared cache)
  if [[ ${C[recipe]:-} == next ]] && ! next_images "$spare" "$rel"; then
    app_journal -u "$unit" -n 60 --no-pager -o cat > "$D/activation.log" 2>&1
    systemctl stop "$unit" 2> /dev/null
    P[t_preflight]=$(el "$t")
    fail "pre-flight: $PROBE_WHY"
  fi
  has_unit && assets_sample "$spare" "$id"
  has_unit && fp pre.stop && systemctl stop "$unit"
  : > "$D/activation.log"
  pg t_preflight "$(el "$t")" phase switch

  # back up the app's data, switch, then verify through Caddy (finish goes back to last_good).
  # domains_new: the domains of tando.conf this release adds (configure staged them), recorded
  # with the phase: a revert, also recovery's, takes them out again
  local dnew="" x why
  for x in ${NC[domain_add]:-}; do [[ " ${C[domains]:-} " == *" ${x%|*}|"* ]] || dnew+="${dnew:+ }$x"; done
  t=$(ds); st phase switch domains_new "$dnew"
  { fp sw.caddy_up && caddy_up; } || fail "Caddy is not running on <host> and did not start, so nothing was switched (sudo journalctl -u caddy -n 20)"
  if has_unit && ! own_listener "${C[port]}" "tando-$A.service" && [[ $PROBE_WHY == *"outside"* ]]; then
    fail "port ${C[port]} is held by another process, not by tando-$A: nothing was switched ($PROBE_WHY)"
  fi
  # the backup is of what the live release has, by its settings (LC): a database or data directory
  # this release adds has nothing in it yet to keep (and the app's user may reach PostgreSQL only
  # from this deploy on)
  local bk="" brc=0
  # shellcheck disable=SC2034  # NC2 is read by conf_copy through its nameref
  local -A NC2=(); conf_copy C NC2; conf_copy LC C; app_vars
  if has_backup_data; then
    # (in this shell, not $(...): backup_take records last_backup in the state)
    { fp sw.backup && backup_take predeploy > /dev/null 2> "$D/backup.err"; } && bk=$BK_ID || brc=1
  fi
  conf_copy NC2 C; app_vars
  ((!brc)) || fail "the pre-deploy backup failed, so the release was not switched in: $(tail -c 300 "$D/backup.err" | tr '\n' ' ')"
  # the release command (migrations): after the pre-flight passed and the backup was taken, before
  # the switch. Its time is its own phase; the switch phase is what came before it plus the switch
  if [[ -n ${C[release]:-} ]]; then
    # (under this release's database limits: a migration needs the db_temp_limit it was deployed
    # with; a deploy that does not go live puts the live release's back: fail, recover)
    fp rel.db && db_follow
    local sw=$(( $(ds) - t ))
    t=$(ds); st phase release; pg phase release
    fp rel.run
    run_release "$bk"
    pg t_release "$(el "$t")" phase switch
    t=$(( $(ds) - sw )); st phase switch
  fi
  # its domains: another app may have taken one since configure checked it. Checked again and
  # written under the host-wide domain lock (taken after the app's: one order), held until
  # app.conf has them
  if [[ -n $dnew ]]; then
    { fp sw.domains && lockfile "$R/.domains.lock" && exec 6>"$R/.domains.lock" && flock -w 120 6; } ||
      fail "another domain change on this server takes too long, so nothing was switched; deploy again"
    for x in $dnew; do
      why=$(domain_free "${x%|*}" "${x#*|}" 2>&1) || fail "${why#tando-agent: }; nothing was switched"
      C[domains]="${C[domains]:+${C[domains]} }$x"
    done
  fi
  # its settings: app.conf and the unit file now (the site with the restart in switch_to)
  if [[ -n $dnew || $(conf_text C) != "$(conf_text LC)" ]]; then
    CONF_PUT=1
    { fp sw.conf && conf_put; } || fail "could not apply this release's settings (disk full?)"
  fi
  [[ -z $dnew ]] || flock -u 6
  local rc=0
  if ! switch_to "$id"; then
    ((SW_MOVED)) || fail "could not switch to the new release (disk full?)"
    # the link moved: the new release may be what runs now. Back to the last good one
    PROBE_WHY="the new release could not be started (${WC_WHY:-systemctl restart failed}: tando logs --release $id)"
    pg t_switch "$(el "$t")"
    revert deploy "$PROBE_WHY"; rc=1
  else
    st phase verify; pg t_switch "$(el "$t")"
    finish deploy || rc=1
  fi
  if ((rc)); then
    AUDIT_RESULT=rolledback AUDIT_NOTE="release $id: ${P[message]:-rolled back}"
    app_journal -u "tando-$A" -n 60 --no-pager -o cat > "$D/activation.log" 2>&1
  fi
  fp run.prune && prune
  exit $rc
}

# ---- the release command ---------------------------------------------------------------------
#
# release = <command> in tando.conf: run once per deploy (database migrations, mostly), in the new
# release's directory, as the app's user in the app's sandbox, slice and environment (props - job:
# what a scheduled job gets; no listening socket), after the pre-flight passed and the pre-deploy
# backup was taken, before the switch. A failure or a timeout fails the deploy: nothing is switched.
# tando restores nothing: the live release is still writing to the same database.
# Not for static sites (no process, no sandbox user that reads the release) nor containers (the
# release is an image: its entrypoint is the place).

# shell syntax in a command that runs without a shell would reach the program as literal words
release_ok() {
  [[ -n ${C[release]:-} ]] || {
    [[ -z ${C[release_shell]:-}${C[release_timeout]:-} ]] || die "release_shell and release_timeout need release = <command>"
    return 0; }
  case ${C[recipe]:-node} in
    static) die "release is not supported for a static site: it has no process to run a command as (a build step belongs in build =)";;
    container) die "release is not supported for recipe = container: run the migration in the image's entrypoint, before the server starts";;
    workerd) die "release is not supported for recipe = workerd: a Workers app has no Node to run a command with";;
  esac
  [[ ${C[release_shell]:-} == true || ${C[release]} != *[\|\&\;\<\>\$\`\"\'\\\(\)\*\?\~\{\}\#]* ]] ||
    die "release has shell syntax (quotes, &&, |, \$VAR ...) but runs without a shell: set release_shell = true to run it with sh -c, or put it in a script"
  return 0
}

# exec-release <app> <dir>: runs as the app user inside the release unit. The command comes from
# app.conf, never from an argument. Without release_shell it is split on spaces, with no shell.
cmd_exec_release() {
  app "$1"
  local dir=${2:-} argv
  [[ $dir == "$D"/releases/* && $dir != *..* ]] || die "bad dir"
  cd "$dir" || die "no release"
  rel_conf "${dir##*/}"     # (its own settings: app.conf is the live release's until the switch)
  [[ -n ${C[release]:-} ]] || die "no release command"
  [[ ${C[recipe]:-} == python && -d $dir/.venv ]] && export VIRTUAL_ENV=$dir/.venv PATH="$dir/.venv/bin:$PATH"
  # a migration needs a session of its own (advisory locks, SET, prepared statements): PostgreSQL's
  # port, not pgbouncer's (the app's DATABASE_URL may be either)
  [[ -n ${DATABASE_URL_DIRECT:-} ]] && export DATABASE_URL=$DATABASE_URL_DIRECT
  if [[ ${C[release_shell]:-} == true ]]; then exec /bin/sh -c "${C[release]}"; fi
  read -ra argv <<< "${C[release]}"
  exec "${argv[@]}"
}

# run_release [backup id]: inside run-activation (uses id, rel, t and fail from there). Returns
# when the command exited 0; otherwise the deploy fails here. The command's output is in the app's
# journal under its unit (tando logs --deploy <id>); its last lines go to activation.log (the
# deploy box) and into the failure message (tando history).
run_release() {
  local bk=${1:-} unit="tando-$A-rel-$id" args=() x out res code why last i to=${C[release_timeout]:-300}
  while IFS= read -r x; do args+=(-p "$x"); done < <(props - job)
  # PORT: the app's own (as in tando ssh), though nothing can listen here; RuntimeMaxSec: the
  # timeout, by systemd (TERM, then KILL after 10 s), so it holds when this agent is killed too
  out=$(systemd-run --wait --collect --unit="$unit" "${args[@]}" -p "Description=tando release command $A $id" \
    -p "WorkingDirectory=$rel" -p "RuntimeMaxSec=$to" -p TimeoutStopSec=10 \
    -E "PORT=${C[port]:-}" -E "TANDO_RELEASE=$id" "$AGENT" exec-release "$A" "$rel" 2>&1 < /dev/null)
  res=$(sed -n 's/.*Finished with result: //p' <<< "$out" | head -1)
  [[ $res == success ]] && return 0
  systemctl reset-failed "$unit" 2> /dev/null     # (a failed unit can outlive --collect: seen after a timeout)
  # ("code=exited, status=3/NOTIMPLEMENTED", "code=killed, status=9/KILL"; older systemd: "code=exited/status=3")
  code=$(sed -n 's/.*Main processes terminated with: .*status=//p' <<< "$out" | head -1 | tr -cd 'A-Za-z0-9/')
  case $res in
    exit-code) code=${code%%/*}; why="the release command failed (exit status ${code:-?})";;
    timeout) why="the release command did not finish within $to s (release_timeout) and was stopped";;
    oom-kill) why="the release command was killed: out of memory (memory = ${C[memory]:-256M})";;
    signal|core-dump) code=${code##*/}; why="the release command died from signal ${code:-?}";;
    *) why="the release command could not be started ($(tail -1 <<< "$out" | cut -c1-160))";;
  esac
  # its own last lines (journald may still be writing them: wait up to 3 s)
  for i in 1 2 3 4 5 6; do
    journalctl --sync 2> /dev/null; [[ -n $(jns) ]] && journalctl "$(jns)" --sync 2> /dev/null
    last=$(app_journal "_SYSTEMD_UNIT=$unit.service" _TRANSPORT=stdout -o cat --no-pager -n 60 2> /dev/null)
    [[ -n $last ]] && break
    sleep 0.5
  done
  printf '%s\n' "$last" > "$D/activation.log"
  last=$(grep . <<< "$last" | tail -2 | tr '\n' '|' | tr -s '[:space:]' ' ' | sed 's/|$//; s/|/ | /g' | cut -c1-240)
  why+=", so nothing was switched and the old release keeps serving"
  [[ -n $last ]] && why+=". Its last output: $last"
  # what the command changed stays changed: the live release is writing to the same data
  [[ -n $bk ]] && why+=". Data and database were not put back; as they were before the command: backup $bk (tando backup restore $bk)"
  P[t_release]=$(el "$t")       # written with the failure itself, in one pg (as a failed pre-flight)
  fail "$why"
}

# ---- importing a release: incoming/ -> releases/<id> -----------------------------------------
# (runs inside run-activation: uses id, rel and fail from there)

free_lease() {
  lease_lock; load "$D/upload" L
  [[ ${L[id]:-} == "$id" ]] && rm -f "$D/upload"     # incoming/ is free for the next upload
  flock -u 7
}

import_release() {
  if [[ ${C[recipe]:-node} == container ]]; then import_image; return; fi
  # copy without following symlinks, make it root-owned and read-only to the app (static: to
  # Caddy, which serves it), then inspect the copy (not the upload, which can still change)
  local group=$AU l bad
  has_unit || group=caddy
  rm -rf "$rel"
  local before after
  before=$(upload_sum)
  local after_inc; after_inc=$(inc_sum)
  [[ -d $D/incoming && ! -L $D/incoming ]] || { free_lease; fail "incoming/ is not a directory"; }
  # a file with the same bytes as in the live release is a hard link to it, not a copy (rsync
  # --link-dest -c; the modify window: whatever its time, as a build writes every file anew; it
  # keeps the live file's time). -H -D: links and special files of the upload come along as with
  # cp -a, so the checks below refuse them as before. Only a release of the same group: chown
  # below must not change a file another release holds (unshare_release)
  local prev=${S[current]:-} ld=()
  valid_id "$prev" && [[ $prev != "$id" && -d $D/releases/$prev && ! -L $D/releases/$prev &&
    $(stat -c %G "$D/releases/$prev") == "$group" ]] && ld=(--link-dest="$D/releases/$prev") || prev=""
  # with the live release's manifest (sum_plan): only the files it names as the same bytes are
  # linked, no byte of the live release is read; without one, rsync -c compares them
  local W=$D/sums/$id.work how=checksum f x
  for f in "$D"/sums/*; do   # (those of releases that are gone)
    x=${f##*/}; x=${x%%.*}; [[ -e $f && ! -d $D/releases/$x ]] && rm -rf "$f"
  done
  rm -rf "${W:?}" "${D:?}/sums/$id" "${D:?}/sums/$id.tmp"; install -d -m 700 -o root -g root "$D/sums" "$W" ||
    { free_lease; fail "could not write the release's manifest (disk full?)"; }
  sum_plan "$prev" "$group" && how=manifest
  if ! { fp imp.cp && sum_copy "$how" ${ld[@]+"${ld[@]}"} 2> "$D/copy.err"; }; then
    # the cause in words: rsync's own error, and what is left on the file system
    local why fb ifree
    why=$(grep -v '^$' "$D/copy.err" | tail -1 | cut -c1-200)
    fb=$(df -Pk "$D/releases" 2> /dev/null | awk 'NR == 2 { print int($4 / 1024) }')
    ifree=$(df -Pi "$D/releases" 2> /dev/null | awk 'NR == 2 { print ($2 > 0 ? $4 : "") }')
    rm -rf "$rel"
    if [[ $ifree =~ ^[0-9]+$ ]] && ((ifree < 1000)); then
      fail "copy failed: no free inodes ($ifree left; the upload and the releases kept hold $(find "$D/incoming" "$D/releases" -xdev 2> /dev/null | wc -l) files): ${why:-rsync failed}"
    fi
    fail "copy failed: ${why:-rsync failed} (${fb:-?} MB and ${ifree:-?} inodes free)"
  fi
  rm -f "$D/copy.err"
  after=$(upload_sum)
  [[ $before == "$after" ]] || { rm -rf "$rel"; fail "the upload changed during the copy"; }
  chmod go-rwx "$D/incoming"   # rsync -p copies the client's mode; other users never read it
  st inc_id "$id" inc_sum "$after_inc" inc_applied "${CONF_ID:-}"   # (for an unchanged next deploy)
  fp imp.free_lease
  free_lease
  # every hard link in the release is a file of the live release, under one name only (a hard
  # link of the upload, to anything, is refused)
  bad=$(find "$rel" ! -type d -links +1 -printf '%i\n' | sort | uniq -d | head -1)
  [[ -z $bad ]] || fail "hardlink in release: $(find "$rel" -inum "$bad" -printf '%P\n' -quit)"
  if [[ -n $prev ]]; then
    bad=$(comm -23 <(find "$rel" ! -type d -links +1 -printf '%i\n' | sort -u) <(find "$D/releases/$prev" ! -type d -printf '%i\n' | sort -u) | head -1)
  else
    bad=$(find "$rel" ! -type d -links +1 -printf '%i\n' -quit)
  fi
  [[ -z $bad ]] || fail "hardlink in release: $(find "$rel" -inum "$bad" -printf '%P\n' -quit)"
  # a file shared with the live release stays shared only when the owner and mode it already
  # has are the ones chown and chmod below give it (they leave it as it is), and nothing writes
  # to it or changes its mode after the import; any other is copied (unshare_release)
  [[ -n $prev ]] && { fp imp.unshare; unshare_release "$rel" "$group" || fail "copy failed: could not copy a shared file"; }
  release_own "$rel" "$group" || fail "chown failed"
  open_public "$rel"
  while IFS= read -r -d '' l; do
    bad=$(readlink -f "$l") || bad=/
    [[ $bad == "$rel"/* ]] || fail "symlink leaves the release: ${l#"$rel"/}"
  done < <(find "$rel" -type l -print0)
  bad=$(find "$rel" -name '.env*' -print -quit)
  [[ -z $bad ]] || fail "secret file in release: ${bad#"$rel"/}"
  bad=$(find "$rel" \( ! -type f ! -type d ! -type l \) -print -quit)
  [[ -z $bad ]] || fail "special file in release: ${bad#"$rel"/}"
  link_shared "$rel"
  make_writable "$rel"
  [[ ${C[recipe]:-node} == python ]] && build_venv
  # last: the manifest, once the release is complete (a kill before it leaves none, and the
  # release is dropped either way)
  { fp imp.sum && sum_write; } || fail "could not write the release's manifest (disk full?)"
  return 0
}

# ---- the release manifest: sums/<id> (root's, 600) ---------------------------------------------
# One line per regular file of the upload: its sha256, size, its inode and mtime in the release,
# its inode and ctime in incoming/, and its path. The next import uses the live release's:
# - a file of the upload whose incoming/ inode, ctime and size are as recorded keeps its hash (no
#   read: any write to it changes its ctime); the others are hashed (just uploaded: in the cache)
# - a file of the live release is the recorded bytes, unread, while it is the recorded inode with
#   the recorded mtime and size, root's with the release's group and mode 640 or 750 (nothing but
#   root wrote to it; a writable directory's files are the app's): then a file of the upload with
#   the same path, size and hash becomes a hard link to it; everything else is copied.
# Written last in the import (temp file, sync, mv): a release killed in its import has none and is
# dropped (drop_release removes it). Checked whole (a sha256 of its lines at its end): a damaged
# one, or none (an older agent's release), and the import compares bytes with rsync -c as before.
# (Paths with a tab, newline or backslash, or starting with # or ;, and files with more than one
# link are not in it: they are copied.)
SUM_HEAD="tando-sum 1"
SUM_ROW=$'^[0-9a-f]{64}\t[0-9]+\t[0-9]+\t[0-9]+\.?[0-9]*\t[0-9]+\t[0-9]+\.?[0-9]*\t[^\t]+$'
# sum_valid file: a whole manifest, as sum_write wrote it
sum_valid() {
  local f=$1 last
  [[ -f $f && ! -L $f && -O $f ]] || return 1
  last=$(tail -n 1 "$f") && [[ $last =~ ^end\ ([0-9a-f]{64})$ ]] || return 1
  [[ $(head -n -1 "$f" | sha256sum) == "${BASH_REMATCH[1]}  -" && $(head -n 1 "$f") == "$SUM_HEAD" ]] || return 1
  ! head -n -1 "$f" | tail -n +2 | grepq -Ev "$SUM_ROW"
}
# sum_plan prev group (in import_release: W, D): hashes the upload (up.tsv: path size hash ino
# ctime) and, with a valid manifest of the live release prev, writes the files to link (link.txt).
# Returns 1 without one: the copy compares bytes (rsync -c)
sum_plan() {
  local prev=$1 group=$2 m=$D/sums/$1 ok=0
  : > "$W/up.tsv"
  find "$D/incoming" -type f -links 1 ! -path $'*\t*' ! -path $'*\n*' ! -path '*\\*' \
    ! -path "$D/incoming/#*" ! -path "$D/incoming/;*" -printf '%P\t%s\t%i\t%C@\n' > "$W/up0" || return 1
  [[ -n $prev ]] && sum_valid "$m" && ok=1
  ((ok)) || : > "$W/live"
  ((ok)) && { head -n -1 "$m" | tail -n +2 > "$W/live"; } 2> /dev/null
  # what is not known by its incoming/ identity is hashed (the paths hold no tab, newline or backslash:
  # sha256sum prints them as they are)
  awk -F '\t' 'FILENAME == ARGV[1] { k[$7] = $2 "\t" $5 "\t" $6; next } !(($1) in k) || k[$1] != $2 "\t" $3 "\t" $4 { print $1 }' \
    "$W/live" "$W/up0" > "$W/tohash"
  (cd "$D/incoming" && xargs -d '\n' -r sha256sum -- < "$W/tohash") > "$W/hashed" || return 1
  awk -F '\t' 'FILENAME == ARGV[1] { k[$7] = $2 "\t" $5 "\t" $6; h[$7] = $1; next }
    FILENAME == ARGV[2] { n[substr($0, 67)] = substr($0, 1, 64); next }
    { x = ($1 in n) ? n[$1] : (($1 in k) && k[$1] == $2 "\t" $3 "\t" $4 ? h[$1] : "")
      if (x != "") print $1 "\t" $2 "\t" x "\t" $3 "\t" $4 }' "$W/live" "$W/hashed" "$W/up0" > "$W/up.tsv" || return 1
  ((ok)) || return 1
  # the live release's files as they are now (metadata only), against its manifest and the upload
  find "$D/releases/$prev" -type f -printf '%P\t%i\t%T@\t%s\t%u\t%g\t%m\n' > "$W/now" || return 1
  awk -F '\t' -v g="$group" 'FILENAME == ARGV[1] { m[$7] = $1 "\t" $2 "\t" $3 "\t" $4; next }
    FILENAME == ARGV[2] { if ($5 == "root" && $6 == g && ($7 == "640" || $7 == "750") && ($1 in m)) {
        split(m[$1], r, "\t"); if (r[2] == $4 && r[3] == $2 && r[4] == $3) ok[$1] = r[1] "\t" r[2] }
      next }
    ($1 in ok) && ok[$1] == $3 "\t" $2 { print $1 }' "$W/live" "$W/now" "$W/up.tsv" > "$W/link.txt"
}
# sum_copy how [--link-dest=prev]: incoming/ -> rel. manifest: the planned files as hard links
# (rsync's own link-dest, which links a file of the same size: link.txt holds only the same bytes),
# then everything else, as a copy (no -c: nothing of the live release is read)
sum_copy() {
  local how=$1; shift
  if [[ $how == manifest ]]; then
    # (into a directory made first: a list of one top-level file would otherwise name the
    # release itself as that file, and rsync refuses it)
    mkdir -m 700 "$rel" &&
      timeout 3600 rsync -rltHD --modify-window=2000000000 "$@" --files-from="$W/link.txt" "$D/incoming/" "$rel/" &&
      timeout 3600 rsync -rltHD --ignore-existing "$D/incoming/" "$rel"
  else
    timeout 3600 rsync -rltHD -c --modify-window=2000000000 "$@" "$D/incoming/" "$rel"
  fi && find "$rel" -type f -printf '%P\t%s\t%T@\n' > "$W/copied"
}
# sum_write (last in import_release): the manifest of this release: the upload's hashes, for the
# files whose size and mtime are still those of the copy (the release's own inode and mtime)
sum_write() {
  local f=$D/sums/$id
  find "$rel" -type f -printf '%P\t%s\t%T@\t%i\n' > "$W/final" || return 1
  { echo "$SUM_HEAD"
    awk -F '\t' 'FILENAME == ARGV[1] { c[$1] = $2 "\t" $3; next } FILENAME == ARGV[2] { if (c[$1] == $2 "\t" $3) f[$1] = $4 "\t" $3; next }
      ($1 in f) { split(f[$1], r, "\t"); if (c[$1] == $2 "\t" r[2]) print $3 "\t" $2 "\t" r[1] "\t" r[2] "\t" $4 "\t" $5 "\t" $1 }' \
      "$W/copied" "$W/final" "$W/up.tsv"; } > "$W/sum" || return 1
  { cat "$W/sum"; echo "end $(sha256sum < "$W/sum" | cut -d' ' -f1)"; } > "$f.tmp" && chmod 600 "$f.tmp" &&
    sync "$f.tmp" && fp imp.sum_mv && mv -f "$f.tmp" "$f" && rm -rf "$W"
}

# release_own rel group: what `chown -RhP root:group rel && chmod -R a-st,u=rwX,g=rX,o= rel` makes
# (root, the group; directories and files with an execute bit 750, other files 640; a symbolic
# link's own owner, never its mode), changing only what is not so already. A file shared with the
# live release is left untouched (unshare_release kept only those that are so): no write to every
# inode of both releases on each deploy, which a slow disk pays for in its journal
release_own() {
  local rel=$1 group=$2
  find "$rel" \( ! -user root -o ! -group "$group" \) -exec chown -hP "root:$group" {} + &&
    find "$rel" ! -type l \( \( \( -type d -o -perm /111 \) ! -perm 750 \) -o \( ! -type d ! -perm /111 ! -perm 640 \) \) \
      -exec chmod a-st,u=rwX,g=rX,o= {} +
}

# unshare_release rel group: copy (a new file under the same name) every file the release shares
# with another one unless root owns it with the release's group and mode 640 or 750 (what chown
# and chmod in import_release make, so they leave it unchanged), and every shared file in a
# directory that is written, made readable to others or served by Caddy after the import
# (writable, public_dirs, assets: make_writable, open_public, assets_link change files there)
unshare_release() {
  local rel=$1 group=$2 d f t dirs=() x=()
  local w=${C[writable]:-} pd=${C[public_dirs]:-}
  read -ra dirs <<< "${w//,/ } ${pd//,/ }"
  while IFS=$'\t' read -r d _; do [[ -n $d ]] && dirs+=("$d"); done < <(assets_spec "$rel")
  for d in ${dirs[@]+"${dirs[@]}"}; do
    d=${d%/}
    # (a name find could read as a pattern: every shared file is copied)
    [[ $d =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ ]] || { x=(-o -true); break; }
    x+=(-o -path "$rel/$d/*")
  done
  while IFS= read -r -d '' f; do
    t=$(mktemp "${f%/*}/.tando-copy.XXXXXX") && cp -a --remove-destination "$f" "$t" && mv -f "$t" "$f" || return 1
  done < <(find "$rel" ! -type d -links +1 \( ! -user root -o ! -group "$group" -o ! \( -perm 640 -o -perm 750 -o -type l \) ${x[@]+"${x[@]}"} \) -print0)
}

# container: load the uploaded image (or pull the named one) into root Podman's storage and tag
# it localhost/tando-<app>:<id>; the release directory only holds that name
import_image() {
  local ref img
  rm -rf "$rel"; install -d -m 750 -o root -g "tando-$A" "$rel"
  # an image upload holds plain files only: a symbolic link could make root read another file
  if [[ -n $(find "$D/incoming" -type l -print -quit) ]]; then
    free_lease; fail "the image upload holds a symbolic link"
  fi
  if [[ -e $D/incoming/image-ref || -L $D/incoming/image-ref ]]; then
    [[ -f $D/incoming/image-ref && ! -L $D/incoming/image-ref ]] || { free_lease; fail "image-ref is not a plain file"; }
    ref=$(head -c 256 "$D/incoming/image-ref" | head -1)
    free_lease
    [[ $ref =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ ]] || fail "bad image reference in image-ref"
    # the reference came from the upload: it is never echoed back in a message
    timeout 1800 podman pull -q "$ref" > /dev/null 2> "$D/activation.log" || fail "podman pull of the image in image-ref failed (or took over 30 minutes)"
    img=$ref
  else
    local before
    before=$(upload_sum)
    img=$(tar -C "$D/incoming" -cf - . | timeout 1800 podman load 2> "$D/activation.log" | sed -n 's/^Loaded image: //p' | tail -1)
    [[ $before == "$(upload_sum)" ]] || fail "the upload changed while it was loaded"
    chmod go-rwx "$D/incoming"
    free_lease
    [[ -n $img ]] || fail "podman load failed"
  fi
  podman tag "$img" "localhost/tando-$A:$id" || fail "podman tag failed"
  [[ -z ${ref:-} ]] && podman untag "$img" "$img" 2> /dev/null   # drop the laptop's build name
  [[ -n ${C[data]:-} ]] && ensure_shared data
  echo "localhost/tando-$A:$id" > "$rel/IMAGE"
  chown root:"tando-$A" "$rel/IMAGE"; chmod 640 "$rel/IMAGE"
}

# python: a virtualenv per release, built on the server (wheels are platform-specific) as the app
# user in a transient unit with bounded memory and CPU; then made read-only like the release.
# pip's cache is the unit's private /tmp: a wheel the app planted in shared/.cache would be
# installed into every later release
build_venv() {
  local req=$rel/requirements.txt unit="tando-$A-venv-$id" cmd out runtime cpu mem
  [[ -f $req ]] || return 0
  install -d -o "tando-$A" -g "tando-$A" "$rel/.venv"     # in the fresh root-owned release
  ensure_shared .cache
  if command -v uv > /dev/null; then
    cmd="uv venv --quiet $rel/.venv && uv pip install --quiet --python $rel/.venv/bin/python -r $req"
  else
    cmd="python3 -m venv $rel/.venv && $rel/.venv/bin/pip install --quiet --disable-pip-version-check -r $req"
  fi
  local args=() x tc=/tmp/.cache   # lint: allow RL06 the unit's own PrivateTmp, no other user can reach it
  while IFS= read -r x; do
    case $x in MemoryMax=*|ReadWritePaths=*|EnvironmentFile=*|Environment=*) continue;; esac
    args+=(-p "$x")
  done < <(props - build)
  out=$(systemd-run --wait --collect --unit="$unit" "${args[@]}" -p "MemoryMax=${C[build_memory]:-512M}" \
    -p CPUQuota=100% -p "ReadWritePaths=$rel/.venv $D/shared" -p RuntimeMaxSec=1800 \
    -p "WorkingDirectory=$rel" -E "HOME=$D/home" -E "XDG_CACHE_HOME=$tc" -E PYTHONNOUSERSITE=1 \
    -E NPM_CONFIG_USERCONFIG=/dev/null -E GIT_CONFIG_GLOBAL=/dev/null \
    /bin/sh -c "$cmd" 2>&1)
  if [[ $out != *"Finished with result: success"* ]]; then
    app_journal -u "$unit" -n 60 --no-pager -o cat > "$D/activation.log" 2>&1
    fail "building the virtualenv failed"
  fi
  runtime=$(sed -n 's/.*Service runtime: \(.*\)/\1/p' <<< "$out")
  cpu=$(sed -n 's/.*CPU time consumed: \(.*\)/\1/p' <<< "$out")
  mem=$(sed -n 's/.*Memory peak: \([^ ,]*\).*/\1/p' <<< "$out")
  pg venv "${runtime:-?} wall, ${cpu:-?} CPU, ${mem:-?} peak memory"
  chown -RhP "root:tando-$A" "$rel/.venv" && chmod -R u=rwX,g=rX,o= "$rel/.venv" || fail "chown failed"
}

# static: no process to pre-flight; the health path must exist as a file in the release
preflight_static() {
  has_unit && return 0
  local f=$rel/${C[health]#/}
  [[ -d $f ]] && f=$f/index.html
  [[ -f $f ]] || fail "pre-flight: ${C[health]:-/} is not a file in the release"
}

# recover: finish or revert an interrupted operation (a deploy, a rollback, an env change, a
# stop or start), finish what a crash cut short after an operation's end, give up reservations no
# activation will run, and bring what serves in line with the state. Run by every mutating verb
# first, by an activation's ExecStopPost, at boot (recover-all) and by tando-watch. When another
# verb holds the app's lock it is skipped (after a short wait): that verb runs recover_locked
# itself once it has the lock (lock), so an interrupted phase is never inherited unfinished.
recover() {
  rec_upload    # (the lease lock only: also while an activation holds the app's lock)
  lockfile "$D/lock"; exec 9>"$D/lock"; flock -w 3 9 || return 0
  recover_locked
  flock -u 9
}
recover_locked() {
  local FPC=rec
  lock_mark recover
  fp enter
  load "$D/state" S; load "$D/activation" P
  local ph=${S[phase]:-idle} id=${S[target]:-} l
  case $ph in
    idle) ;;
    copy|preflight|release)
      # (release: the command is stopped where it was; what it had changed in the data stays)
      fp pre_stop && systemctl stop "tando-$A-pre-$id" "tando-$A-rel-$id" "tando-$A-venv-$id" 2> /dev/null
      systemctl reset-failed "tando-$A-rel-$id" "tando-$A-venv-$id" 2> /dev/null
      S[status_$id]=bad
      start_back "${S[current]:-}"
      db_follow     # (the release command ran under this release's database limits)
      rec_lease "$id"
      end_op "$id" deploy failed "interrupted during $ph";;
    switch|verify|soak|rollback)
      # once a switch began, the link is the truth: the state's current may be one write behind
      l=$(cur_link)
      [[ -n $l && -d $D/releases/$l ]] && S[current]=$l
      if [[ $l == "$id" && -z ${S[reverting]:-} ]]; then
        st current "$l"
        runs_release "$id" || { fp finish && restart_app; } || true
        finish "${S[kind]:-deploy}" "recovered after interruption"
      elif [[ -z ${S[reverting]:-} ]]; then   # the link never moved: the target never went live
        revert "${S[kind]:-deploy}" "interrupted before the switch" "interrupted before the switch" 0 failed
      else
        revert "${S[kind]:-deploy}" "interrupted" "interrupted"
      fi;;
    env)  # (no env.prev: it ended before the new env was written; nothing changed)
      if [[ -f $D/env.next || -f $D/env.prev ]]; then env_finish > /dev/null
      else rm -f "$D/.env.check"; st phase idle env_revert ""; fi;;
    stop) S[stopped]=1; stop_app || [[ -n ${S[hold]:-} ]] || unset "S[stopped]"; st phase idle;;
    start|restart) restart_app && workers_follow all; st phase idle;;
    restore) rs_end "cut off";;     # (the app runs its release again, or stays stopped; a half step is recorded)
    destroy) destroy_finish; return 0;;   # (the user asked for it: finished, never undone)
    *) st phase idle;;
  esac
  # (still in a phase: going back did not work yet; the next recover tries again)
  [[ ${S[phase]:-idle} == idle ]] || return 0
  rec_idle
}
# rec_lease id: the upload lease of that release goes with it
rec_lease() {
  lockfile "$D/lease.lock"; exec 7>"$D/lease.lock"; flock -w 30 7 || return 0
  load "$D/upload" L
  [[ -n $1 && ${L[id]:-} == "$1" ]] && rm -f "$D/upload"
  flock -u 7
}
# rec_idle: no operation runs (this holds the lock): everything agrees with the state
rec_idle() {
  local l cur=${S[current]:-} f i
  l=$(cur_link)
  if [[ -n $cur && -d $D/releases/$cur && $l != "$cur" ]]; then
    fp switch && switch_to "$cur"
  elif [[ -z $cur && -n $l && -d $D/releases/$l ]]; then
    st current "$l" "status_$l" verified      # it was serving: the state says so again
    [[ -n ${S[last_good]:-} ]] || st last_good "$l"
  fi
  # an operation that ended (or died) without its result written
  if [[ ${P[result]:-} == running ]] && valid_id "${P[id]:-}"; then
    local oid osince
    read -r oid _ _ osince <<< "${S[outcome]:-}"
    if [[ $oid == "${P[id]}" && $osince == "${P[started]:-0}" ]]; then op_trailer
    elif [[ ${P[kind]:-deploy} == rollback || -n ${S[status_${P[id]}]:-} ]]; then
      # (a rollback cut before its first state write; or an activation from before outcomes)
      local r=failed; [[ ${S[status_${P[id]}]:-} == verified && $cur == "${P[id]}" ]] && r=ok
      end_op "${P[id]}" "${P[kind]:-deploy}" "$r" "interrupted"
    fi
  fi
  [[ -n ${S[outcome]:-} && ${S[outcome]} != "${S[outcome_done]:-}" ]] && op_trailer
  rec_reap
  bk_tmp_clean      # (a backup cut off: its temp directory)
  # what an operation that died leaves: its helper units (none of this app runs while this holds
  # the lock), half-written files
  local units=()
  while IFS= read -r i; do [[ -n $i ]] && units+=("$i"); done < <(systemctl list-units --all --plain --no-legend \
    "tando-$A-pre-*" "tando-$A-rel-*" "tando-$A-venv-*" "tando-$A-envcheck-*" 2> /dev/null | awk '{ print $1 }' |
    grep -E "^tando-$A-(pre|rel|venv|envcheck)-[0-9]")
  if ((${#units[@]})); then systemctl stop "${units[@]}" 2> /dev/null; systemctl reset-failed "${units[@]}" 2> /dev/null; fi
  rm -f "$D/.env.check" "$D/env.prev" "$D/env.next" "$D/env.entry" "$D/current.tmp" "$D/copy.err" "$D"/.env.?????? "$D"/.envlog.?????? "$D"/jobs/*.tmp "$D"/start/*.tmp
  for f in "$D"/state.tmp.* "$D"/app.conf.tmp.* "$D"/activation.tmp.*; do
    [[ -e $f && ! -d /proc/${f##*.} ]] && rm -f "$f"
  done
  rec_service
}
# rec_reap: a reserved release (a directory with no status) whose activation unit is gone was
# never activated (activate cut off, the unit killed or the server restarted while it was queued):
# it is given up, so it is never reported queued, kept, or offered for a rollback
rec_reap() {
  local r i
  for r in "$D"/releases/*; do
    i=${r##*/}
    valid_id "$i" && [[ -d $r && -z ${S[status_$i]:-} && $i != "${S[current]:-}" ]] || continue
    # activate holds the lease lock from the reservation until its unit started
    lockfile "$D/lease.lock"; exec 7>"$D/lease.lock"; flock -w 30 7 || continue
    case $(systemctl show -P ActiveState "tando-$A-act-$i" 2> /dev/null) in
      active|activating|deactivating|reloading) flock -u 7; continue;;
    esac
    load "$D/upload" L
    local why="interrupted before it started (activate was cut off, or its server restarted while it was queued)"
    [[ ${L[id]:-} == "$i" && -n ${L[why]:-} ]] && why=${L[why]}
    [[ ${L[id]:-} == "$i" ]] && rm -f "$D/upload"
    flock -u 7
    S[status_$i]=bad
    EO_SINCE=$(now) end_op "$i" deploy failed "$why"
  done
}
# rec_service: the app runs, is stopped or shows its down page as the state says
rec_service() {
  [[ -n ${S[current]:-} ]] || { unit_boot; return 0; }
  if ! has_unit; then write_caddy; return 0; fi
  # an adopted app whose unit is not enabled: adopt undo is giving it back (it disables tando's
  # unit first, under adopt's own lock) or did; nothing here may start it again
  [[ -n ${C[adopted_from]:-} ]] && ! systemctl -q is-enabled "tando-$A" 2> /dev/null && return 0
  local as; as=$(systemctl show -P ActiveState "tando-$A" 2> /dev/null)
  if [[ -n ${S[stopped]:-} ]]; then
    if [[ $as =~ ^(active|activating|reloading)$ ]] || systemctl -q is-enabled "tando-$A" 2> /dev/null ||
       { idle_app && systemctl -q is-enabled "tando-${A}_wake.socket" 2> /dev/null; }; then stop_app
    else write_caddy; fi
  elif [[ -n ${S[down]:-} ]]; then
    if [[ $as == active ]] && own_listener "${C[port]}" "tando-$A.service"; then
      # it runs on its port again (it was started at boot, say): the down page goes
      unset "S[down]"; save "$D/state" S && write_caddy
    elif ! ss -Hltn "sport = :${C[port]}" | grepq .; then
      # an app systemd gave up on (down) gets another start once its port is free (tando-watch
      # runs recover-all every minute): a stray process that held it may be gone
      restart_app || true
    fi
  else
    case $as in
      failed) S[down]=1; save "$D/state" S; write_caddy;;    # systemd gave up; app-down did not get to it
      # an idle app (idle_stop) waits for its next request: its socket listens, Caddy proxies to it
      # (a socket that failed, after starts that failed again and again, is started again)
      inactive) if idle_app; then systemctl reset-failed "tando-$A" "tando-${A}_wake.socket" 2> /dev/null
                  systemctl start "tando-${A}_wake.socket"; write_caddy
                else restart_app || true; fi;;                # a start or restart cut short
      *) write_caddy
         systemctl -q is-enabled "tando-$A" 2> /dev/null || systemctl enable -q "tando-$A";;
    esac
  fi
  workers_follow || echo "tando-agent: $WF_WHY" >&2
  return 0
}
# journalctl option for the app's namespace (plus the main journal), once it has one
jns() { [[ -f /etc/systemd/journald@tando-$A.conf ]] && echo "--namespace=+tando-$A"; }
app_journal() { local j; j=$(jns); journalctl ${j:+"$j"} "$@"; }

cmd_recover() {
  need_root
  # run by an activation's ExecStopPost: not while the machine shuts down (that is the boot's
  # recover-all's job, with Caddy and the app up again)
  [[ $(systemctl is-system-running 2> /dev/null) == stopping ]] && { echo "phase=shutdown"; return 0; }
  app "$1"; recover; echo "phase=${S[phase]:-idle}"
}
cmd_recover_all() {
  need_root
  local f
  for f in "$R"/apps/*/app.conf; do
    [[ -f $f ]] || continue
    f=${f%/app.conf}
    ( app "${f##*/}"; recover ) || true
  done
  # what a destroy cut off after its directory's rename left (destroy_finish)
  for f in "$R"/apps/.gone-*; do [[ -d $f && ! -L $f && ! -d /proc/${f##*.} ]] && rm -rf "$f"; done
  return 0
}

# rollback <app> [id]: to the given release, or the newest verified one older than current.
# Not affected by the upload lease.
cmd_rollback() {
  need_root; app "$1"; recover; lock 120
  load "$D/state" S
  held_refuse
  local cur=${S[current]:-} to=${2:-} i t
  if [[ -n $to ]]; then
    valid_id "$to" && [[ -d $D/releases/$to ]] || die "no such release: $to"
    # (a reservation, or a release whose deploy never ended, was never live: not a way back)
    [[ -n ${S[status_$to]:-} ]] || die "release $to never finished its deploy: it cannot be rolled back to"
  else
    local seen=0
    for i in $(releases_by_seq | tac); do
      [[ $i == "$cur" ]] && { seen=1; continue; }
      if ((seen)) && [[ ${S[status_$i]:-} == verified ]]; then to=$i; break; fi
    done
    [[ -n $to ]] || die "no earlier verified release to roll back to"
  fi
  [[ $to != "$cur" ]] || die "$to is already current"
  P=([id]=$to [kind]=rollback [phase]=switch [result]=running [started]=$(now) [started_ds]=$(ds)); pg
  # how each of the two starts and is checked: app.conf describes the current release now; the
  # target's own lines come back from its snapshot (a newer health path would fail the older code)
  [[ -n $cur && ! -f $D/start/$cur ]] && valid_id "$cur" && start_snap "$cur"
  # a stopped app, as a deploy to it: the rollback starts its target; when that fails, the app
  # goes back to its release, stopped (pre_stopped: revert)
  st phase rollback target "$to" kind rollback prev "$cur" fallback "$cur" pre_stopped "${S[stopped]:-}" reverting ""
  AUDIT_NOTE="from ${cur:--} to $to"
  start_back "$to" && conf_put || { start_back "$cur"; conf_put; end_op "$to" rollback failed "could not apply the settings of $to"; die "could not apply the settings of $to (disk full?)"; }
  t=$(ds)
  if ! { fp rb.switch && switch_to "$to"; }; then
    if ((SW_MOVED)); then
      PROBE_WHY="$to could not be started (${WC_WHY:-systemctl restart failed})"
      pg t_switch "$(el "$t")"
      revert rollback "$PROBE_WHY" || die "could not switch to $to ($PROBE_WHY); going back to $cur did not work yet: recovery retries it (tando status)"
      die "could not switch to $to ($PROBE_WHY); back on $cur"
    fi
    start_back "$cur"; conf_put
    end_op "$to" rollback failed "could not switch to $to"
    die "could not switch to $to"
  fi
  pg t_switch "$(el "$t")"
  st phase verify
  if ! finish rollback "from $cur"; then
    [[ ${S[phase]:-idle} == idle ]] || die "rollback health check failed ($PROBE_WHY); going back to $cur did not work yet: recovery retries it (tando status)"
    die "rollback health check failed ($PROBE_WHY); back on $cur"
  fi
  echo "current=$to"; echo "from=$cur"; echo "link=$(link)"
}

cmd_deploy_status() { # app id
  app "$1"; valid_id "${2:-}" || die "bad id"
  local k l
  load "$D/activation" P
  # the activation unit died without finishing (killed, out of memory): recover it now
  if [[ ${P[id]:-} == "$2" && ${P[result]:-} == running && $EUID == 0 ]] &&
     [[ ! $(systemctl show -P ActiveState "tando-$A-act-$2") =~ ^(active|activating|deactivating)$ ]]; then
    recover; load "$D/state" S; load "$D/activation" P
  fi
  # reserved but its activation unit is gone: recover gives it up (never "queued" for ever)
  if [[ ${P[id]:-} != "$2" && -z ${S[status_$2]:-} && -d $D/releases/$2 && $EUID == 0 ]] &&
     [[ ! $(systemctl show -P ActiveState "tando-$A-act-$2") =~ ^(active|activating|deactivating)$ ]]; then
    recover; load "$D/state" S; load "$D/activation" P
  fi
  if [[ ${P[id]:-} != "$2" ]]; then   # a later rollback or deploy overwrote it: history has the end
    local h; h=$(awk -F '\t' -v id="$2" '$2 == id { r = $4 } END { print r }' "$D/history.tsv" 2> /dev/null)
    if [[ -n $h ]]; then echo "phase=done"; echo "result=${h/ok/verified}"; echo "link=$(link)"; return; fi
  fi
  if [[ ${P[id]:-} == "$2" ]]; then
    for k in "${!P[@]}"; do printf '%s=%s\n' "$k" "${P[$k]}"; done
    echo "link=$(link)"
    if [[ ${P[result]} == failed || ${P[result]} == rolledback ]] &&
       [[ -s $D/activation.log && -r $D/activation.log ]]; then
      local SAN
      while IFS= read -r l; do san_v "$l"; echo "log=$SAN"; done < "$D/activation.log"
    fi
  elif [[ -d $D/releases/$2 && -z ${S[status_$2]:-} ]]; then
    echo "phase=queued"; echo "result=running"
    # what it waits for (read from state and progress, no lock: a deploy key reads this too)
    if [[ ${S[phase]:-idle} != idle && ${S[target]:-} != "$2" ]]; then
      local wph=${S[phase]}
      [[ ${P[id]:-} == "${S[target]:-}" && -n ${P[phase]:-} ]] && wph=${P[phase]}
      [[ ${S[kind]:-} == rollback ]] && wph=rollback
      echo "waiting_for=${S[target]:-}"; echo "waiting_phase=$wph"
      [[ $wph == soak && ${P[soak_end]:-} =~ ^[0-9]+$ ]] && echo "waiting_left=$(( P[soak_end] > $(now) ? P[soak_end] - $(now) : 0 ))"
    fi
  else
    echo "phase=done"; echo "result=${S[status_$2]:-unknown}"
  fi
}

# ---- writable directories: per release, seeded from the shipped content -------------------

# Files a hand-written Caddy site serves from disk (public_dirs, set by adopt) are world-readable,
# like any web root; the directories above them only traversable (R1).
open_public() { # release dir
  local rel=$1 d p seg parts=()
  [[ -n ${C[public_dirs]:-} ]] || return 0
  chmod o+x "$rel"
  read -ra parts <<< "${C[public_dirs]//,/ }"
  for d in "${parts[@]}"; do
    [[ $d =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ && /$d/ != */../* && -d $rel/$d && ! -L $rel/$d ]] || continue
    p=$rel
    for seg in ${d//\// }; do p+=/$seg; chmod o+x "$p"; done
    chmod -R o+rX "$rel/$d"
  done
}

# Make the listed directories of a release (root-owned copy) writable by the app user. Nothing
# is mounted: each release has its own copy (unshare_release), so writes never outlive the release.
make_writable() { # release dir
  local rel=$1 d parts=()
  [[ -n ${C[writable]:-} ]] || return 0
  read -ra parts <<< "${C[writable]//,/ }"
  for d in "${parts[@]}"; do
    [[ -L $rel/$d ]] && fail "writable directory $d is a symlink in the release"
    [[ -e $rel/$d && ! -d $rel/$d ]] && fail "writable path $d is not a directory"
    mkdir -p "$rel/$d"
    [[ $(readlink -f "$rel/$d") == "$rel/$d" ]] || fail "writable directory $d goes through a symlink"
    chown -RhP "$AU:$AU" "$rel/$d"
    chmod -R u+w "$rel/$d"
  done
}

# ---- backups: /var/backups/tando/<app>/<YYYYMMDD-HHMMSS>-<kind>/ ---------------------------
#
# Root never reads the app's files: tar and pg_dump run as the app user, in the app's slice (tar in
# its sandbox too: as_app_unit), and root only writes their output stream into its own 700 directory.

BK=/var/backups/tando

has_backup_data() { [[ -n ${C[data]:-} || -n ${C[data_dir]:-} || ${C[database]:-} == postgres ]]; }
# (adopt: the full backup `tando adopt` took before it changed anything; its data restores like
# any other, adopt undo needs its record, it is never pruned and never copied offsite)
valid_backup() { [[ $1 =~ ^[0-9]{8}-[0-9]{6}-(daily|predeploy|manual|safety|final|adopt)$ ]]; }
as_app() { (cd / && exec runuser -u "$AU" -- "$@"); }   # cwd / : root's cwd may be private
# as_app_unit [-p prop]... cmd...: the same, inside the app's sandbox (props backup) and its slice:
# it sees only what the app sees, so a symlink the app planted cannot make it read anything the app
# could not, and its memory counts in the app's limits (512 MB at most), never the host's
as_app_unit() {
  local args=() x wd=/
  while [[ ${1:-} == -p ]]; do [[ $2 == WorkingDirectory=* ]] && wd=${2#*=} || args+=(-p "$2"); shift 2; done
  while IFS= read -r x; do
    case $x in EnvironmentFile=*|Environment=*|MemoryMax=*|LogNamespace=*) continue;; esac
    args+=(-p "$x")
  done < <(props - backup)
  systemd-run --quiet --pipe --wait --collect --unit="tando-$A-backup-$$-$RANDOM" "${args[@]}" \
    -p "WorkingDirectory=$wd" -p MemoryMax=512M "$@"
}
# as_app_pg cmd...: a PostgreSQL client (pg_dump, pg_restore) as the app user, in a scope of the
# app's slice: its memory counts in the app's limits (512 MB at most), OOMScoreAdjust 500 like the
# app's units, never the host's. A scope, not a sandboxed unit: it costs 8 ms, not 60 (measured);
# the password stays in the process's environment (its uid's and root's), never on a command line
as_app_pg() {
  (cd / && export PGPASSWORD=$DB_PW && { [[ -z ${DB_SSL:-} ]] || export PGSSLMODE=$DB_SSL PGSSLROOTCERT=$DB_CA; } && exec systemd-run --quiet --scope --collect --unit="tando-$A-pg-$$-$RANDOM" \
    -p "Slice=$(app_slice)" -p MemoryMax=512M choom -n 500 -- runuser -u "$AU" -- "$@")
}

# bk_tmp_clean: the temp directories of backups of the app that were cut off (a kill, a reboot, an
# ssh session that dropped) go. The caller holds the app's lock: every backup is taken under it
# (and a process a cut-off backup left writing, its tar or pg_dump, keeps it), so no temp
# directory there belongs to a backup still being written.
bk_tmp_clean() {
  local t
  for t in "$BK/$A"/.*.tmp; do
    [[ -d $t && ! -L $t && ${t##*/} =~ ^\.[0-9]{8}-[0-9]{6}-[a-z]+\.tmp$ ]] && rm -rf "$t"
  done
  return 0
}
backup_take() { # kind -> prints the backup id (and sets BK_ID); the caller holds the app's lock
  local kind=$1 id dir tmp n=0 snap=() live=$ADATA/app.sqlite
  BK_WARN="" BK_ID=""
  install -d -m 700 -o root -g root "$BK" "$BK/$A"
  bk_tmp_clean
  id="$(date -u +%Y%m%d-%H%M%S)-$kind"
  while [[ -e $BK/$A/$id ]]; do sleep 1; id="$(date -u +%Y%m%d-%H%M%S)-$kind"; n=$((n + 1)); ((n < 5)) || return 1; done
  dir=$BK/$A/$id tmp=$BK/$A/.$id.tmp
  rm -rf "$tmp"; mkdir -m 700 "$tmp"
  if [[ -n ${C[data]:-} && -z ${C[data_dir]:-} ]] && ! shared_ok data; then
    rm -rf "$tmp"; echo "shared/data is not a directory of $AU (a symbolic link?): no backup taken" >&2; return 1
  fi
  if [[ ( -n ${C[data]:-} || -n ${C[data_dir]:-} ) && -d $ADATA ]]; then
    # sqlite: a consistent snapshot through sqlite3 when the binary exists; otherwise the live
    # file is archived as is (a write during the archive can leave it inconsistent)
    if [[ ${C[database]:-} == sqlite && -f $live ]] && command -v sqlite3 > /dev/null &&
       as_app_unit -p "WorkingDirectory=$ADATA" sqlite3 app.sqlite ".backup app.sqlite.snapshot" < /dev/null; then
      snap=(--exclude=./app.sqlite --transform 's,^\./app\.sqlite\.snapshot$,./app.sqlite,')
    fi
    # A file the app made unreadable (or deleted mid-way) is a warning in the backup's meta, not a
    # failure: else a compromised app blocks every deploy (the pre-deploy backup must succeed).
    # tar 1 = some files changed or vanished; 2 = a real error. The archive is written by root
    # (cat), so the file system's root reserve still takes it when an app has filled the disk
    local trc wrc
    as_app_unit tar -C "$ADATA" --ignore-failed-read --warning=no-file-changed "${snap[@]}" -czf - . \
      < /dev/null 2> "$tmp/tar.err" | cat > "$tmp/data.tar.gz"
    trc=${PIPESTATUS[0]} wrc=${PIPESTATUS[1]}
    if ((trc > 1 || wrc != 0)); then
      echo "data archive failed: $(head -c 300 "$tmp/tar.err" | tr -c '[:print:]' ' ')" >&2; rm -rf "$tmp"; return 1
    fi
    if [[ -s $tmp/tar.err ]]; then
      BK_WARN="$(grep -c . "$tmp/tar.err") files not readable or changed while read, first: $(head -1 "$tmp/tar.err" | head -c 200 | tr -c '[:print:]' ' ')"
      echo "tando-agent: backup of $A: $BK_WARN" >&2
    fi
    rm -f "$tmp/tar.err"
    ((${#snap[@]})) && as_app_unit rm -f "$live.snapshot" < /dev/null
  fi
  if [[ ${C[database]:-} == postgres ]]; then
    db_creds
    if ! as_app_pg timeout 3600 pg_dump -Fc -h "$DB_HOST" -p "$DB_PORT" -U "$DB_ROLE" -d "$DB_ROLE" < /dev/null > "$tmp/db.dump"; then
      rm -rf "$tmp"; echo "pg_dump failed" >&2; return 1
    fi
  fi
  # seq: its place in the order backups were taken (backup_prune goes by it: a name is the wall
  # clock's, and a clock set back gives a new backup an older name)
  { printf 'kind=%s\ncreated=%s\nseq=%s\n' "$kind" "$(now)" "$(bk_seq)" && { [[ -z ${BK_WARN:-} ]] || printf 'warning=%s\n' "$BK_WARN"; }; } > "$tmp/meta" &&
    sync -f "$tmp/meta" && mv "$tmp" "$dir" || { rm -rf "$tmp"; echo "could not write the backup (disk full?)" >&2; return 1; }
  st last_backup "$(now)"
  backup_prune "$id"
  offsite_kick "$id"
  BK_ID=$id
  echo "$id"
}

# offsite copy (docs/BACKUP.md): tando-offsite uploads the new backup in a unit of its own, so a
# slow upload never holds a deploy (the pre-deploy backup included); tando-offsite.timer retries
# what did not get there. Nothing when offsite is off.
offsite_kick() {
  [[ -f $R/offsite.conf && -x $R/bin/tando-offsite ]] || return 0
  systemd-run --quiet --no-block --collect --unit="tando-offsite-$A-$1" -p Nice=10 -p IOSchedulingClass=idle \
    "$R/bin/tando-offsite" push "$A" "$1" > /dev/null 2>&1 || true
}
# offsite_fetch id: a backup that is only in the bucket comes back to $BK/$A/<id> first (verified)
offsite_fetch() {
  [[ -d $BK/$A/$1 || ! -f $R/offsite.conf || ! -x $R/bin/tando-offsite ]] && return 0
  echo "tando-agent: $1 is not on this server: fetching it from offsite storage" >&2
  "$R/bin/tando-offsite" fetch "$A" "$1" > /dev/null || die "could not fetch backup $1 from offsite storage"
}

# keep the newest 7 daily backups plus the newest of each of the 4 weeks before them,
# the newest 5 of each other kind, and every final backup
backup_prune() { # [id just taken: never pruned, whatever its name says after a clock set back]
  local i kind week weeks=" " nweeks=0 ndaily=0 keep
  declare -A count
  # newest first by seq (meta), then by name (a backup from before seq: older than any with one)
  for i in $(bk_order); do
    valid_backup "$i" || continue
    # (a backup fetched from offsite storage stays a day: it is fetched to be restored)
    [[ -f $BK/$A/$i/fetched && -n $(find "$BK/$A/$i/fetched" -mmin -1440 2> /dev/null) ]] && continue
    kind=${i#*-*-} keep=0
    case $kind in
      final|adopt) keep=1;;
      daily)
        ndaily=$((ndaily + 1))
        if ((ndaily <= 7)); then keep=1
        else
          week=$(date -d "${i:0:8}" +%G-%V)
          if [[ $weeks != *" $week "* ]] && ((nweeks < 4)); then weeks+="$week "; nweeks=$((nweeks + 1)); keep=1; fi
        fi;;
      *) count[$kind]=$(( ${count[$kind]:-0} + 1 )); (( count[$kind] <= 5 )) && keep=1;;
    esac
    [[ $i == "${1:-}" ]] && keep=1
    ((keep)) || rm -rf "${BK:?}/$A/$i"
  done
}

# bk_seq: the next backup's seq (one more than the highest of the app's backups)
bk_seq() {
  local f v m=0
  for f in "$BK/$A"/*/meta; do
    v=$(sed -n 's/^seq=//p' "$f" 2> /dev/null | head -1)
    [[ $v =~ ^[0-9]{1,9}$ ]] && ((10#$v > m)) && m=$((10#$v))
  done
  echo $((m + 1))
}
# bk_order: the app's backup ids, newest first (by seq, then by name)
bk_order() {
  local d i v
  for d in "$BK/$A"/*; do
    i=${d##*/}; v=$(sed -n 's/^seq=//p' "$d/meta" 2> /dev/null | head -1)
    [[ $v =~ ^[0-9]{1,9}$ ]] || v=0
    printf '%s %s\n' "$((10#$v))" "$i"
  done | sort -k1,1nr -k2,2r | cut -d' ' -f2
}
cmd_backup_run() { # app kind: the timer (daily), `tando backup now` (manual)
  need_root; app "$1"
  local kind=${2:-manual} id
  [[ $kind == daily || $kind == manual ]] || die "bad backup kind"
  has_backup_data || die "$A has no data or database to back up"
  lock 3600
  load "$D/state" S
  # (a held app's data stays as it is: no daily backup; one by hand is allowed)
  [[ $kind == daily && -n ${S[hold]:-} ]] && { echo "skipped=held"; return 0; }
  # (the daily run's outcome, for the backup ping of tando-watch: docs/MONITORING.md, "From
  # outside". backup_take runs in this shell, not $(...): a subshell does not keep the handler
  # that lets this verb outlive a dropped ssh session, and its first write would end the backup)
  if ! backup_take "$kind" > /dev/null; then
    [[ $kind == daily ]] && st backup_daily_failed "$(now)"
    die "backup failed"
  fi
  id=$BK_ID
  [[ $kind == daily ]] && st backup_daily_ok "$(now)" backup_daily_id "$id"
  echo "id=$id"
}

# backup ls/cat also work for an app that was destroyed (its final backup stays in $BK/<app>)
app_or_gone() {
  if [[ -f $R/apps/${1:-}/app.conf ]]; then app "$1"; return; fi
  valid_app "${1:-}" && [[ -d $BK/$1 ]] || die "no such app: ${1:-}"
  A=$1
}
cmd_backup_ls() {
  need_root; app_or_gone "$1"
  local i size created where
  # the last restore drill (tando backup drill): at, result, backup, files, tables, rows, seconds, why
  local -A DS=(); load "$R/apps/$A/state" DS
  [[ ${DS[drill_at]:-} =~ ^[0-9]+$ ]] && row drill "${DS[drill_at]}" "${DS[drill_result]:-fail}" "${DS[drill_id]:-}" \
    "${DS[drill_files]:-}" "${DS[drill_tables]:-}" "${DS[drill_rows]:-}" "${DS[drill_secs]:-}" "${DS[drill_why]:-}"
  [[ -d $BK/$A ]] || return 0
  for i in $(ls -1 "$BK/$A" | sort -r); do
    valid_backup "$i" || continue
    # (a backup pruned while this lists them is left out, not shown half)
    size=$(du -sb "$BK/$A/$i" 2> /dev/null | cut -f1)
    created=$(sed -n 's/^created=//p' "$BK/$A/$i/meta" 2> /dev/null)
    [[ -n $size && -n $created ]] || continue
    # 7th field, where it is: local, both (uploaded), or local+pending / local+failed / local+uploading
    where=local
    if [[ -f $R/offsite.conf ]]; then
      where=$(sed -n 's/^state=//p' "$BK/$A/$i/offsite" 2> /dev/null)
      case $where in uploaded) where=both;; "") where=local;; *) where=local+$where;; esac
    fi
    row backup "$i" "${i#*-*-}" "$created" "$size" \
      "$([[ -f $BK/$A/$i/data.tar.gz ]] && echo data)$([[ -f $BK/$A/$i/db.dump ]] && echo ' db')" "$where"
  done
  # the ones only in the bucket (rows "offsite <id> <kind> <created> <size> <local 1|0>")
  if [[ -f $R/offsite.conf && -x $R/bin/tando-offsite ]]; then
    local r k c z l err
    while IFS=$'\t' read -r r i k c z l; do
      [[ $r == offsite && $l == 0 ]] && valid_backup "$i" && row backup "$i" "$k" "$c" "$z" - offsite
    done < <("$R/bin/tando-offsite" ls "$A" 2> "$BK/.offsite-ls.err")
    err=$(head -c 300 "$BK/.offsite-ls.err" 2> /dev/null); rm -f "$BK/.offsite-ls.err"
    [[ -n $err ]] && row offsite-error "${err#tando-offsite: }"
  fi
  return 0
}

cmd_backup_cat() { # app id: the backup as an uncompressed tar on stdout (for `backup pull`)
  need_root; app_or_gone "$1"; valid_backup "${2:-}" && offsite_fetch "$2"
  valid_backup "${2:-}" && [[ -d $BK/$A/$2 ]] || die "no such backup: ${2:-}"
  audit_done 0
  exec tar -C "$BK/$A/$2" -cf - .
}

# restore: stop the app, keep a safety copy of the current data, restore, start, health-check.
# A recorded operation (phase restore; restore_step stop, data, db, start): a restore cut off by a
# kill or a reboot is ended by recover (rs_end): the app runs its release again, and a data
# directory or database that was cut off half restored is recorded (restore_cut) and reported by
# tando doctor (until a restore ends), with the backup to restore again and the safety backup.
cmd_backup_restore() {
  need_root; app "$1"
  local id=${2:-} dir safety=""
  valid_backup "$id" && offsite_fetch "$id"
  valid_backup "$id" && [[ -d $BK/$A/$id ]] || die "no such backup: $id"
  dir=$BK/$A/$id
  recover; lock 300
  load "$D/state" S
  held_refuse
  # on failure: start the app again and say where the data before the restore is
  rfail() { rs_end "$1"; die "$1 (the previous data is in backup $safety)"; }
  st phase restore restore_id "$id" restore_step stop restore_safety "" restore_cut "" \
    restore_cut_id "" restore_cut_safety "" restore_cut_what "" ||
    die "could not save the state (disk full?); nothing restored"
  # (its workers too: nothing of the app writes while its data is replaced)
  fp rs.stop
  systemctl stop "tando-$A" "tando-${A}_worker-*"
  # (in this shell, not $(...): it keeps the handler for a dropped ssh session)
  backup_take safety > /dev/null || { rs_end; die "could not take the safety backup; nothing restored"; }
  safety=$BK_ID
  echo "safety=$safety"
  st restore_safety "$safety" restore_step data
  fp rs.data
  if [[ -f $dir/data.tar.gz ]] && [[ -n ${C[data_dir]:-} ]]; then
    # an adopted app's own data directory: emptied and refilled as its user (its rights only)
    [[ -d $ADATA && ! -L $ADATA ]] || rfail "$ADATA is not a directory"
    as_app find "$ADATA" -mindepth 1 -delete || rfail "could not clear the data directory"
    as_app tar -C "$ADATA" --no-same-owner -xzf - < "$dir/data.tar.gz" || rfail "data restore failed"
  elif [[ -f $dir/data.tar.gz ]]; then
    # into a fresh directory the app user creates and fills, then swapped in by rename (which
    # moves a link rather than following it); root never writes into shared/ itself
    local new=$D/shared/.restore-$$ old=$D/shared/.replaced-$$
    [[ -e $D/shared/data || -L $D/shared/data ]] || as_app mkdir -m 750 "$D/shared/data"
    shared_ok data || rfail "shared/data is not a directory of $AU (a symbolic link?): nothing restored"
    as_app mkdir -m 750 "$new" || rfail "could not create a directory for the restore"
    if ! as_app tar -C "$new" --no-same-owner -xzf - < "$dir/data.tar.gz"; then
      as_app rm -rf "$new"; rfail "data restore failed"
    fi
    [[ -d $new && ! -L $new ]] || rfail "the restore directory was replaced"
    mv -T "$D/shared/data" "$old" && fp rs.swap && mv -T "$new" "$D/shared/data" || rfail "could not swap the data in"
    as_app rm -rf "$old"
  fi
  if [[ -f $dir/db.dump ]]; then
    db_creds
    # A restore builds every index again, and the sort of a large one goes through temporary
    # files: the role's temp_file_limit (only a superuser can change it) is lifted for the restore
    # and set again after it, also when it failed. The app is stopped, so nothing else uses the
    # lift. Should this agent die in between, recover sets the limits again (rs_end).
    # (statement_timeout and the idle timeout: pg_restore's own first statements set them to 0)
    local rrc
    st restore_step db restore_applied "${S[applied]:-}" applied ""
    # (on a data node the role's limits stay: only its superuser could lift them, and this node
    # never holds it; a restore that needs more temp space raises db_temp_limit first)
    db_remote || pgsql -c "ALTER ROLE $DB_ROLE SET temp_file_limit = -1" || rfail "could not prepare the database role for the restore"
    fp rs.db
    as_app_pg pg_restore --clean --if-exists --no-owner -h "$DB_HOST" -p "$DB_PORT" -U "$DB_ROLE" \
      -d "$DB_ROLE" < "$dir/db.dump"; rrc=$?
    { db_remote || db_limits "$DB_ROLE"; } && st applied "${S[restore_applied]:-}"
    ((rrc == 0)) || rfail "database restore failed"
  fi
  st restore_step start
  fp rs.start
  rs_end
  [[ -n ${S[current]:-} ]] || { echo healthy=1; return; }
  [[ -z ${S[stopped]:-} ]] || { echo stopped=1; echo healthy=1; return; }
  if via_caddy "$(app_unit)"; then echo healthy=1; else echo healthy=0; fi
}
# rs_end [why]: a restore ends (done, failed, or cut off: recover): the app and its workers run
# again, the database role has its limits, and the phase is idle. A step cut off half way (the
# adopted data directory, the database) is recorded in restore_cut for tando doctor.
rs_end() {
  local step=${S[restore_step]:-} what="" why=${1:-} bid=${S[restore_id]:-?} o part
  case $step in
    data) [[ -n ${C[data_dir]:-} || -f $BK/$A/$bid/db.dump ]] && what="data directory and database";;
    db) what=database;;
  esac
  # a data swap cut between its two renames: the data from before goes back in place
  if [[ ! -e $D/shared/data && ! -L $D/shared/data ]]; then
    for o in "$D"/shared/.replaced-*; do [[ -d $o && ! -L $o ]] && mv -T "$o" "$D/shared/data" && break; done
  fi
  for o in "$D"/shared/.restore-* "$D"/shared/.replaced-*; do [[ -e $o || -L $o ]] && as_app rm -rf "$o"; done
  bk_tmp_clean      # (the safety backup's, when it was cut off)
  if [[ $step == db ]] && db_creds && { db_remote || db_limits "$DB_ROLE"; }; then S[applied]=${S[restore_applied]:-}; fi
  part=$what
  [[ -n $what ]] && what="the restore of backup $bid stopped while the $what was being replaced (${why:-cut off}), so it may be partly restored: tando backup restore $bid --yes runs it again; the data from before it is in backup ${S[restore_safety]:-(none: it was not taken)}"
  # (restore_cut_*: what tando status and ls show: the backup to restore again, the safety backup)
  if [[ -n $what ]]; then
    st phase idle restore_step "" restore_applied "" restore_cut "$what" restore_cut_id "$bid" \
      restore_cut_safety "${S[restore_safety]:-}" restore_cut_what "$part" restore_id "" restore_safety ""
  else
    st phase idle restore_step "" restore_applied "" restore_cut "" restore_id "" restore_safety ""
  fi
  # an app stopped on purpose (tando stop) stays stopped: its data is in place for tando start
  if [[ -n ${S[current]:-} && -n ${S[stopped]:-} ]]; then
    stop_app || echo "tando-agent: ${WC_WHY:-could not keep $A stopped}" >&2
  elif [[ -n ${S[current]:-} ]]; then
    restart_app
    workers_follow all || echo "tando-agent: $WF_WHY" >&2
  fi
  return 0
}

# sync_backup_timer: the app's daily backup unit, tando-<app>-backup.service (backup = daily), which
# the host's backup queue starts (tando-backups.timer, backup_all). The per-app timer of before
# (every app at midnight + up to 30 min) goes: host setup removes it from every app.
sync_backup_timer() {
  local f=/etc/systemd/system/tando-$A-backup ch=0
  if [[ -f $f.timer ]]; then
    systemctl disable -q --now "tando-$A-backup.timer" 2> /dev/null
    rm -f "$f.timer" "/var/lib/systemd/timers/stamp-tando-$A-backup.timer"; ch=1
  fi
  if [[ ${C[backup]:-off} == daily ]]; then
    WIC_CHANGED=0
    printf '[Unit]\nDescription=tando backup %s\n\n[Service]\nType=oneshot\nExecStart=%s backup-run %s daily\n' \
      "$A" "$AGENT" "$A" | write_if_changed "$f.service"
    ((WIC_CHANGED)) && ch=1
  elif [[ -f $f.service ]]; then
    rm -f "$f.service"; ch=1
  fi
  ((ch)) && dreload
  return 0
}

# ---- the backup queue: one host timer, the apps' daily backups one or two at a time ------------
# tando-backups.timer starts tando-backups.service (backup-all) at the start of backup_window
# (host.conf, default 01:00-05:00, the server's time). It starts the backup unit of every app with
# backup = daily, backup_jobs (1 or 2, default 1) at a time, in an order by a hash of the app's name
# (the same every night, different from the alphabet); none is started after the window's end
# (the doctor warns about a backup older than 2 days). An app backed up in the last 20 hours is
# skipped (the run made up after the server was off: Persistent).
BACKUP_WINDOW=01:00-05:00
backup_window() { # -> "HH:MM HH:MM" (start, end) from host.conf, else the default
  local w=${H[backup_window]:-$BACKUP_WINDOW}
  [[ $w =~ ^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || w=$BACKUP_WINDOW
  echo "${w%-*} ${w#*-}"
}
backup_order() { # app...: by a hash of the name (cksum), one per line
  local a
  for a; do printf '%s %s\n' "$(printf '%s' "$a" | cksum | cut -d' ' -f1)" "$a"; done | sort -n | cut -d' ' -f2
}
backup_sched_install() {
  local w; w=$(backup_window)
  WIC_CHANGED=0
  write_if_changed /etc/systemd/system/tando-backups.service <<EOF
[Unit]
Description=tando: the daily backups of every app, one queue

[Service]
Type=oneshot
ExecStart=$AGENT backup-all
EOF
  write_if_changed /etc/systemd/system/tando-backups.timer <<EOF
[Unit]
Description=tando: the daily backup window

[Timer]
OnCalendar=*-*-* ${w% *}:00
Persistent=true

[Install]
WantedBy=timers.target
EOF
  ((WIC_CHANGED)) && systemctl daemon-reload
  systemctl -q is-enabled tando-backups.timer 2> /dev/null && systemctl -q is-active tando-backups.timer ||
    systemctl enable -q --now tando-backups.timer
}
cmd_backup_all() {
  need_root
  load "$R/host.conf" H
  local w s e t0 endt f a k=${H[backup_jobs]:-1} apps=() n=0 late=0 last
  [[ $k =~ ^[1-4]$ ]] || k=1
  w=$(backup_window); s=${w% *}; e=${w#* }
  t0=$(now); endt=$(date -d "today $e" +%s)
  # a window over midnight (22:00-03:00), or a run made up after the window's end: until the end next comes
  ((endt > t0)) || endt=$((endt + 86400))
  for f in "$R"/apps/*/app.conf; do
    [[ -f $f ]] && grepq -x 'backup=daily' "$f" || continue
    a=${f%/app.conf}; a=${a##*/}
    last=$(sed -n 's/^backup_daily_ok=//p' "$R/apps/$a/state" 2> /dev/null)
    [[ $last =~ ^[0-9]+$ ]] && ((t0 - last < 72000)) && continue
    grepq '^hold=' "$R/apps/$a/state" 2> /dev/null && continue   # (held: cmd_hold)
    apps+=("$a")
  done
  for a in $(backup_order ${apps[@]+"${apps[@]}"}); do
    if (( $(now) >= endt )); then late=$((late + 1)); continue; fi
    while (( $(jobs -rp | wc -l) >= k )); do wait -n; done
    systemctl start "tando-$a-backup.service" &
    n=$((n + 1))
  done
  wait
  echo "started=$n"
  ((late == 0)) || echo "tando-agent: $late backup(s) not started: the backup window ($s-$e) ended first; widen it (tando host setup <host> backup_window=01:00-06:00) or set backup_jobs=2" >&2
  return 0
}

# ---- the restore drill: the latest backup of an app restored into a throwaway place -------------
# `tando backup drill`: backup-drill <app> [id] restores the newest backup (or the one given) into a
# directory and a database of its own on this server, checks them, drops them and records the
# result in the app's state (drill_at, drill_result ok|fail, drill_id, drill_why, drill_files,
# drill_tables, drill_rows, drill_secs). The live data and the live database are never touched.
# The host's monthly run (tando-drill.timer, backup_drill = monthly|off in host.conf) is
# backup-drill-all: after the backup queue, inside the same window, one app at a time.
# drill_dbname app: the throwaway database. Not tando_<...>: that is every app's own database
# (db_role), so no app (drill-foo has tando_drill_foo) can ever own this name. It is also marked
# (DRILL_MARK, a comment on it) and owned by the app's role: a database of this name that is not
# both is never dropped, the drill refuses instead
drill_dbname() { printf 'tdrill_%s' "${1//-/_}"; }
DRILL_MARK="tando restore drill"
# drill_db_state db role -> none | ours | foreign
drill_db_state() {
  local r
  r=$(pgsql -c "SELECT pg_catalog.pg_get_userbyid(d.datdba) || '|' || coalesce(pg_catalog.shobj_description(d.oid, 'pg_database'), '') FROM pg_catalog.pg_database d WHERE d.datname = '$1'") || { echo foreign; return; }
  if [[ -z $r ]]; then echo none
  elif [[ $r == "$2|$DRILL_MARK" ]]; then echo ours
  else echo foreign; fi
}
# drill_db_drop db role: drops it only when it is a drill database of this app (or is not there)
drill_db_drop() {
  case $(drill_db_state "$1" "$2") in
    none) return 0;;
    ours) pgsql -c "DROP DATABASE IF EXISTS $1 WITH (FORCE)" > /dev/null 2>&1;;
    *) return 1;;
  esac
}
# drill_remote_empty db: every schema the app's role owns in its drill database on the data node
# goes (public too, made again): the role cannot drop or create databases there
drill_remote_empty() {
  # (the statement on stdin: systemd-run reads $ in its arguments, and a DO block needs $$)
  as_app_pg psql -X -q -At -v ON_ERROR_STOP=1 -h "$DB_HOST" -p "$DB_PORT" -U "$DB_ROLE" -d "$1" > /dev/null <<'SQL'
SET client_min_messages = warning;
DO $$ DECLARE s name; BEGIN
  FOR s IN SELECT nspname FROM pg_namespace WHERE pg_has_role(nspowner, 'USAGE')
    AND nspname NOT LIKE 'pg\_%' AND nspname <> 'information_schema' LOOP
    EXECUTE format('DROP SCHEMA %I CASCADE', s);
  END LOOP;
END $$;
CREATE SCHEMA IF NOT EXISTS public;
SQL
}
# drill_free path need_kb: the filesystem of path has need_kb free, and 256 MB to spare after it
drill_free() {
  local free; free=$(df -Pk "$1" 2> /dev/null | awk 'NR == 2 { print $4 }')
  [[ $free =~ ^[0-9]+$ ]] || return 0
  ((free >= $2 + 262144))
}
# drill_record result id why: the outcome in the state (under the app's lock, held only for this)
drill_record() {
  lock 600
  load "$D/state" S
  st drill_at "$(now)" drill_result "$1" drill_id "$2" drill_why "${3:0:200}" drill_files "${DR_FILES:-}" \
    drill_tables "${DR_TABLES:-}" drill_rows "${DR_ROWS:-}" drill_secs "${DR_SECS:-}"
  exec 9>&-
}
# The database part runs as the app's own role, as the live restore does: the dump is the app's,
# so every object in it (an index on an app function, a SECURITY DEFINER function, a function
# named like a built-in) is the app's to define, and must never run with more than the app's
# rights. The superuser only creates the empty database (owned by the role, no PUBLIC access, the
# role's temp limit lifted in it alone, as a restore needs) and drops it.
cmd_backup_drill() { # app [id]
  need_root; app "$1"
  local id=${2:-} dir t0 tmp="" dbn="" rc why="" nf tf ntab ttab need dbneed=0 pgdir dbstate
  has_backup_data || die "$A has no data or database: there is nothing to drill"
  [[ -z $id ]] && id=$(bk_order | head -1)
  DR_FILES="" DR_TABLES="" DR_ROWS="" DR_SECS=""
  if [[ -z $id ]]; then
    drill_record fail "" "no backup to restore"; die "no backup of $A yet to drill: tando backup now"
  fi
  valid_backup "$id" && offsite_fetch "$id"
  valid_backup "$id" && [[ -d $BK/$A/$id ]] || die "no such backup: $id"
  dir=$BK/$A/$id; t0=$(now)
  # room for it: what the archive lists (its real size, however well it compressed), unpacked
  # beside the live data; the database as large as the live one, where PostgreSQL keeps its data.
  # Each disk keeps 256 MB to spare: a full disk would take every app down, PostgreSQL first
  need=0
  if [[ -f $dir/data.tar.gz ]]; then
    need=$(tar -tvzf "$dir/data.tar.gz" 2> /dev/null | awk '$1 ~ /^[-h]/ { s += $3 } END { printf "%.0f", s / 1024 + 1 }')
    [[ $need =~ ^[0-9]+$ ]] || why="the data archive cannot be read (tar failed)"
  fi
  if [[ -z $why && -f $dir/db.dump ]] && ! db_remote; then
    dbneed=$(pgsql -c "SELECT pg_catalog.pg_database_size('$(db_role)') / 1024" 2> /dev/null)
    [[ $dbneed =~ ^[0-9]+$ ]] || dbneed=$(du -sk "$dir/db.dump" | awk '{ print $1 * 4 }')
    pgdir=$(pgsql -c "SHOW data_directory" 2> /dev/null)
  fi
  if [[ -z $why ]]; then
    if [[ -n ${pgdir:-} && -d $pgdir && $(df -P "$pgdir" | awk 'NR == 2 { print $1 }') != $(df -P "$R/apps" | awk 'NR == 2 { print $1 }') ]]; then
      drill_free "$R/apps" "$need" || why="not enough free disk space to unpack the backup ($((need / 1024)) MB and 256 MB to spare needed)"
      [[ -n $why ]] || drill_free "$pgdir" "$dbneed" || why="not enough free disk space for PostgreSQL to restore the database ($((dbneed / 1024)) MB and 256 MB to spare needed)"
    else
      drill_free "$R/apps" "$((need + dbneed))" || why="not enough free disk space to restore the backup ($(((need + dbneed) / 1024)) MB and 256 MB to spare needed)"
    fi
  fi
  if [[ -z $why && -f $dir/data.tar.gz ]]; then
    tmp=$D/shared/.drill-$$
    as_app mkdir -m 700 "$tmp" 2> /dev/null || why="could not make a directory for the drill in shared/"
    if [[ -z $why ]]; then
      tf=$(tar -tvzf "$dir/data.tar.gz" 2> /dev/null | grep -c '^[-h]')   # (files, and hard links, which unpack as files)
      if as_app tar -C "$tmp" --no-same-owner -xzf - < "$dir/data.tar.gz" 2> /dev/null; then
        nf=$(as_app find "$tmp" -type f | wc -l | tr -d ' ')
        DR_FILES=$nf
        [[ $nf == "$tf" ]] || why="the data archive lists $tf files and $nf were restored"
      else why="the data archive does not unpack (tar failed)"; fi
    fi
  fi
  if [[ -z $why && -f $dir/db.dump ]]; then
    db_creds
    dbn=$(drill_dbname "$A")
    # on a data node: its empty drill database (made with the project's, owned by the app's
    # role, data-db ensure) is emptied by the role itself, before and after
    if db_remote; then dbstate=remote; drill_remote_empty "$dbn" || why="could not empty the drill database $dbn on the data node ${H[db_host]}"
    else dbstate=$(drill_db_state "$dbn" "$DB_ROLE"); fi
    if [[ -n $why ]]; then dbn=""
    elif [[ $dbstate == remote ]]; then :
    elif [[ $dbstate == foreign ]]; then
      why="a database $dbn exists that is not a restore drill of $A: it was left as it is (drop it by hand if it is not needed)"
      dbn=""
    elif ! { drill_db_drop "$dbn" "$DB_ROLE" && pgsql -c "CREATE DATABASE $dbn OWNER $DB_ROLE" &&
             pgsql -c "REVOKE ALL ON DATABASE $dbn FROM PUBLIC" -c "GRANT CONNECT, TEMPORARY ON DATABASE $dbn TO $DB_ROLE" \
               -c "COMMENT ON DATABASE $dbn IS '$DRILL_MARK'" -c "ALTER ROLE $DB_ROLE IN DATABASE $dbn SET temp_file_limit = -1"; } > /dev/null 2>&1; then
      why="could not create the throwaway database $dbn"
    fi
    if [[ -z $why ]]; then
      ttab=$(as_app_pg pg_restore -l < "$dir/db.dump" 2> /dev/null | awk '$4 == "TABLE" && $5 != "DATA" && $5 != "ATTACH" { n++ } END { print n + 0 }')
      # (its messages may hold rows of the app's data: only the exit code is kept)
      as_app_pg timeout 3600 pg_restore --no-owner --no-acl -h "$DB_HOST" -p "$DB_PORT" -U "$DB_ROLE" -d "$dbn" < "$dir/db.dump" > /dev/null 2>&1; rc=$?
      if ((rc != 0)); then
        why="pg_restore exited with $rc (run it by hand on a copy of backup $id to see why)"
      else
        # counted as the app's role too, with nothing of the app's on the search path
        ntab=$(as_app_pg psql -X -q -At -v ON_ERROR_STOP=1 -h "$DB_HOST" -p "$DB_PORT" -U "$DB_ROLE" -d "$dbn" \
          -c "SET search_path = pg_catalog" -c "SELECT pg_catalog.count(*) FROM pg_catalog.pg_tables WHERE schemaname OPERATOR(pg_catalog.<>) ALL (ARRAY['pg_catalog', 'information_schema']::pg_catalog.name[])" < /dev/null 2> /dev/null)
        DR_TABLES=$ntab
        DR_ROWS=$(as_app_pg psql -X -q -At -v ON_ERROR_STOP=1 -h "$DB_HOST" -p "$DB_PORT" -U "$DB_ROLE" -d "$dbn" \
          -c "SET search_path = pg_catalog" -c "SELECT COALESCE(pg_catalog.sum((pg_catalog.xpath('/row/c/text()', pg_catalog.query_to_xml(pg_catalog.format('select pg_catalog.count(*) as c from %I.%I', schemaname, tablename), false, true, '')))[1]::text::bigint), 0) FROM pg_catalog.pg_tables WHERE schemaname OPERATOR(pg_catalog.<>) ALL (ARRAY['pg_catalog', 'information_schema']::pg_catalog.name[])" < /dev/null 2> /dev/null)
        [[ $ntab =~ ^[0-9]+$ ]] && ((ntab >= ttab)) || why="the dump lists $ttab tables and ${ntab:-no} were restored"
      fi
    fi
  fi
  # the throwaway copies go, whatever happened (the database only when it is this drill's)
  if [[ -n $dbn ]] && db_remote; then drill_remote_empty "$dbn" || echo "tando-agent: could not empty the drill database $dbn on the data node" >&2
  elif [[ -n $dbn ]]; then drill_db_drop "$dbn" "$DB_ROLE" || echo "tando-agent: could not drop the throwaway database $dbn" >&2; fi
  [[ -n $tmp ]] && as_app rm -rf "$tmp"
  DR_SECS=$(($(now) - t0))
  if [[ -z $why ]]; then
    drill_record ok "$id" ""
    echo "result=ok"; echo "id=$id"; echo "files=${DR_FILES:-}"; echo "tables=${DR_TABLES:-}"; echo "rows=${DR_ROWS:-}"; echo "secs=$DR_SECS"
  else
    drill_record fail "$id" "$why"
    echo "result=fail"; echo "id=$id"; echo "why=$why"
    AUDIT_RESULT=failed; exit 1
  fi
}
backup_drill_time() { # -> HH:MM, five minutes after the start of the backup window (the queue starts first)
  local w; w=$(backup_window)
  date -d "2000-01-01 ${w% *} + 5 minutes" +%H:%M
}
drill_sched_install() {
  WIC_CHANGED=0
  if [[ ${H[backup_drill]:-monthly} == off ]]; then
    if [[ -f /etc/systemd/system/tando-drill.timer ]]; then
      systemctl disable -q --now tando-drill.timer 2> /dev/null
      rm -f /etc/systemd/system/tando-drill.timer /etc/systemd/system/tando-drill.service
      systemctl daemon-reload
    fi
    return 0
  fi
  write_if_changed /etc/systemd/system/tando-drill.service <<EOF
[Unit]
Description=tando: the monthly restore drill of every app's latest backup

[Service]
Type=oneshot
ExecStart=$AGENT backup-drill-all
EOF
  write_if_changed /etc/systemd/system/tando-drill.timer <<EOF
[Unit]
Description=tando: the monthly restore drill

[Timer]
OnCalendar=*-*-01 $(backup_drill_time):00
Persistent=true

[Install]
WantedBy=timers.target
EOF
  ((WIC_CHANGED)) && systemctl daemon-reload
  systemctl -q is-enabled tando-drill.timer 2> /dev/null && systemctl -q is-active tando-drill.timer ||
    systemctl enable -q --now tando-drill.timer
  return 0
}
cmd_backup_drill_all() {
  need_root
  load "$R/host.conf" H
  [[ ${H[backup_drill]:-monthly} == off ]] && { echo "drilled=0"; return 0; }
  local w s e t0 endt f a apps=() n=0 late=0 bad=0
  w=$(backup_window); s=${w% *}; e=${w#* }
  t0=$(now); endt=$(date -d "today $e" +%s)
  ((endt > t0)) || endt=$((endt + 86400))
  for f in "$R"/apps/*/app.conf; do
    [[ -f $f ]] && grepq -x 'backup=daily' "$f" || continue
    a=${f%/app.conf}; apps+=("${a##*/}")
  done
  # the backup queue runs first, in the same window: a drill never competes with it
  while systemctl -q is-active tando-backups.service && (($(now) < endt)); do sleep 15; done
  for a in $(backup_order ${apps[@]+"${apps[@]}"}); do
    if (($(now) >= endt)); then late=$((late + 1)); continue; fi
    if "$AGENT" backup-drill "$a" > /dev/null 2>&1; then n=$((n + 1)); else bad=$((bad + 1)); fi
  done
  echo "drilled=$n"; echo "failed=$bad"
  ((late == 0)) || echo "tando-agent: $late restore drill(s) not started: the backup window ($s-$e) ended first" >&2
  return 0
}

# ---- preview apps: <app>-<branch>, a temporary copy of an app for a branch -------------------------
# `tando preview up` (and CI, through the gate) makes the app <parent>-<slug> from the parent's own
# settings: no database, no scheduled jobs, no backups, no domains of its own, idle_stop on (6h by
# default), the parent's env except what the parent's preview_skip names, and an expiry
# (preview_expires; preview_ttl of the parent, 7d by default) after which preview-sweep (the hourly
# tando-previews.timer) destroys it. Its code is deployed like any app's (the parent's deploy key
# may deploy it: tando-gate mirrors the key list, srv/gate).
PREVIEW_MAX=10
preview_secs() { # 7d, 12h, 30m, 90s -> seconds
  [[ ${1:-} =~ ^([1-9][0-9]{0,3})([smhd])$ ]] || return 1
  local n=${BASH_REMATCH[1]}
  case ${BASH_REMATCH[2]} in s) echo "$n";; m) echo $((n * 60));; h) echo $((n * 3600));; d) echo $((n * 86400));; esac
}
# preview_env_parents name value parent: the variable leads to the parent's own data (never copied)
preview_env_parents() {
  case $1 in DATABASE_URL|DATABASE_URL_DIRECT|DATABASE_PATH|TANDO_DATA_DIR|PORT|HOME) return 0;; esac
  [[ $2 == *"tando_${3//-/_}"* || $2 == *"$R/apps/$3/"* || $2 == *"$R/apps/$3" ]]
}
valid_preview_name() { # parent preview
  [[ $2 == "$1"-* ]] && valid_app "$2" && [[ ${2#"$1"-} =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]
}
preview_sched_install() {
  WIC_CHANGED=0
  write_if_changed /etc/systemd/system/tando-previews.service <<EOF
[Unit]
Description=tando: remove the preview apps that expired

[Service]
Type=oneshot
ExecStart=$AGENT preview-sweep
EOF
  write_if_changed /etc/systemd/system/tando-previews.timer <<EOF
[Unit]
Description=tando: look for expired preview apps every hour

[Timer]
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
EOF
  ((WIC_CHANGED)) && systemctl daemon-reload
  systemctl -q is-enabled tando-previews.timer 2> /dev/null || systemctl enable -q --now tando-previews.timer
  return 0
}
cmd_preview_up() { # parent preview [ttl]
  need_root
  local parent=${1:-} pv=${2:-} ttl=${3:-} secs k skip new=1 copied=0 skipped=0 sf
  valid_app "$parent" || die "invalid app name"
  valid_preview_name "$parent" "$pv" || die "bad preview name: ${pv:-(none)} (it is <app>-<name>: lower case letters, digits and -, at most 24 characters)"
  [[ -f $R/apps/$parent/app.conf ]] || die "no such app: $parent"
  local -A PC=() XC=() PE=()
  load "$R/apps/$parent/app.conf" PC
  [[ -z ${PC[preview_of]:-} ]] || die "$parent is itself a preview: a preview has no previews"
  [[ -n $ttl ]] || ttl=${PC[preview_ttl]:-7d}
  secs=$(preview_secs "$ttl") || die "bad preview ttl: $ttl (like 7d, 12h, 90m)"
  ((secs <= 7776000)) || die "a preview lives 90 days at most (got $ttl)"
  # the name check, the count and the creation under one host lock: two calls at once never make
  # more than PREVIEW_MAX; configure creates only (CONF_CREATE_ONLY), so an app an admin made under
  # this name in between is never taken over
  lockfile "$R/.previews.lock"; exec 12>"$R/.previews.lock"
  flock -w 120 12 || die "another preview is being made on this server and takes too long; try again"
  if [[ -f $R/apps/$pv/app.conf ]]; then
    load "$R/apps/$pv/app.conf" XC
    [[ ${XC[preview_of]:-} == "$parent" ]] || die "$pv exists and is not a preview of $parent: choose another branch name"
    new=0
  fi
  if ((new)); then
    # a deploy key can make previews: not without limit (each one runs an app)
    local np=0 pf
    for pf in "$R"/apps/*/app.conf; do grepq -x "preview_of=$parent" "$pf" 2> /dev/null && np=$((np + 1)); done
    ((np < PREVIEW_MAX)) || die "$parent has $np previews already (at most $PREVIEW_MAX): tando preview rm removes one; they also expire"
    fp pv.checked
    sf=$(mktemp) || die "could not make a temporary file"
    {
      # the release command (migrations) only when the parent says preview_release = on: with the
      # parent's external database or services in the env it would change those
      if [[ ${PC[preview_release]:-off} == on ]]; then conf_text PC; else conf_text PC | grep -Ev '^release(_shell|_timeout)?='; fi |
        grep -Ev '^(job\.|database=|backup=|idle_stop=|db_|job_timeout=|job_spread=|job_missed=|preview_)'
      echo "backup=off"
      case ${PC[recipe]:-node} in static|container) ;;
        *) k=${PC[idle_stop]:-6h}; [[ $k == off || -z $k ]] && k=6h; echo "idle_stop=$k";; esac
      echo "preview_of=$parent"; echo "preview_expires=$(($(now) + secs))"
    } > "$sf"
    # (the redirections inside the subshell: on the subshell itself bash keeps the original fds in 10 and 11,
    # and configure's lock on the Caddy sites uses fd 11. PATH: the gate runs the agent with a short one)
    # (fd 12 closed in it: the lock stays this process's, never a child's that outlives it)
    ( exec < "$sf" > /dev/null 12>&-; export PATH=/usr/local/sbin:/usr/local/bin:$PATH CONF_CREATE_ONLY=1; cmd_configure "$pv" ) ||
      { rm -f "$sf"; die "could not create the preview $pv"; }
    rm -f "$sf"
    # the parent's env: only what the parent lists in preview_env (none by default: a branch nobody
    # reviewed runs on a public link), minus preview_skip, and never what reaches the parent's own
    # data: its database URLs (also with an external database), the paths the server sets, a value
    # naming its database role or its directory
    skip=",${PC[preview_skip]:-},"
    app "$parent"; local -A E=(); env_load E
    # shellcheck disable=SC2034  # PE is read by env_save through its nameref
    for k in "${!E[@]}"; do
      if [[ ,${PC[preview_env]:-}, == *",$k,"* && $skip != *",$k,"* ]] && ! preview_env_parents "$k" "${E[$k]}" "$parent"; then
        PE[$k]=${E[$k]}; copied=$((copied + 1))
      else skipped=$((skipped + 1)); fi
    done
    app "$pv"
    env_save PE || die "could not write the env of $pv (disk full?)"
    preview_sched_install || echo "tando-agent: could not enable tando-previews.timer: previews will not expire by themselves" >&2
  else
    app "$pv"; lock 120
    C[preview_expires]=$(($(now) + secs)); save "$D/app.conf" C
  fi
  echo "preview=$pv"; echo "parent=$parent"; echo "created=$new"; echo "expires=$(sed -n 's/^preview_expires=//p' "$R/apps/$pv/app.conf")"
  echo "env_copied=$copied"; echo "env_skipped=$skipped"; echo "link=$(link)"
}
cmd_preview_ls() { # [parent]
  need_root
  local f a
  for f in "$R"/apps/*/app.conf; do
    [[ -f $f ]] || continue
    a=${f%/app.conf}; a=${a##*/}
    grepq '^preview_of=' "$f" || continue
    [[ -z ${1:-} ]] || grepq -x "preview_of=$1" "$f" || continue
    ( app "$a"; row preview "$a" "${C[preview_of]}" "${C[preview_expires]:-0}" "${C[created]:-0}" "${S[current]:--}" "$(link)" )
  done
  return 0
}
cmd_preview_rm() { # parent preview
  need_root
  valid_app "${1:-}" || die "invalid app name"
  valid_preview_name "$1" "${2:-}" || die "bad preview name: ${2:-(none)}"
  [[ -f $R/apps/$2/app.conf ]] && grepq -x "preview_of=$1" "$R/apps/$2/app.conf" || die "$2 is not a preview of $1"
  cmd_destroy "$2" purge
}
cmd_preview_sweep() {
  need_root
  local f a e t n=0 bad=0; t=$(now)
  for f in "$R"/apps/*/app.conf; do
    [[ -f $f ]] || continue
    grepq '^preview_of=' "$f" || continue
    e=$(sed -n 's/^preview_expires=//p' "$f")
    [[ $e =~ ^[0-9]+$ ]] && ((e <= t)) || continue
    a=${f%/app.conf}; a=${a##*/}
    # (only a preview by its name too: <parent>-<slug> of an app that preview_of names)
    valid_preview_name "$(sed -n 's/^preview_of=//p' "$f" | head -1)" "$a" || continue
    if "$AGENT" destroy "$a" purge > /dev/null 2>&1; then n=$((n + 1)); else bad=$((bad + 1)); echo "tando-agent: could not remove the expired preview $a" >&2; fi
  done
  echo "removed=$n"; echo "failed=$bad"
}

# ---- PostgreSQL: one role and one database per app, named tando_<app> ---------------------

# pgsql: SQL as the superuser, in tando's own cluster (PGCLUSTER: with a second cluster on the
# server, the distribution's psql wrapper would otherwise choose one itself)
pgsql() {
  (cd / && exec runuser -u postgres -- ${H[postgres_version]:+env "PGCLUSTER=${H[postgres_version]}/main"} \
    psql -X -q -At -v ON_ERROR_STOP=1 "$@")
}

apt_missing() { local p m=""; for p; do dpkg -s "$p" > /dev/null 2>&1 || m+="${m:+ }$p"; done; echo "$m"; }
apt_install() { # packages...
  local p missing=()
  for p; do dpkg -s "$p" > /dev/null 2>&1 || missing+=("$p"); done
  ((${#missing[@]})) || return 0
  # apt's own output goes to a log, so a failure can point at it and a success prints nothing
  # NEEDRESTART_SUSPEND: Ubuntu's needrestart would otherwise restart every service that uses an
  # outdated library after a noninteractive install, including sites tando does not manage
  # Up to three tries, 5 s and 15 s apart: a package mirror that stalls or answers half an index
  # is the usual reason, and the next try gets another mirror or a complete file. A lock held by
  # another apt (the daily upgrade) is waited for, up to two minutes, instead of failing at once.
  local try
  for try in 1 2 3; do
    { apt-get -o DPkg::Lock::Timeout=120 update -qq &&
      DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 apt-get -o DPkg::Lock::Timeout=120 install -y -qq "${missing[@]}"; } \
      >> /var/log/tando-apt.log 2>&1 && return 0
    echo "tando-agent: apt try $try of 3 for ${missing[*]} failed ($(date -u +%FT%TZ))" >> /var/log/tando-apt.log
    ((try < 3)) && sleep $((try * 10 - 5))
  done
  die "could not install ${missing[*]} with apt (3 tries): sudo tail -20 /var/log/tando-apt.log on the server shows why"
}

# Which PostgreSQL: H[postgres_version] in host.conf, the major version whose cluster "main" holds
# the apps' databases. Recorded once, when tando first uses the cluster, and kept: a newer major
# that a distribution upgrade installs beside it (an empty cluster on another port) is never
# picked up by itself. tando doctor reports it; moving is a manual step (docs/COMMANDS.md,
# "Upgrading PostgreSQL") that ends with `tando host setup <host> postgres_version=<N>`.
pg_majors() { # every major version with a configuration directory or binaries here, oldest first
  { ls /etc/postgresql 2> /dev/null; ls /usr/lib/postgresql 2> /dev/null; } | grep -x '[0-9][0-9]*' | sort -n -u
}
pg_port() { pg_lsclusters -h 2> /dev/null | awk -v v="$1" '$1 == v && $2 == "main" { print $3 }'; }
# pg_pin [lock]: record the version if none is recorded: the cluster "main" on port 5432, where
# the apps' DATABASE_URL points. lock: the caller is not host setup (it takes the host lock itself
# and reads host.conf again). Returns 1 with PG_PIN_ERR when the server does not say which.
pg_pin() {
  [[ ${H[postgres_version]:-} =~ ^[0-9]+$ ]] && return 0
  if [[ ${1:-} == lock ]]; then
    host_lock; load "$R/host.conf" H
    [[ ${H[postgres_version]:-} =~ ^[0-9]+$ ]] && return 0
  fi
  local on
  on=$(pg_lsclusters -h 2> /dev/null | awk '$2 == "main" && $3 == 5432 { print $1 }')
  if [[ ! $on =~ ^[0-9]+$ ]]; then
    PG_PIN_ERR="no PostgreSQL cluster named main listens on port 5432 (pg_lsclusters on the server lists them): say which version holds the apps' databases with tando host setup <host> postgres_version=<N>"
    return 1
  fi
  H[postgres_version]=$on
  save "$R/host.conf" H && chmod 644 "$R/host.conf"
}
# pg_repin N (host setup postgres_version=N): the databases were moved to version N by hand
pg_repin() {
  [[ $1 =~ ^[1-9][0-9]?$ ]] || die "bad postgres_version: $1 (a major version, like 18)"
  [[ -f /etc/postgresql/$1/main/postgresql.conf ]] || die "no PostgreSQL cluster $1/main on this server (pg_lsclusters lists them)"
  [[ $(pg_port "$1") == 5432 ]] ||
    die "PostgreSQL $1/main listens on port $(pg_port "$1"), and the apps connect to 5432: move it there first (docs/COMMANDS.md, Upgrading PostgreSQL)"
  H[postgres_version]=$1
}

# pg_protect: the kernel's out-of-memory killer must not pick the postmaster: killing it takes
# every app's database down at once. Its children (one per connection) stay at 0, so the backend
# of a runaway query can still be killed, and an app (OOMScoreAdjust=500) goes before any of them.
# The distribution's unit and pg_ctlcluster already do this (-900; PG_OOM_ADJUST_FILE resets the
# children); the drop-in keeps it so whatever a later package's unit says, and tando doctor reads
# the live values. The values do not change, so PostgreSQL is not restarted for it.
PG_DROPIN=/etc/systemd/system/postgresql@.service.d/tando.conf
pg_protect() {
  local before
  mkdir -p "${PG_DROPIN%/*}"
  before=$(cksum < "$PG_DROPIN" 2> /dev/null)
  printf '# written by tando (host setup): the OOM killer spares the postmaster\n[Service]\nOOMScoreAdjust=-900\n' |
    write_if_changed "$PG_DROPIN" || return 1
  [[ $before == "$(cksum < "$PG_DROPIN")" ]] || systemctl daemon-reload
}

pg_setup() {
  # (one apt run for both: pgb_setup then finds pgbouncer there)
  if ! command -v pg_ctlcluster > /dev/null || ! command -v pgbouncer > /dev/null; then
    apt_install postgresql pgbouncer
  fi
  pg_pin || die "$PG_PIN_ERR"
  pg_protect || die "could not write $PG_DROPIN"
  pg_tune || die "$PG_TUNE_ERR"
  systemctl enable -q postgresql
  # apps reach only their own database: no default CONNECT on the shared databases
  pgsql -c "REVOKE CONNECT ON DATABASE postgres FROM PUBLIC" -c "REVOKE CONNECT ON DATABASE template1 FROM PUBLIC" ||
    die "could not configure postgresql"
  # (in a subshell: a pgbouncer that cannot be installed is a warning; the apps then connect directly)
  ( pgb_setup ) || echo "tando-agent: pgbouncer could not be set up; apps connect to PostgreSQL directly until host setup sets it up (tando doctor)" >&2
}

# pg_sizing: PostgreSQL's memory settings from the server's RAM (MemTotal, or the cgroup's limit
# when lower), tuned for the typical VM of 4 vCPU and 8 GB: max_connections 100 (one per 80 MB,
# in tens, 50 to 400; host setup pg_max_connections=N sets it), shared_buffers 15% of RAM,
# work_mem so that every connection sorting at once stays near 6% of RAM (2 to 32 MB),
# maintenance_work_mem 1/32 of RAM (16 MB to 1 GB), effective_cache_size half of it.
pg_sizing() {
  local mem lim
  mem=$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo)
  lim=$(cat /sys/fs/cgroup/memory.max 2> /dev/null)
  [[ $lim =~ ^[0-9]+$ ]] && ((lim / 1048576 < mem)) && mem=$((lim / 1048576))
  [[ $mem =~ ^[0-9]+$ ]] && ((mem >= 256)) || mem=1024
  PGS_MEM=$mem
  PGS_MC=$(((mem / 80 + 5) / 10 * 10)); ((PGS_MC < 50)) && PGS_MC=50; ((PGS_MC > 400)) && PGS_MC=400
  [[ ${H[pg_max_connections]:-} =~ ^[1-9][0-9]+$ ]] && PGS_MC=${H[pg_max_connections]}
  PGS_SB=$((mem * 15 / 100)); ((PGS_SB < 32)) && PGS_SB=32
  PGS_WM=$((mem / PGS_MC / 16)); ((PGS_WM < 2)) && PGS_WM=2; ((PGS_WM > 32)) && PGS_WM=32
  PGS_MWM=$((mem / 32)); ((PGS_MWM < 16)) && PGS_MWM=16; ((PGS_MWM > 1024)) && PGS_MWM=1024
  PGS_ECS=$((mem / 2)); ((PGS_ECS < 128)) && PGS_ECS=128
}
pg_restart() {
  local i
  for i in $(seq 30); do
    systemctl restart postgresql 2> /dev/null && break
    sleep 1
  done
  for i in $(seq 30); do pg_isready -q -h 127.0.0.1 && break; sleep 1; done
}
# pg_tune: tando's settings of the cluster (conf.d/tando.conf), sized by pg_sizing. A reload
# applies most of them at once; max_connections, shared_buffers and wal_buffers need a restart,
# which drops every app's connections. So PostgreSQL restarts by itself only when no app has a
# database yet (a new server) or it is not running; otherwise only with the owner's yes
# (PG_RESTART_OK: host setup --pg-restart, which the client asks for first). Until then it keeps
# the old values, and PG_PENDING names the settings that wait (PostgreSQL's pending_restart).
# PG_RESTARTED=1 when it restarted. Returns 1 with PG_TUNE_ERR when the cluster has no conf.d.
pg_tune() {
  local conf t0 i changed=0 fresh=0
  PG_PENDING="" PG_RESTARTED=""
  conf=/etc/postgresql/${H[postgres_version]}/main/conf.d/tando.conf
  if [[ ! -d ${conf%/*} ]]; then
    PG_TUNE_ERR="PostgreSQL ${H[postgres_version]}/main, where tando's databases are, has no ${conf%/*}: pg_lsclusters on the server shows what is there (docs/COMMANDS.md, Upgrading PostgreSQL)"
    return 1
  fi
  pg_sizing
  local listen=localhost tls=""
  # a data node (docs/DATA-NODE.md): every address, TLS once its certificate is there (dn_tls);
  # pg_hba and the firewall decide who gets in
  if dn_is; then
    [[ -s $DN_TLS/server.pem && -s $DN_TLS/server.key ]] && listen='*' &&
      tls=$(printf "ssl = on\nssl_cert_file = '%s/server.pem'\nssl_key_file = '%s/server.key'\nssl_min_protocol_version = 'TLSv1.2'\npassword_encryption = 'scram-sha-256'" "$DN_TLS" "$DN_TLS")
  fi
  cat > "$conf.tmp" <<CONF
# written by tando (host setup), sized from this server's RAM (docs/ARCHITECTURE.md, PostgreSQL)
listen_addresses = '$listen'
max_connections = $PGS_MC
shared_buffers = ${PGS_SB}MB
work_mem = ${PGS_WM}MB
maintenance_work_mem = ${PGS_MWM}MB
effective_cache_size = ${PGS_ECS}MB
wal_buffers = -1
max_wal_size = 1GB
# a client that never answers the password request holds a slot only this long (default 60 s)
authentication_timeout = 5s
superuser_reserved_connections = 3
CONF
  [[ -z $tls ]] || printf '%s\n' "$tls" >> "$conf.tmp"
  if ! cmp -s "$conf.tmp" "$conf"; then mv "$conf.tmp" "$conf"; changed=1; else rm -f "$conf.tmp"; fi
  # the install can restart dbus or systemd libraries: pg_restart retries until systemctl answers
  if ! pg_isready -q -h 127.0.0.1; then pg_restart; PG_RESTARTED=1; return 0; fi
  [[ $(pgsql -c "SELECT count(*) FROM pg_database WHERE datname LIKE 'tando\_%'" 2> /dev/null) == 0 ]] && fresh=1
  if ((changed)); then
    t0=$(pgsql -c "SELECT pg_conf_load_time()" 2> /dev/null)
    systemctl reload postgresql 2> /dev/null
    # (a reload is a signal: the new values are read a moment later)
    for i in $(seq 20); do [[ $(pgsql -c "SELECT pg_conf_load_time()" 2> /dev/null) != "$t0" ]] && break; sleep 0.25; done
  fi
  PG_PENDING=$(pgsql -c "SELECT string_agg(name, ', ' ORDER BY name) FROM pg_settings WHERE pending_restart" 2> /dev/null)
  if [[ -n $PG_PENDING ]] && ((fresh || ${PG_RESTART_OK:-0})); then
    pg_restart; PG_RESTARTED=1 PG_PENDING=""
  fi
  return 0
}

# ---- pgbouncer: one pooler in front of PostgreSQL for every app's database ----------------
# Set up with PostgreSQL (host setup). It listens on 127.0.0.1:6432 only (no unix socket: the
# loopback rules keep apps without a database away from it, as from 5432) and pools by
# transaction: a server connection belongs to an app only for one transaction, so many apps with
# a small pool each (db_pool, default 5) share PostgreSQL's max_connections, and an idle app holds
# none after a minute (server_idle_timeout). Per app (pgb_sync): its database with at most db_pool
# server connections, and its role's SCRAM secret from pg_authid, with which pgbouncer checks the
# app's password and logs in for it (no password in plain text in its files). An app's
# DATABASE_URL points here from its first deploy with this agent on, unless db_direct = true;
# DATABASE_URL_DIRECT (5432) is what needs a session: the release command (migrations). tando's
# backups, the studio, tando db psql and tando-watch connect to PostgreSQL directly.
PGB_DIR=/etc/pgbouncer PGB_PORT=6432
PGB_DROPIN=/etc/systemd/system/pgbouncer.service.d/tando.conf
DB_POOL=5        # db_pool's default: server connections per app through pgbouncer
DB_TOOL_SLOTS=5  # the role may hold db_pool + these: migrations, backups, the studio, db psql
pgb_setup() {
  local first=0 before
  command -v pgbouncer > /dev/null || apt_install pgbouncer
  grep -q '^; written by tando' "$PGB_DIR/pgbouncer.ini" 2> /dev/null || first=1
  # out of memory, an app goes first, never the pooler every database app uses (as the postmaster)
  mkdir -p "${PGB_DROPIN%/*}"
  before=$(cksum < "$PGB_DROPIN" 2> /dev/null)
  printf '# written by tando (host setup): pgbouncer, the way to their database of every pooled app\n[Service]\nOOMScoreAdjust=-900\nLimitNOFILE=65536\nRestart=on-failure\nRestartSec=1\n' |
    write_if_changed "$PGB_DROPIN" || return 1
  [[ $before == "$(cksum < "$PGB_DROPIN")" ]] || systemctl daemon-reload
  pgb_sync || return 1
  systemctl enable -q pgbouncer 2> /dev/null
  # restarted only the first time (the package's own configuration before) or when it is down: a
  # restart drops the pooled apps' connections; pgb_sync's changes need only a reload
  if ((first)) || ! systemctl is-active -q pgbouncer; then systemctl restart pgbouncer || return 1; fi
}
# pgb_put file: stdin into a file pgbouncer (user postgres) reads and the apps cannot, only when
# it differs; PGB_CHANGED=1 when it did
pgb_put() {
  local t; t=$(mktemp "$PGB_DIR/.tando.XXXXXX") || return 1
  cat > "$t" || { rm -f "$t"; return 1; }
  if cmp -s "$t" "$1"; then rm -f "$t"; return 0; fi
  chown root:postgres "$t" && chmod 640 "$t" && mv -f "$t" "$1" || { rm -f "$t"; return 1; }
  PGB_CHANGED=1
}
# pgb_sync: pgbouncer's databases and users from PostgreSQL (the roles tando_*, their SCRAM
# secrets) and the apps' db_pool (app.conf; for the app in hand, C: the release going live).
# Both files are written whole, one sync at a time; pgbouncer reloads only when they changed (a
# reload keeps its clients). Called on an app's deploy and destroy, a pool change, host setup.
pgb_sync() {
  [[ -d $PGB_DIR ]] && command -v pgbouncer > /dev/null || return 0
  lockfile "$R/.pgb.lock"
  (
    flock -w 60 12 || exit 1
    local rows r s f p ver extra="" me=""
    local -A pool=()
    rows=$(pgsql -F ' ' -c "SELECT rolname, rolpassword FROM pg_authid WHERE rolname LIKE 'tando\_%' AND rolpassword LIKE 'SCRAM-SHA-256\$%' ORDER BY 1") || exit 1
    while IFS= read -r f; do
      p=${f#*:db_pool=}; f=${f%%:*}; f=${f%/app.conf}; f=${f##*/}
      [[ $p =~ ^[0-9]+$ ]] && pool[tando_${f//-/_}]=$p
    done < <(grep -H '^db_pool=' "$R"/apps/*/app.conf 2> /dev/null)
    # a data node's projects (data-db): their pool is recorded there
    while IFS= read -r f; do
      p=${f#*:pool=}; f=${f%%:*}; f=${f##*/}
      [[ $p =~ ^[0-9]+$ ]] && pool[tando_${f//-/_}]=$p
    done < <(grep -H '^pool=' "$DN"/db/* 2> /dev/null)
    local listen=127.0.0.1 auth="auth_type = scram-sha-256"
    if dn_is; then
      # every address only with TLS and its hba (hostssl for every address but loopback); until the
      # certificate is there, loopback only, as on any server: never plain passwords outside
      auth="auth_type = hba"$'\n'"auth_hba_file = $PGB_DIR/hba.tando"
      [[ -s $DN_TLS/server.pem && -s $DN_TLS/server.key ]] && listen='*' &&
        auth+=$'\n'"client_tls_sslmode = allow"$'\n'"client_tls_cert_file = $DN_TLS/server.pem"$'\n'"client_tls_key_file = $DN_TLS/server.key"$'\n'"client_tls_protocols = tlsv1.2,tlsv1.3"
      [[ -f $PGB_DIR/hba.tando ]] || pgb_put "$PGB_DIR/hba.tando" <<< "host all all 127.0.0.1/32 scram-sha-256" || exit 1
    fi
    if [[ -n ${A:-} ]]; then me=$(db_role); pool[$me]=${C[db_pool]:-$DB_POOL}; fi
    # protocol-level prepared statements in transaction pooling: pgbouncer 1.21 and newer
    ver=$(pgbouncer --version 2> /dev/null | sed -n 's/^PgBouncer \([0-9]*\)\.\([0-9]*\).*/\1 \2/p' | head -1)
    [[ $ver =~ ^([0-9]+)\ ([0-9]+)$ ]] && ((BASH_REMATCH[1] > 1 || BASH_REMATCH[2] >= 21)) && extra=$'\nmax_prepared_statements = 200'
    PGB_CHANGED=""
    # (pgb_put in this shell, reading a process substitution: it sets PGB_CHANGED)
    pgb_put "$PGB_DIR/userlist.txt" < <(while read -r r s; do [[ -n $r ]] && printf '"%s" "%s"\n' "$r" "$s"; done <<< "$rows") || exit 1
    pgb_put "$PGB_DIR/pgbouncer.ini" < <(
      echo "; written by tando (host setup, deploys): every app's database through one pooler."
      echo "; Rewritten on each change (docs/ARCHITECTURE.md, PostgreSQL): edits here do not last."
      echo "[databases]"
      while read -r r s; do
        [[ -n $r ]] || continue
        p=${pool[$r]:-$DB_POOL}
        echo "$r = host=127.0.0.1 port=5432 dbname=$r pool_size=$p max_db_connections=$p"
      done <<< "$rows"
      cat <<INI

[pgbouncer]
listen_addr = $listen
listen_port = $PGB_PORT
unix_socket_dir =
$auth
auth_file = $PGB_DIR/userlist.txt
pool_mode = transaction
default_pool_size = $DB_POOL
min_pool_size = 0
reserve_pool_size = 0
max_client_conn = 5000
server_idle_timeout = 60
server_lifetime = 3600
client_login_timeout = 5
ignore_startup_parameters = extra_float_digits
log_connections = 0
log_disconnections = 0$extra
INI
    ) || exit 1
    if [[ -n $PGB_CHANGED ]] && systemctl is-active -q pgbouncer; then systemctl reload pgbouncer || exit 1; fi
    exit 0
  ) 12> "$R/.pgb.lock"
}
# pgb_ok role password: pgbouncer lets the role in (asked over it, as the app will; a reload is a
# signal, so up to 5 s for it to be read)
pgb_ok() {
  local i
  systemctl is-active -q pgbouncer || return 1
  for i in $(seq 20); do
    (cd / && PGPASSWORD=$2 PGCONNECT_TIMEOUT=2 psql -X -q -At -h 127.0.0.1 -p "$PGB_PORT" -U "$1" -d "$1" -c 'SELECT 1' &> /dev/null) && return 0
    sleep 0.25
  done
  return 1
}
# db_pool_check: the apps' db_pool together (the settings in hand, C, for this app; the live ones
# for the others; db_direct apps too: their pool is what they open themselves) must fit in what
# PostgreSQL has for them: max_connections less the superuser's 3 and DB_TOOL_SLOTS for tando's
# own. Refused only when this deploy raises the app's share: a server already over (set up by an
# older tando, or with a smaller VM) keeps deploying what it has.
# db_pool_check pool conf: pool, this app's db_pool; conf, tando's file of PostgreSQL's settings
db_pool_check() {
  local mine=$1 max others had cap
  max=$(sed -n 's/^max_connections = //p' "$2" 2> /dev/null)
  [[ $max =~ ^[0-9]+$ ]] || { pg_sizing; max=$PGS_MC; }
  read -r others had < <(awk -F= -v me="$D/app.conf" -v d="$DB_POOL" '
    function add() { if (db) { if (f == me) had = p; else o += p } }
    FNR == 1 { if (f != "") add(); f = FILENAME; db = 0; p = d }
    $1 == "database" && $2 == "postgres" { db = 1 }
    $1 == "db_pool" { p = $2 + 0 }
    END { if (f != "") add(); print o + 0, had + 0 }' "$R"/apps/*/app.conf 2> /dev/null)
  cap=$((max - 3 - DB_TOOL_SLOTS))
  ((others + mine <= cap || mine <= ${had:-0})) && return 0
  die "db_pool = $mine for $A brings the apps' database connections to $((others + mine)), over the $cap PostgreSQL has for them (max_connections $max, less $((3 + DB_TOOL_SLOTS)) kept for tando): set a smaller db_pool in tando.conf (default $DB_POOL), or tando host setup <host> pg_max_connections=N (each one costs memory)"
}

# pg_stat_statements_on: only from tando host setup --pg-stat-statements (the client asks first;
# never by itself). Preloads the module, which restarts PostgreSQL once (every app's database is
# away for a few seconds; a later run finds it loaded and restarts nothing), and creates the
# extension in the postgres database only: tando-watch reads the top statements of every app's
# database from there (the view covers the whole server), while the apps, which cannot connect to
# it, do not see each other's statements. track_utility off: statements such as ALTER ROLE ...
# PASSWORD keep their literals, so they are never recorded. RT_DETAIL says what happened.
pg_stat_statements_on() {
  local conf libs want i restart=""
  conf=/etc/postgresql/${H[postgres_version]}/main/conf.d/tando-pg_stat_statements.conf
  libs=$(pgsql -c "SHOW shared_preload_libraries") || die "PostgreSQL does not answer: tando doctor <host> says why"
  libs=${libs// /}
  [[ $libs =~ ^[A-Za-z0-9_.,\$-]*$ ]] || die "shared_preload_libraries is '$libs': add pg_stat_statements to it by hand"
  want=$libs
  [[ ,$libs, == *,pg_stat_statements,* ]] || { want=${libs:+$libs,}pg_stat_statements; restart=1; }
  printf "# written by tando (host setup --pg-stat-statements)\nshared_preload_libraries = '%s'\npg_stat_statements.track_utility = off\npg_stat_statements.max = 1000\n" "$want" |
    write_if_changed "$conf" || die "could not write $conf"
  if [[ -n $restart ]]; then
    systemctl restart postgresql || die "PostgreSQL did not start again: sudo journalctl -u 'postgresql@*' -n 20 says why"
    for i in $(seq 30); do pg_isready -q -h 127.0.0.1 && break; sleep 1; done
  else
    systemctl reload postgresql 2> /dev/null   # (track_utility and max only need a reload)
  fi
  pgsql -c "CREATE EXTENSION IF NOT EXISTS pg_stat_statements" || die "could not create the extension pg_stat_statements"
  H[pg_stat_statements]=yes; save "$R/host.conf" H; chmod 644 "$R/host.conf"
  RT_DETAIL="pg_stat_statements on${restart:+ (PostgreSQL restarted once)}; top statements in tando snapshot within 2 minutes"
}

# pg_host_sync (host setup, with PostgreSQL on the host): what an older tando did not set yet: the
# recorded version, the drop-in, the sizing (pg_tune), pgbouncer, and every app's role limits
# (db_ensure; its DATABASE_URL stays: an app moves to pgbouncer on its next deploy, never under
# it while it runs). A problem here is a warning, never a failed host setup: tando doctor shows
# the same. PG_DETAIL: the step's line for the client.
pg_host_sync() {
  PG_DETAIL=""
  command -v pg_lsclusters > /dev/null || return 0
  pg_pin || { echo "tando-agent: $PG_PIN_ERR" >&2; return 0; }
  pg_protect || echo "tando-agent: could not write $PG_DROPIN" >&2
  pg_tune || echo "tando-agent: $PG_TUNE_ERR" >&2
  ( pgb_setup ) || echo "tando-agent: pgbouncer could not be set up (apps keep connecting to PostgreSQL directly): tando doctor" >&2
  local a n=0
  for a in "$R"/apps/*/app.conf; do
    [[ -f $a ]] && grepq -x 'database=postgres' "$a" || continue
    a=${a%/app.conf}; a=${a##*/}
    ( app "$a"; lock 300; db_ensure > /dev/null ) ||
      echo "tando-agent: could not set the database limits of $a (is PostgreSQL running? tando doctor)" >&2
    # (still on PostgreSQL's port, and not kept there by db_direct = true: moves on its next deploy)
    grepq '^DATABASE_URL=.*:5432/' "$R/apps/$a/env" 2> /dev/null && ! grepq -x 'db_direct=true' "$R/apps/$a/app.conf" && n=$((n + 1))
  done
  pgb_sync || echo "tando-agent: could not update pgbouncer's databases (tando doctor)" >&2
  pg_sizing
  # (short parts: the client shows the first on the step's line, cut to fit, the others below it)
  PG_DETAIL="max_connections $PGS_MC, shared_buffers ${PGS_SB}MB; work_mem ${PGS_WM}MB, from $PGS_MEM MB of RAM"
  [[ -n $PG_RESTARTED ]] && PG_DETAIL+=", PostgreSQL restarted"
  if [[ -n $PG_PENDING ]]; then
    PG_DETAIL+="; PostgreSQL keeps its old $PG_PENDING until a restart, which drops every app's connections for seconds: tando host setup <host> --pg-restart"
  fi
  if systemctl is-active -q pgbouncer 2> /dev/null; then PG_DETAIL+="; pgbouncer on 127.0.0.1:$PGB_PORT, transaction pooling"
  else PG_DETAIL+="; pgbouncer is not running: apps connect directly (tando doctor)"; fi
  ((n)) && PG_DETAIL+="; $n app$( ((n == 1)) || echo s) move$( ((n == 1)) && echo s) to pgbouncer on the next deploy (db_direct = true keeps an app direct)"
  return 0
}

# pg_doctor: rows for tando doctor
pg_doctor() {
  local ver=${H[postgres_version]:-} port x newer="" pm kid padj kadj
  if pg_isready -q -h 127.0.0.1; then row check ok postgresql "${ver:+$ver/main, }accepting connections"
  else row check fail postgresql "not running: sudo systemctl start postgresql (sudo journalctl -u 'postgresql@*' -n 20 says why)"; fi
  if [[ -z $ver ]]; then
    row check warn "postgresql version" "not recorded yet (set up by an older tando): tando host setup <host> records the cluster the apps use"
    return 0
  fi
  port=$(pg_port "$ver")
  for x in $(pg_majors); do ((x > ver)) && newer=$x; done
  if [[ $port != 5432 ]]; then
    row check fail "postgresql version" "tando's databases are recorded in $ver/main, which ${port:+listens on port $port}${port:-is gone}; the apps connect to 5432. If you moved them to another version: tando host setup <host> postgres_version=<N> (docs/COMMANDS.md, Upgrading PostgreSQL)"
  elif [[ -n $newer ]]; then
    row check warn "postgresql version" "PostgreSQL $newer is on this server too. tando keeps using $ver/main, where the apps' databases are, and does not switch by itself. To move them: docs/COMMANDS.md, Upgrading PostgreSQL"
  else row check ok "postgresql version" "$ver/main (recorded; a newer version is not picked up by itself)"; fi
  x=$(pgsql -c "SELECT string_agg(name, ', ' ORDER BY name) FROM pg_settings WHERE pending_restart" 2> /dev/null)
  if [[ -n $x ]]; then
    row check warn "postgresql settings" "$x wait for a restart (it drops every app's connections for seconds): tando host setup <host> --pg-restart"
  fi
  if [[ -f $PGB_DIR/pgbouncer.ini ]]; then
    if systemctl is-active -q pgbouncer; then row check ok pgbouncer "127.0.0.1:$PGB_PORT, transaction pooling"
    else row check fail pgbouncer "not running: the apps that use it have no database. sudo systemctl start pgbouncer (sudo journalctl -u pgbouncer -n 20 says why)"; fi
  fi
  # the live values: the postmaster and one of its children
  pm=$(head -1 "/run/postgresql/$ver-main.pid" 2> /dev/null)
  [[ $pm =~ ^[0-9]+$ ]] || return 0
  padj=$(cat "/proc/$pm/oom_score_adj" 2> /dev/null)
  kid=$(pgrep -P "$pm" | head -1); kadj=$(cat "/proc/$kid/oom_score_adj" 2> /dev/null)
  if [[ $padj =~ ^-?[0-9]+$ ]] && ((padj <= -900)) && [[ $kadj =~ ^-?[0-9]+$ ]] && ((kadj >= 0 && kadj < 500)); then
    row check ok "postgresql memory" "out of memory, the kernel kills an app first (500), then a connection's process ($kadj), the postmaster last ($padj)"
  else
    row check warn "postgresql memory" "oom_score_adj: postmaster ${padj:-?}, a connection's process ${kadj:-?} (wanted -900 and 0): out of memory, the kernel may kill the whole database server. Run tando host setup <host>, then sudo systemctl restart postgresql in a quiet moment"
  fi
}

db_role() { echo "tando_${A//-/_}"; }

# DB_ROLE and DB_PW from the app's env file (root-owned; never sent to the client unasked)
db_creds() {
  declare -A E
  env_load E
  DB_ROLE=$(db_role)
  DB_URL=${E[DATABASE_URL]:-}
  DB_PW=${DB_URL#postgres://*:}; DB_PW=${DB_PW%%@*}
  [[ -n $DB_URL ]] || die "no DATABASE_URL in the env of $A"
  # where it is: here, or on the data node (PostgreSQL's own port, TLS checked: as_app_pg)
  DB_HOST=127.0.0.1 DB_PORT=5432 DB_SSL=""
  if db_remote; then DB_HOST=${H[db_addr]} DB_SSL=verify-full; fi
}

# db_ensure [deploy]: create the role and database if missing; (re)write DATABASE_URL with a new
# password if absent. deploy (configure): also pgbouncer's databases (pgb_sync), and the URLs by
# the release's db_direct (DB_DIRECT): DATABASE_URL is pgbouncer's (6432) unless db_direct = true
# or pgbouncer does not let the role in (then PostgreSQL's, with a warning: the app works either
# way); DATABASE_URL_DIRECT is always PostgreSQL's (5432). Without deploy (host setup) the URLs
# stay as they are: an app moves to pgbouncer on its next deploy, never under it while it runs.
db_ensure() {
  [[ ${H[postgres]:-} == yes ]] || die "no PostgreSQL on this host: tando host setup <host> postgres=yes"
  pg_pin lock || die "$PG_PIN_ERR"
  local r pw url0 dir0 direct add="" chg="" made=""
  r=$(db_role)
  declare -A E
  env_load E
  url0=${E[DATABASE_URL]-} dir0=${E[DATABASE_URL_DIRECT]-}
  if [[ -n $url0 ]] && [[ $(pgsql -c "SELECT 1 FROM pg_roles WHERE rolname = '$r'") == 1 ]]; then
    pw=${url0#postgres://*:}; pw=${pw%%@*}
  else
    pw=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
    # statements on stdin, so the password never appears in a process list
    if [[ $(pgsql -c "SELECT 1 FROM pg_roles WHERE rolname = '$r'") == 1 ]]; then
      pgsql <<< "ALTER ROLE $r WITH LOGIN PASSWORD '$pw';" || die "could not set the database password"
    else
      pgsql <<< "CREATE ROLE $r WITH LOGIN PASSWORD '$pw';" || die "could not create role $r"
      echo database_created=1
    fi
    if [[ $(pgsql -c "SELECT 1 FROM pg_database WHERE datname = '$r'") != 1 ]]; then
      pgsql -c "CREATE DATABASE $r OWNER $r" || die "could not create database $r"
    fi
    pgsql -c "REVOKE ALL ON DATABASE $r FROM PUBLIC" -c "GRANT CONNECT, TEMPORARY ON DATABASE $r TO $r" ||
      die "could not restrict database $r"
    E[DATABASE_URL]="postgres://$r:$pw@127.0.0.1:5432/$r" made=1
  fi
  if [[ ${1:-} == deploy ]]; then
    # pgbouncer's users and databases: for a new role or password, or one it does not have yet (a
    # pool change follows at the switch: db_follow)
    if [[ -n $made ]] || ! grep -qs "^\"$r\" " "$PGB_DIR/userlist.txt"; then
      pgb_sync || echo "tando-agent: could not update pgbouncer's databases (tando doctor)" >&2
    fi
    direct="postgres://$r:$pw@127.0.0.1:5432/$r"
    E[DATABASE_URL_DIRECT]=$direct E[DATABASE_URL]=$direct
    if [[ ${DB_DIRECT:-} != true && -f $PGB_DIR/pgbouncer.ini ]]; then
      # (asked only when it is not pgbouncer's yet: a deploy of a pooled app asks nothing)
      if [[ $url0 == "postgres://$r:$pw@127.0.0.1:$PGB_PORT/$r" ]] || pgb_ok "$r" "$pw"; then
        E[DATABASE_URL]="postgres://$r:$pw@127.0.0.1:$PGB_PORT/$r"
      else
        echo "tando-agent: pgbouncer does not let $r in: $A connects to PostgreSQL directly for now (tando doctor)" >&2
      fi
    fi
  fi
  [[ -n $url0 ]] || add+=" DATABASE_URL"
  [[ -n $url0 && ${E[DATABASE_URL]} != "$url0" ]] && chg+=" DATABASE_URL"
  [[ -n ${E[DATABASE_URL_DIRECT]-} && -z $dir0 ]] && add+=" DATABASE_URL_DIRECT"
  [[ -n $dir0 && ${E[DATABASE_URL_DIRECT]-} != "$dir0" ]] && chg+=" DATABASE_URL_DIRECT"
  if [[ -n $add$chg ]]; then
    env_save E || die "could not write the env file of $A (disk full?)"
    ENV_NOTE="" envlog_put database "${add# }" "${chg# }" ""
  fi
  db_limits "$r" || die "could not set the limits of role $r"
}
# db_limits role: one app's role holds at most db_pool + DB_TOOL_SLOTS of the server's
# connections (10 by default, as before pgbouncer): a leaking pool cannot take every slot from
# the other apps. Through pgbouncer the app itself gets db_pool; the rest is for its migrations,
# backups, the studio and db psql, which connect directly.
# What one app may take from the cluster all apps share, as defaults of its role (ALTER ROLE ...
# SET: every new connection of the role starts with them). Per app in tando.conf, "off" for none:
#   db_statement_timeout  30s  a statement running longer is cancelled (the connection stays)
#   db_idle_tx_timeout    5m   a connection idle inside a transaction that long is closed: it
#                              holds locks, and old row versions cannot be cleaned up meanwhile
#   db_temp_limit         1G   temporary files of one connection (sorts, hashes): over it the
#                              statement fails, instead of the disk all apps share filling up
# The two timeouts are ordinary settings: a session can SET them (a long migration does: docs).
# PostgreSQL has no way to forbid that, so they stop accidents, not an app that wants to hog.
# temp_file_limit only a superuser can change: the app cannot raise it. lock_timeout is left alone.
# Not under them: tando's backups and restores (pg_dump and pg_restore set the timeouts to 0
# themselves; cmd_backup_restore lifts the temp limit) and tando db psql (cmd_db_psql).
DB_GUC_HINT="a time like 500ms, 30s, 5m, 2h, a size like 512M or 2G for db_temp_limit, or off"
# db_guc key value -> the value as PostgreSQL takes it; 1 when the value is not valid
db_guc() {
  local v=${2:-}
  case $1 in
    db_statement_timeout|db_idle_tx_timeout)
      [[ $v == off ]] && { echo 0; return 0; }
      [[ $v =~ ^[1-9]([0-9]{0,8}ms|[0-9]{0,5}s|[0-9]{0,3}m|[0-9]?h)$ ]] || return 1
      [[ $v == *ms ]] || v=${v/%m/min}; echo "$v";;
    db_temp_limit)
      [[ $v == off ]] && { echo -1; return 0; }
      [[ $v =~ ^[1-9]([0-9]{0,5}M|[0-9]{0,2}G)$ ]] || return 1
      echo "${v}B";;
    *) return 1;;
  esac
}
# db_limits role: the connection limit and the three settings, from app.conf (C) or the defaults.
# What was set is recorded in the state (db_limits=, with db_pool), for db_follow
db_limits() {
  local stv it tf pool=${C[db_pool]:-$DB_POOL}
  stv=$(db_guc db_statement_timeout "${C[db_statement_timeout]:-30s}") &&
    it=$(db_guc db_idle_tx_timeout "${C[db_idle_tx_timeout]:-5m}") &&
    tf=$(db_guc db_temp_limit "${C[db_temp_limit]:-1G}") || return 1
  # the app's database is its role's only: no CONNECT or TEMPORARY for PUBLIC (a database made by
  # an older tando, or by hand, may still have them; host setup and every deploy come here)
  pgsql -c "REVOKE ALL ON DATABASE $1 FROM PUBLIC" -c "GRANT CONNECT, TEMPORARY ON DATABASE $1 TO $1" || return 1
  pgsql -c "ALTER ROLE $1 CONNECTION LIMIT $((pool + DB_TOOL_SLOTS))" -c "ALTER ROLE $1 SET statement_timeout = '$stv'" \
    -c "ALTER ROLE $1 SET idle_in_transaction_session_timeout = '$it'" -c "ALTER ROLE $1 SET temp_file_limit = '$tf'" || return 1
  [[ ${S[db_limits]:-} == "$stv $it $tf $pool" ]] || st db_limits "$stv $it $tf $pool"
}
# db_follow: the role's limits are those of C (the release going live, or the live one again: a
# revert, a rollback, a deploy that did not go live). Configure sets the live release's; this
# changes them only when C's differ from what was set last (db_pool too: pgbouncer's pool follows).
# A failure is a warning: the next deploy or host setup sets them again
db_follow() {
  [[ ${C[database]:-} == postgres && ${H[postgres]:-} == yes ]] || return 0
  local stv it tf pool=${C[db_pool]:-$DB_POOL}
  stv=$(db_guc db_statement_timeout "${C[db_statement_timeout]:-30s}") &&
    it=$(db_guc db_idle_tx_timeout "${C[db_idle_tx_timeout]:-5m}") &&
    tf=$(db_guc db_temp_limit "${C[db_temp_limit]:-1G}") || return 0
  [[ ${S[db_limits]:-} != "$stv $it $tf $pool" ]] || return 0
  [[ ${S[db_limits]:-} == *" $pool" ]] || pgb_sync ||
    echo "tando-agent: could not update pgbouncer's pool of $A (tando doctor)" >&2
  fp db.limits && db_limits "$(db_role)" ||
    echo "tando-agent: could not set the database limits of $A (is PostgreSQL running? tando doctor)" >&2
  return 0
}

db_drop() {
  local r
  r=$(db_role)
  pgsql -c "DROP DATABASE IF EXISTS $r WITH (FORCE)" -c "DROP ROLE IF EXISTS $r" || return 1
  pgb_sync || echo "tando-agent: could not take $r out of pgbouncer (tando doctor)" >&2
}

cmd_db_url() { need_root; app "$1"; [[ ${C[database]:-} == postgres ]] || die "$A has no database"
  db_creds; echo "url=$DB_URL"; }

# db-info app: what the server has for the app's database (the limits as PostgreSQL holds them)
cmd_db_info() {
  need_root; app "$1"; [[ ${C[database]:-} == postgres ]] || die "$A has no database"
  local r k v out q=pgsql; r=$(db_role)
  # (on a data node: asked as the app's own role, which sees its own rows of these)
  db_remote && { db_creds; q="app_psql -d $r"; }
  out=$($q -F ' ' -c "SELECT 'server', current_setting('server_version_num')::int / 10000" \
    -c "SELECT 'size', pg_database_size('$r')" \
    -c "SELECT 'conns', count(*) FROM pg_stat_activity WHERE usename = '$r'" \
    -c "SELECT 'conn_limit', rolconnlimit FROM pg_roles WHERE rolname = '$r'" \
    -c "SELECT replace(unnest(setconfig), '=', ' ') FROM pg_db_role_setting s JOIN pg_roles o ON o.oid = s.setrole
        WHERE o.rolname = '$r' AND s.setdatabase = 0") || die "PostgreSQL does not answer: tando doctor"
  echo "role=$r"
  if db_remote; then echo "cluster=${H[db_host]} (data node)"; else echo "cluster=${H[postgres_version]:-}${H[postgres_version]:+/main}"; fi
  # how the app connects (its env's DATABASE_URL) and its pool there
  local -A E=(); env_load E
  if [[ ${E[DATABASE_URL]:-} == *":$PGB_PORT/"* ]]; then echo "via=pgbouncer"; else echo "via=direct"; fi
  echo "pool=${C[db_pool]:-$DB_POOL}"; echo "db_direct=${C[db_direct]:-false}"
  while read -r k v; do
    case $k in server|size|conns|conn_limit|statement_timeout|idle_in_transaction_session_timeout|temp_file_limit)
      [[ $v =~ ^[A-Za-z0-9.-]+$ ]] && echo "$k=$v";; esac
  done <<< "$out"
}

cmd_db_psql() { # interactive, over ssh -t; runs as the app user with the app's role
  need_root; app "$1"; [[ ${C[database]:-} == postgres ]] || die "$A has no database"
  db_creds
  export PGPASSWORD=$DB_PW PSQL_HISTORY=/dev/null
  [[ -z $DB_SSL ]] || export PGSSLMODE=$DB_SSL PGSSLROOTCERT=$DB_CA
  # a person at a prompt: a long query or a pause inside a transaction is meant, so the role's
  # two timeouts are off in this session (the temp file limit stays: only a superuser lifts it)
  export PGOPTIONS='-c statement_timeout=0 -c idle_in_transaction_session_timeout=0'
  audit_done 0
  cd /tmp && exec runuser -u "$AU" -- psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_ROLE" -d "$DB_ROLE"
}

# >>> data node and remote databases (docs/DATA-NODE.md)
# A data node (host setup role=data) holds PostgreSQL and pgbouncer for app nodes elsewhere. Both
# listen on the node's addresses with TLS (a CA made on the node, or certificates given with
# data_cert/data_key/data_ca); pg_hba admits a project's role from its own app node only
# (hostssl, scram-sha-256); the firewall lets 5432 and 6432 in only from linked app nodes.
# Provisioning comes from the control plane (the operator's tando): data-link registers an app
# node, data-db makes or drops a project's role and database, sets its limits and hands its
# password back once. An app node never holds this node's superuser: it gets the CA (db-link) and,
# per app, the role's password (db-remote-set), and connects with sslmode=verify-full.
# Records here: $DN/nodes/<name> (addr=), $DN/db/<app> (node=, pool=).
DN=$R/data DN_TLS=/etc/tando-data DB_CA=$R/db-ca.pem
# a statement that carries a password is never written to the server's log, not even when it fails
DN_QUIET="SET log_statement = 'none'; SET log_min_error_statement = 'panic'; SET log_min_duration_statement = -1;"
dn_is() { [[ ${H[role]:-} == data ]]; }
valid_node() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$ ]]; }
valid_ip() { [[ $1 =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || ( $1 =~ ^[0-9a-fA-F:]+$ && $1 == *:*:* ) ]]; }
# dn_addrs: the addresses the node's certificate names: its global ones and data_addrs (a private
# or forwarded address app nodes reach it by, recorded by data-link)
dn_addrs() {
  { ip -o addr show scope global 2> /dev/null | awk '{ sub(/\/.*/, "", $4); print $4 }'
    tr ',' '\n' <<< "${H[data_addrs]:-}"; } | grep . | sort -u
}
# dn_tls: the CA (made once, kept on the node: its key never leaves) and the server certificate,
# made again when the addresses it must name change or it expires within 30 days. DN_TLS_NEW=1
# then. Given certificates (data_tls=provided) are left as they are.
dn_tls() {
  local san="" a
  DN_TLS_NEW=""
  install -d -m 750 -o root -g postgres "$DN_TLS" || return 1
  [[ ${H[data_tls]:-} == provided ]] && return 0
  if [[ ! -s $DN_TLS/ca.key || ! -s $DN_TLS/ca.pem ]]; then
    (umask 077; openssl req -x509 -new -nodes -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -sha256 -days 3650 \
      -subj "/CN=tando data node CA" -keyout "$DN_TLS/ca.key" -out "$DN_TLS/ca.pem" 2> /dev/null) || return 1
    chmod 644 "$DN_TLS/ca.pem"
  fi
  for a in $(dn_addrs); do san+="${san:+,}IP:$a"; done
  san+="${san:+,}DNS:localhost"
  if [[ -s $DN_TLS/server.pem && $(cat "$DN_TLS/server.san" 2> /dev/null) == "$san" ]] &&
     openssl x509 -checkend 2592000 -noout -in "$DN_TLS/server.pem" > /dev/null 2>&1; then return 0; fi
  (umask 077; openssl req -new -nodes -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -sha256 -subj "/CN=tando data node" \
    -keyout "$DN_TLS/.server.key" -out "$DN_TLS/.server.csr" 2> /dev/null &&
   openssl x509 -req -sha256 -days 825 -in "$DN_TLS/.server.csr" -CA "$DN_TLS/ca.pem" -CAkey "$DN_TLS/ca.key" -set_serial "0x$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')" \
     -extfile <(printf 'subjectAltName=%s\nbasicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\n' "$san") \
     -out "$DN_TLS/.server.pem" 2> /dev/null) || { rm -f "$DN_TLS"/.server.*; return 1; }
  chown root:postgres "$DN_TLS/.server.key" && chmod 640 "$DN_TLS/.server.key" && chmod 644 "$DN_TLS/.server.pem" &&
    mv -f "$DN_TLS/.server.key" "$DN_TLS/server.key" && mv -f "$DN_TLS/.server.pem" "$DN_TLS/server.pem" || return 1
  rm -f "$DN_TLS/.server.csr"
  echo "$san" > "$DN_TLS/server.san"
  DN_TLS_NEW=1
}
# dn_tls_given cert key ca: certificates of the operator's own CA (host setup data_cert= ...)
dn_tls_given() {
  [[ -f $1 && -f $2 && -f $3 ]] || die "data_cert, data_key and data_ca must all be files on the server"
  openssl x509 -noout -in "$1" 2> /dev/null && openssl x509 -noout -in "$3" 2> /dev/null || die "data_cert and data_ca must be PEM certificates"
  [[ $(openssl x509 -noout -pubkey -in "$1" | sha256sum) == "$(openssl pkey -pubout -in "$2" 2> /dev/null | sha256sum)" ]] ||
    die "data_key is not the key of data_cert"
  openssl verify -CAfile "$3" "$1" > /dev/null 2>&1 || die "data_cert is not signed by data_ca"
  install -d -m 750 -o root -g postgres "$DN_TLS" || die "could not create $DN_TLS"
  install -m 640 -o root -g postgres "$2" "$DN_TLS/server.key" && install -m 644 "$1" "$DN_TLS/server.pem" &&
    install -m 644 "$3" "$DN_TLS/ca.pem" || die "could not copy the certificates"
  rm -f "$DN_TLS/ca.key" "$DN_TLS/server.san"
  H[data_tls]=provided
}
# dn_hba: who may connect, from the records: one hostssl line per project, from its app node's
# address only, for its own database and its drill database (tdrill_). In PostgreSQL's pg_hba.conf
# (a marked block at its end, after the package's local lines) and in pgbouncer's hba file.
DN_HBA_BEGIN="# >>> tando data node (written by tando: edits inside this block do not last)"
DN_HBA_END="# <<< tando data node"
dn_hba() {
  local f a app node addr r m pl="" lines="" t
  for f in "$DN"/db/*; do
    [[ -f $f ]] || continue
    app=${f##*/}; valid_app "$app" || continue
    node=$(sed -n 's/^node=//p' "$f"); valid_node "$node" || continue
    addr=$(sed -n 's/^addr=//p' "$DN/nodes/$node" 2> /dev/null); valid_ip "$addr" || continue
    r=tando_${app//-/_} m=32; [[ $addr == *:* ]] && m=128
    lines+="hostssl $r,tdrill_${app//-/_} $r $addr/$m scram-sha-256"$'\n'
    pl+="hostssl $r $r $addr/$m scram-sha-256"$'\n'
  done
  f=$(pgsql -c "SHOW hba_file") && [[ -f $f ]] || return 1
  t=$(mktemp "$f.XXXXXX") || return 1
  { awk -v b="$DN_HBA_BEGIN" -v e="$DN_HBA_END" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$f"
    echo "$DN_HBA_BEGIN"; printf '%s' "$lines"; echo "$DN_HBA_END"; } > "$t" || { rm -f "$t"; return 1; }
  if cmp -s "$t" "$f"; then rm -f "$t"
  else
    chown --reference="$f" "$t" && chmod --reference="$f" "$t" && mv -f "$t" "$f" || { rm -f "$t"; return 1; }
    pgsql -c "SELECT pg_reload_conf()" > /dev/null || return 1
  fi
  [[ -d $PGB_DIR ]] || return 0
  PGB_CHANGED=""
  pgb_put "$PGB_DIR/hba.tando" < <(echo "# written by tando (data node): pgbouncer's own checks, local first"
    echo "host all all 127.0.0.1/32 scram-sha-256"; printf '%s' "$pl") || return 1
  if [[ -n $PGB_CHANGED ]] && systemctl is-active -q pgbouncer; then systemctl reload pgbouncer || return 1; fi
  return 0
}
# dn_reload_tls: a new certificate: PostgreSQL and pgbouncer read it again (a reload: connections stay)
dn_reload_tls() {
  pgsql -c "SELECT pg_reload_conf()" > /dev/null || return 1
  systemctl is-active -q pgbouncer && { systemctl reload pgbouncer || return 1; }
  return 0
}
# dn_setup (host setup role=data, after PostgreSQL is installed): the certificates, then the
# listening sockets (pg_tune, pgb_sync read role=data), pg_hba and the firewall. DN_DETAIL: the line.
dn_setup() {
  # the firewall before anything listens beyond the loopback (no nft: no data node)
  command -v nft > /dev/null || die "a data node needs nftables (its firewall), which host setup installs: run it again"
  fw_sync || die "could not load the firewall rules"
  dn_tls || die "could not make the data node's certificates (openssl)"
  pg_tune || die "$PG_TUNE_ERR"
  ( pgb_sync ) || die "could not configure pgbouncer for the data node"
  # pgbouncer reads listen_addr only when it starts
  if ! ss -Hltn 'sport = :6432' 2> /dev/null | awk '{ print $4 }' | grepq -E '^(0\.0\.0\.0|\*|\[::\]):6432$'; then
    systemctl restart pgbouncer || die "pgbouncer did not start: sudo journalctl -u pgbouncer -n 20 says why"
  fi
  [[ -n $DN_TLS_NEW ]] && { dn_reload_tls || die "PostgreSQL did not take the new certificate"; }
  dn_hba || die "could not write pg_hba.conf"
  # the server certificate is made again 30 days before it expires (data-renew, daily), not only
  # when setup or link run: an expired one would refuse every app node (verify-full)
  write_if_changed /etc/systemd/system/tando-data-renew.service <<EOF || die "could not write the renewal unit"
[Unit]
Description=tando: renew the data node's server certificate before it expires

[Service]
Type=oneshot
ExecStart=$AGENT data-renew
EOF
  write_if_changed /etc/systemd/system/tando-data-renew.timer <<EOF || die "could not write the renewal timer"
[Unit]
Description=tando: renew the data node's server certificate (daily check)

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF
  { systemctl daemon-reload && systemctl enable -q --now tando-data-renew.timer; } || die "could not enable tando-data-renew.timer"
  local n=0 p=0 f
  for f in "$DN"/nodes/*; do [[ -f $f ]] && n=$((n + 1)); done
  for f in "$DN"/db/*; do [[ -f $f ]] && p=$((p + 1)); done
  DN_DETAIL="PostgreSQL 5432 and pgbouncer 6432 with TLS ($([[ ${H[data_tls]:-} == provided ]] && echo "given certificates" || echo "CA made on this node")) on $(dn_addrs | tr '\n' ' ' | sed 's/ $//'); $n app node$( ((n == 1)) || echo s) linked, $p project$( ((p == 1)) || echo s)"
  [[ -n ${PG_PENDING:-} ]] && DN_DETAIL+="; $PG_PENDING wait for a restart (tando host setup <host> --pg-restart)"
  return 0
}

# data-renew (tando-data-renew.timer): a server certificate that expires within 30 days, or no
# longer names the node's addresses, is made again and read by a reload
cmd_data_renew() {
  need_root; load "$R/host.conf" H
  dn_is || return 0
  dn_tls || die "could not renew the data node's certificate (openssl)"
  [[ -n $DN_TLS_NEW ]] && { dn_reload_tls || die "PostgreSQL did not take the new certificate"; echo "renewed=1"; }
  return 0
}
# dn_doctor: rows for tando doctor on a data node (the certificate's days left)
dn_doctor() {
  local end days
  end=$(openssl x509 -noout -enddate -in "$DN_TLS/server.pem" 2> /dev/null | sed 's/^notAfter=//')
  if [[ -z $end ]]; then row check fail "data node certificate" "missing: tando host setup <host> role=data makes it"; return 0; fi
  days=$(( ($(date -d "$end" +%s) - $(now)) / 86400 ))
  if ((days < 14)); then row check fail "data node certificate" "expires in $days days: tando host setup <host> renews it (a given certificate: replace it, data_cert=)"
  elif ((days < 30)); then row check warn "data node certificate" "expires in $days days; $([[ ${H[data_tls]:-} == provided ]] && echo "a given certificate: replace it (data_cert=)" || echo "tando-data-renew.timer renews it")"
  else row check ok "data node certificate" "$days days left$(systemctl is-enabled -q tando-data-renew.timer 2> /dev/null && echo "; renewed daily by tando-data-renew.timer")"; fi
}
# data-link <node> <addr> [data_addr]: an app node may connect from addr; prints the CA to pin
# (ca=, base64) and the address it reaches this node by (addr=)
cmd_data_link() {
  need_root; host_lock; load "$R/host.conf" H
  dn_is || die "<host> is not a data node: tando host setup <host> role=data"
  local name=${1:-} addr=${2:-} via=${3:-} move="" old f
  [[ ${4:-} == move=1 || $via == move=1 ]] && move=1; [[ $via == move=1 ]] && via=""
  valid_node "$name" || die "bad app node name: $name"
  valid_ip "$addr" || die "bad address of the app node: $addr (an IP address)"
  # the same name at another address: its projects would follow the new server; only on purpose
  old=$(sed -n 's/^addr=//p' "$DN/nodes/$name" 2> /dev/null)
  if [[ -n $old && $old != "$addr" && -z $move ]]; then
    for f in "$DN"/db/*; do
      [[ -f $f ]] && grepq -x "node=$name" "$f" &&
        die "app node $name is linked from $old and has projects here: linking $addr would hand them to that server. If it moved: tando host link ... --move"
    done
  fi
  [[ -z $via ]] || valid_ip "$via" || die "bad address of the data node: $via (an IP address)"
  [[ -n $via ]] || via=$(ip -o route get 1.1.1.1 2> /dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
  valid_ip "$via" || die "this node has no default route: give the address app nodes reach it by (data_addr=)"
  if ! dn_addrs | grepq -Fx "$via"; then H[data_addrs]=${H[data_addrs]:+${H[data_addrs]},}$via; save "$R/host.conf" H; fi
  install -d -m 700 "$DN" "$DN/nodes" "$DN/db"
  printf 'addr=%s\n' "$addr" > "$DN/nodes/$name.tmp" && mv -f "$DN/nodes/$name.tmp" "$DN/nodes/$name" || die "could not record $name (disk full?)"
  dn_tls || die "could not make the data node's certificates (openssl)"
  [[ -n $DN_TLS_NEW ]] && { dn_reload_tls || die "PostgreSQL did not take the new certificate"; }
  if [[ ${H[data_tls]:-} == provided ]] && ! openssl x509 -noout -checkip "$via" -in "$DN_TLS/server.pem" 2> /dev/null | grepq 'does match'; then
    echo "tando-agent: the given certificate does not name $via: app nodes will refuse it (sslmode=verify-full)" >&2
  fi
  dn_hba || die "could not write pg_hba.conf"
  fw_sync || die "could not load the firewall rules"
  echo "addr=$via"
  echo "ca=$(base64 -w0 < "$DN_TLS/ca.pem")"
}
# data-ca: the SHA-256 fingerprint of the CA app nodes pin (the client checks its link record)
cmd_data_ca() {
  need_root; load "$R/host.conf" H
  dn_is || die "<host> is not a data node"
  echo "ca=$(openssl x509 -noout -fingerprint -sha256 -in "$DN_TLS/ca.pem" 2> /dev/null | sed 's/.*=//')"
}
# data-unlink <node>: refused while projects of it are here (data-db drop them first)
cmd_data_unlink() {
  need_root; host_lock; load "$R/host.conf" H
  dn_is || die "<host> is not a data node"
  local name=${1:-} f
  valid_node "$name" || die "bad app node name: $name"
  for f in "$DN"/db/*; do [[ -f $f ]] && grepq -x "node=$name" "$f" && die "${f##*/} of $name still has its database here: tando destroy it first"; done
  rm -f "$DN/nodes/$name"
  dn_hba || die "could not write pg_hba.conf"
  fw_sync || die "could not load the firewall rules"
  echo "unlinked=$name"
}
# data-db ensure <app> <node> [pool=N st=T it=T tf=S] [new=1] | drop <app> <node> | ls
# ensure: the role and database (and the empty drill database tdrill_<app>, which the app node's
# restore drill restores into with the app's own role), its limits, pg_hba and pgbouncer. A new
# role, or new=1 (the app node has no password for it), gets a new password: printed once
# (password=), never stored here.
cmd_data_db() {
  need_root; load "$R/host.conf" H
  dn_is || die "<host> is not a data node: tando host setup <host> role=data"
  local op=${1:-} app=${2:-} node=${3:-} kv pool=$DB_POOL st=30s it=5m tf=1G new="" r d pw owner
  [[ $op == ls ]] && { cmd_data_db_ls; return; }
  valid_app "$app" || die "invalid app name"
  valid_node "$node" || die "bad app node name: $node"
  shift 3
  for kv in "$@"; do
    case $kv in
      pool=*) [[ ${kv#*=} =~ ^[1-9][0-9]{0,2}$ ]] || die "bad $kv"; pool=${kv#*=};;
      st=*) st=${kv#*=};; it=*) it=${kv#*=};; tf=*) tf=${kv#*=};;
      new=1) new=1;;
      *) die "bad setting: $kv";;
    esac
  done
  r=tando_${app//-/_} d=tdrill_${app//-/_}
  # the limits are the tando.conf values the operator's client sends (never an app node's), in
  # the data node's bounds (dn_policy): one project cannot take the connections, the disk or a
  # statement without end from the others
  if [[ $op == ensure ]]; then
    dn_policy "$app" "$pool" "$st" "$it" "$tf" || die "$DN_WHY"
    st=$DN_ST it=$DN_IT tf=$DN_TF
  fi
  lockfile "$R/.data.lock"; exec 13>"$R/.data.lock"; flock -w 60 13 || die "another data-db call holds the lock"
  owner=$(sed -n 's/^node=//p' "$DN/db/$app" 2> /dev/null)
  case $op in
    ensure)
      [[ -f $DN/nodes/$node ]] || die "app node $node is not linked to <host>: tando host link $node <host>"
      [[ -z $owner || $owner == "$node" ]] || die "the database of $app here belongs to app node $owner (an app name is one project on a data node)"
      if [[ $(pgsql -c "SELECT 1 FROM pg_roles WHERE rolname = '$r'") != 1 ]]; then
        pw=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
        pgsql <<< "$DN_QUIET CREATE ROLE $r WITH LOGIN PASSWORD '$pw';" || die "could not create role $r"
        echo "created=1"
      elif [[ -n $new ]]; then
        pw=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
        pgsql <<< "$DN_QUIET ALTER ROLE $r WITH LOGIN PASSWORD '$pw';" || die "could not set the password of $r"
      fi
      local x
      for x in "$r" "$d"; do
        if [[ $(pgsql -c "SELECT 1 FROM pg_database WHERE datname = '$x'") != 1 ]]; then
          pgsql -c "CREATE DATABASE $x OWNER $r" || die "could not create database $x"
        fi
        pgsql -c "REVOKE ALL ON DATABASE $x FROM PUBLIC" -c "GRANT CONNECT, TEMPORARY ON DATABASE $x TO $r" ||
          die "could not restrict database $x"
        # (and its schema public: no USAGE for other roles either; the catalog itself, the names
        # of databases and roles, stays readable to every role: docs/DATA-NODE.md)
        # (the project's role owns it first: on PostgreSQL 14 and older public belongs to the
        # superuser, and the revoke would take the role's own CREATE and USAGE, failing migrations)
        pgsql -d "$x" -c "ALTER SCHEMA public OWNER TO $r" -c "REVOKE ALL ON SCHEMA public FROM PUBLIC" > /dev/null ||
          die "could not restrict the schema of $x"
      done
      pgsql -c "COMMENT ON DATABASE $d IS '$DRILL_MARK'" > /dev/null || die "could not mark $d"
      # the per-role limits (as db_limits on a single node; docs/CONFIG.md "Database limits")
      pgsql -c "ALTER ROLE $r CONNECTION LIMIT $((pool + DB_TOOL_SLOTS))" -c "ALTER ROLE $r SET statement_timeout = '$st'" \
        -c "ALTER ROLE $r SET idle_in_transaction_session_timeout = '$it'" -c "ALTER ROLE $r SET temp_file_limit = '$tf'" ||
        die "could not set the limits of $r"
      printf 'node=%s\npool=%s\n' "$node" "$pool" > "$DN/db/$app.tmp" && mv -f "$DN/db/$app.tmp" "$DN/db/$app" ||
        die "could not record $app (disk full?)"
      ( A="" pgb_sync ) || echo "tando-agent: could not update pgbouncer's databases (tando doctor)" >&2
      dn_hba || die "could not write pg_hba.conf"
      fw_sync || die "could not load the firewall rules"
      echo "role=$r"
      [[ -n ${pw:-} ]] && echo "password=$pw"
      return 0;;
    drop)
      [[ -z $owner || $owner == "$node" ]] || die "the database of $app here belongs to app node $owner, not $node"
      pgsql -c "DROP DATABASE IF EXISTS $r WITH (FORCE)" -c "DROP DATABASE IF EXISTS $d WITH (FORCE)" -c "DROP ROLE IF EXISTS $r" ||
        die "could not drop the database of $app"
      rm -f "$DN/db/$app"
      ( A="" pgb_sync ) || echo "tando-agent: could not take $r out of pgbouncer (tando doctor)" >&2
      dn_hba || die "could not write pg_hba.conf"
      fw_sync || echo "tando-agent: could not load the firewall rules (tando host setup <host>)" >&2
      echo "dropped=$r";;
    *) die "data-db ensure|drop|ls";;
  esac
}
# dn_policy app pool st it tf (tando.conf forms: 30s, 5m, 1G): the data node's bounds, host setup
# data_pool_max= (default 20 server connections a project), data_temp_max= (default 8G), and
# timeouts that are never off and at most data_timeout_max= (default 1h). Every project's pool
# plus its tool slots must fit in max_connections less the superuser's. Sets DN_ST DN_IT DN_TF
# (PostgreSQL's forms) or DN_WHY.
DN_POOL_MAX=20 DN_TEMP_MAX=8G DN_TIMEOUT_MAX=1h
dn_secs() { local v=$1; case $v in *ms) echo $(( ${v%ms} / 1000 ));; *s) echo "${v%s}";; *m) echo $(( ${v%m} * 60 ));; *h) echo $(( ${v%h} * 3600 ));; esac; }
dn_mb() { local v=$1; case $v in *M) echo "${v%M}";; *G) echo $(( ${v%G} * 1024 ));; esac; }
dn_policy() {
  local app=$1 pool=$2 pmax=${H[data_pool_max]:-$DN_POOL_MAX} tmax=${H[data_temp_max]:-$DN_TEMP_MAX} omax=${H[data_timeout_max]:-$DN_TIMEOUT_MAX} k v f sum=0 max p
  DN_WHY=""
  ((pool >= 1 && pool <= pmax)) || { DN_WHY="db_pool $pool is over the data node's limit of $pmax (host setup <host> data_pool_max=N)"; return 1; }
  for k in ST:$3 IT:$4; do
    v=${k#*:}; k=${k%%:*}
    [[ $v == off ]] && { DN_WHY="the database timeouts cannot be off on a data node (db_statement_timeout, db_idle_tx_timeout)"; return 1; }
    f=$(db_guc db_statement_timeout "$v") || { DN_WHY="bad database timeout: $v ($DB_GUC_HINT)"; return 1; }
    (( $(dn_secs "$v") <= $(dn_secs "$omax") )) || { DN_WHY="a database timeout of $v is over the data node's $omax (host setup <host> data_timeout_max=)"; return 1; }
    printf -v "DN_$k" '%s' "$f"
  done
  [[ $5 == off ]] && { DN_WHY="db_temp_limit cannot be off on a data node: its disk is every project's"; return 1; }
  DN_TF=$(db_guc db_temp_limit "$5") || { DN_WHY="bad db_temp_limit: $5 ($DB_GUC_HINT)"; return 1; }
  (( $(dn_mb "$5") <= $(dn_mb "$tmax") )) || { DN_WHY="db_temp_limit $5 is over the data node's $tmax (host setup <host> data_temp_max=)"; return 1; }
  # every project's pool and tool slots in max_connections (this one's new pool counted)
  for f in "$DN"/db/*; do
    [[ -f $f && ${f##*/} != "$app" ]] || continue
    p=$(sed -n 's/^pool=//p' "$f"); [[ $p =~ ^[0-9]+$ ]] || p=$DB_POOL
    sum=$((sum + p + DB_TOOL_SLOTS))
  done
  sum=$((sum + pool + DB_TOOL_SLOTS))
  max=$(pgsql -c "SELECT current_setting('max_connections')::int - current_setting('superuser_reserved_connections')::int" 2> /dev/null)
  [[ $max =~ ^[0-9]+$ ]] && ((sum > max)) && { DN_WHY="the projects' pools would need $sum connections and the data node has $max (a larger node, or host setup <host> pg_max_connections=N)"; return 1; }
  return 0
}
# data-db ls: one line per project: app, node, size, connections now, the role's limit
cmd_data_db_ls() {
  local rows f app node
  rows=$(pgsql -F ' ' -c "SELECT r.rolname, coalesce(pg_database_size(d.oid), 0), (SELECT count(*) FROM pg_stat_activity a WHERE a.usename = r.rolname), r.rolconnlimit
    FROM pg_roles r LEFT JOIN pg_database d ON d.datname = r.rolname WHERE r.rolname LIKE 'tando\_%'") || die "PostgreSQL does not answer"
  for f in "$DN"/db/*; do
    [[ -f $f ]] || continue
    app=${f##*/}; node=$(sed -n 's/^node=//p' "$f")
    awk -v r="tando_${app//-/_}" -v a="$app" -v n="$node" '$1 == r { print "row", a, n, $2, $3, $4 }' <<< "$rows"
  done
}

# ---- an app node whose databases are on a data node (host link) ------------------------------
# db_remote: this app's database is on the data node (database = postgres on a linked host)
db_remote() { [[ -n ${H[db_host]:-} && ${C[database]:-} == postgres ]]; }
# db-link <data-node> <addr> <node-name>: stdin is the data node's CA (pinned in $DB_CA, readable
# by the apps: their sslrootcert). Refused while an app here has a local database.
cmd_db_link() {
  need_root; host_lock; load "$R/host.conf" H
  local name=${1:-} addr=${2:-} me=${3:-} ca a
  valid_node "$name" || die "bad data node name: $name"
  valid_ip "$addr" || die "bad address of the data node: $addr"
  valid_node "$me" || die "bad name of this node: $me"
  dn_is && die "<host> is a data node itself"
  ca=$(head -c 20000)
  [[ $ca == *"-----BEGIN CERTIFICATE-----"* ]] && openssl x509 -noout <<< "$ca" 2> /dev/null || die "the data node's CA is not a PEM certificate"
  if [[ -z ${H[db_host]:-} ]]; then
    for a in "$R"/apps/*/app.conf; do
      [[ -f $a ]] && grepq -x 'database=postgres' "$a" || continue
      a=${a%/app.conf}; die "${a##*/} has its database on this server: an app node with local databases cannot be linked yet (docs/DATA-NODE.md)"
    done
  fi
  command -v pg_dump > /dev/null || apt_install postgresql-client
  printf '%s\n' "$ca" > "$DB_CA.tmp" && chmod 644 "$DB_CA.tmp" && mv -f "$DB_CA.tmp" "$DB_CA" || die "could not write $DB_CA"
  H[db_host]=$name H[db_addr]=$addr H[db_node]=$me
  save "$R/host.conf" H; chmod 644 "$R/host.conf"
  fw_sync || die "could not load the firewall rules"
  studio_setup || die "could not let the studio reach the data node (sudo journalctl -u tando-studio shows why)"
  echo "db_host=$name"
}
# db_remote_urls pw: the app's URLs on the data node: DATABASE_URL through pgbouncer (6432) unless
# db_direct = true, DATABASE_URL_DIRECT to PostgreSQL (5432); TLS checked against the pinned CA
db_remote_urls() {
  local r h=${H[db_addr]} q="sslmode=verify-full&sslrootcert=$DB_CA"
  r=$(db_role); [[ $h == *:* ]] && h="[$h]"
  E[DATABASE_URL_DIRECT]="postgres://$r:$1@$h:5432/$r?$q"
  if [[ ${C[db_direct]:-} == true ]]; then E[DATABASE_URL]=${E[DATABASE_URL_DIRECT]}
  else E[DATABASE_URL]="postgres://$r:$1@$h:$PGB_PORT/$r?$q"; fi
}
# db_remote_conf (configure, C = the deploy's settings): the URLs follow db_addr and db_direct when
# the app has its password; prints what the client needs to provision on the data node
db_remote_conf() {
  db_remote || return 0
  local -A E=(); env_load E
  local u=${E[DATABASE_URL]-} d=${E[DATABASE_URL_DIRECT]-} pw stv it tf
  echo "db_remote=${H[db_host]}"; echo "db_node=${H[db_node]:-}"
  stv=$(db_guc db_statement_timeout "${C[db_statement_timeout]:-30s}") && it=$(db_guc db_idle_tx_timeout "${C[db_idle_tx_timeout]:-5m}") &&
    tf=$(db_guc db_temp_limit "${C[db_temp_limit]:-1G}") || die "bad database limit ($DB_GUC_HINT)"
  echo "db_pool=${C[db_pool]:-$DB_POOL}"; echo "db_st=$stv"; echo "db_it=$it"; echo "db_tf=$tf"
  if [[ $u == postgres://*:*@* ]]; then
    pw=${u#postgres://*:}; pw=${pw%%@*}
    db_remote_urls "$pw"
    if [[ ${E[DATABASE_URL]} != "$u" || ${E[DATABASE_URL_DIRECT]} != "$d" ]]; then
      env_save E || die "could not write the env file of $A (disk full?)"
      ENV_NOTE="" envlog_put database "" "DATABASE_URL DATABASE_URL_DIRECT" ""
    fi
    echo "db_url=1"
  else echo "db_url=0"; fi
}
# db-remote-set <app>: stdin password=<the role's new password, from data-db>: the URLs in its env
cmd_db_remote_set() {
  need_root; app "$1"; db_remote || die "$A has no database on a data node"
  local l pw="" add=""
  while IFS= read -r l; do [[ $l == password=* ]] && pw=${l#password=}; done
  [[ $pw =~ ^[0-9a-f]{32,64}$ ]] || die "no password given"
  lock 300
  local -A E=(); env_load E
  [[ -n ${E[DATABASE_URL]-} ]] || add=1
  db_remote_urls "$pw"
  env_save E || die "could not write the env file of $A (disk full?)"
  if [[ -n $add ]]; then ENV_NOTE="" envlog_put database "DATABASE_URL DATABASE_URL_DIRECT" "" ""
  else ENV_NOTE="" envlog_put database "" "DATABASE_URL DATABASE_URL_DIRECT" ""; fi
  echo "db_url=1"
}
# app_psql args...: psql as the app's role, where its database is (db_creds first)
app_psql() { as_app_pg psql -X -q -At -v ON_ERROR_STOP=1 -h "$DB_HOST" -p "$DB_PORT" -U "$DB_ROLE" "$@"; }

# >>> db studio: `tando db studio` (srv/studio, tando-studio; docs/STUDIO.md, docs/ARCHITECTURE.md "db studio")
# One always-on service per server, tando-studio.service (studio_setup, run by host setup): a front
# as root with CAP_SETUID and CAP_SETGID only, on unix sockets only, that starts a helper per app
# and browser session as the app's user (the per-app studio: read-only, the scope guard, its
# limits), on demand; idle, it holds no helper and no database connection. The agent mints the
# one-time codes (db-studio-code, admin logins only) through the front's ctl socket, and hands
# each admin their own socket (/run/tando-studio/u/<login>/s, 0600 owned by the login: their
# ssh -L reaches it, nobody else's). The front never reads an env file or a password: a helper
# reads its own app's DATABASE_URL (the env is root:<app group> 0640).
# units_unload unit...: wait until these units have ended (60 s at most) and are no longer loaded
# (3 s more); systemd
# unloads a unit nothing references on its next garbage collection pass; seen on systemd 259: a
# transient unit stopped while a `systemd-run --wait` held a reference stayed "loaded inactive
# dead" with no reference, job, process or cgroup (its transient file kept), through a stop,
# until a daemon-reload, whose pass unloaded it at once. So: a reload when one is still there.
units_unload() {
  local i
  # first until they have ended (60 s at most: a studio whose laptop went away ends within its
  # heartbeat; a unit still running then is not ours to unload), then 3 s for systemd to unload
  # them by itself, then one reload
  for ((i = 0; i < 300; i++)); do
    [[ -z $(systemctl list-units --all --plain --no-legend --state=active,activating,deactivating,reloading "$@" 2> /dev/null) ]] && break
    sleep 0.2
  done
  ((i < 300)) || return 0
  for ((i = 0; i < 15; i++)); do
    [[ -z $(systemctl list-units --all --plain --no-legend "$@" 2> /dev/null) ]] && return 0
    sleep 0.2
  done
  systemctl daemon-reload
}
STUDIO=$R/bin/tando-studio STUDIO_RUN=/run/tando-studio
studio_ctl() { "$STUDIO" ctl "$@" 2> /dev/null; }   # one request to the service's front
studio_rows() { # the service: studio <tokens> <helpers: app,app|-> (nothing when it does not run)
  local l; l=$(studio_ctl ls) || return 0
  [[ $l =~ ^tokens=([0-9]+)\ helpers=([a-z0-9,-]+)$ ]] && row studio "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  return 0
}
# studio_setup: (host setup) the service's units; what the per-session studios of older versions
# left (their transient units, credentials, session directories) goes first. The restart loads a
# new binary and revokes every token (docs/STUDIO.md).
studio_setup() {
  [[ -x $STUDIO ]] || return 0
  local u us=()
  while IFS= read -r u; do [[ -n $u ]] && us+=("$u"); done < <(systemctl list-units --all --plain --no-legend 'tando-*-studio-*' 2> /dev/null | awk '{ print $1 }')
  ((${#us[@]})) && systemctl stop "${us[@]}" 2> /dev/null
  rm -rf /run/tando/studio
  [[ -d $STUDIO_RUN ]] && find "$STUDIO_RUN" -mindepth 1 -maxdepth 1 -regextype egrep -regex '.*/[0-9a-f]{32}' -exec rm -rf {} + 2> /dev/null
  local p=() x
  for x in ${SD_HARD[@]+"${SD_HARD[@]}"}; do [[ $x == RestrictAddressFamilies=* ]] || p+=("$x"); done
  write_if_changed /etc/systemd/system/tando-studio.service <<EOF || return 1
[Unit]
Description=tando: database studio (tando db studio; docs/STUDIO.md)
After=network.target postgresql.service

[Service]
ExecStart=$STUDIO service
Restart=always
RestartSec=2
# root for one thing: starting a helper as an app's user (no file, network or system capability)
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
RuntimeDirectory=tando-studio
RuntimeDirectoryMode=0711
UMask=0077
# unix sockets only; the helpers reach PostgreSQL on 127.0.0.1 (as their app's uid: fw_sync)
RestrictAddressFamilies=AF_UNIX AF_INET
SocketBindDeny=any
IPAddressDeny=any
IPAddressAllow=localhost
# (and the data node, when the apps' databases are there: docs/DATA-NODE.md)
${H[db_addr]:+IPAddressAllow=${H[db_addr]}}
MemoryMax=128M
MemorySwapMax=0
TasksMax=64
CPUWeight=20
Nice=10
IOSchedulingClass=idle
OOMScoreAdjust=500
Environment=GOMAXPROCS=1 GOMEMLIMIT=16MiB
$(printf '%s\n' ${p[@]+"${p[@]}"})

[Install]
WantedBy=multi-user.target
EOF
  # a helper's database backend: its pid, dropped in lower/ by the front, checked and lowered by root
  write_if_changed /etc/systemd/system/tando-studio-lower.path <<EOF || return 1
[Unit]
Description=tando: lower the priority of the studio's database processes

[Path]
DirectoryNotEmpty=$STUDIO_RUN/lower

[Install]
WantedBy=multi-user.target
EOF
  write_if_changed /etc/systemd/system/tando-studio-lower.service <<EOF || return 1
[Unit]
Description=tando: lower the priority of the studio's database processes

[Service]
Type=oneshot
ExecStart=$AGENT db-studio-lower
EOF
  systemctl daemon-reload && systemctl enable -q tando-studio.service tando-studio-lower.path &&
    systemctl restart tando-studio.service && systemctl restart tando-studio-lower.path
}
# studio_lower pid: the studio said its PostgreSQL backend is <pid>. Never taken on trust: the pid
# must be a process of the postgres user whose parent is this cluster's postmaster, whose title
# names this app's role and database, and which PostgreSQL itself lists as this role's session
# from the studio (application_name). Then it is moved into a scope of its own at the top of the
# cgroup tree with CPUWeight=1 and IOWeight=1 (against 100 for system.slice, where PostgreSQL and
# the app's backends are, and for tando.slice, where the apps are): on a busy CPU it gets about 1%,
# on an idle one all of it. No memory limit on it: an OOM kill of a backend makes the postmaster
# restart every session of every app; its memory is bounded by its settings (srv/studio). Nice 19
# and the idle I/O class besides (the I/O class only counts with BFQ; PostgreSQL 18's io workers
# do most reads anyway). The scope goes when the backend exits; checked again for every new
# connection. The studio itself runs at Nice=10, CPUWeight=50.
studio_lower() {
  local pid=$1 r=$DB_ROLE v=${H[postgres_version]:-} pm t
  [[ $pid =~ ^[1-9][0-9]{0,9}$ ]] || return 1
  pm=$(head -1 "/run/postgresql/$v-main.pid" 2> /dev/null)
  [[ $pm =~ ^[0-9]+$ && $(stat -c %U "/proc/$pid" 2> /dev/null) == postgres ]] || return 1
  [[ $(awk '$1 == "PPid:" { print $2 }' "/proc/$pid/status" 2> /dev/null) == "$pm" ]] || return 1
  t=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2> /dev/null)
  [[ $t == "postgres: $v/main: $r $r 127.0.0.1("* ]] || return 1
  [[ $(pgsql -c "SELECT count(*) FROM pg_stat_activity WHERE pid = $pid AND usename = '$r' AND datname = '$r' AND application_name LIKE 'tando studio (%'") == 1 ]] || return 1
  busctl call -- org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager \
    StartTransientUnit 'ssa(sv)a(sa(sv))' "tando-$A-studiodb-$pid.scope" fail 5 PIDs au 1 "$pid" Slice s -.slice \
    CPUWeight t 1 IOWeight t 1 Description s "tando studio $A: its database process" 0 > /dev/null 2>&1 || return 1
  renice -n 19 -p "$pid" > /dev/null 2>&1 && ionice -c 3 -p "$pid" > /dev/null 2>&1
}
# db-studio: the per-session verb of older clients
cmd_db_studio() {
  die "the studio on <host> is now one service for the whole server: update tando on this computer, then tando db studio again"
}
# db-studio-code <app> <port> <host-name>: a one-time code (60 s) for the admin who runs this to
# open <app> from 127.0.0.1:<port> of their laptop: code=<code> probe=<word> sock=<their socket>
cmd_db_studio_code() {
  need_root; app "$1"
  [[ ${C[database]:-} == postgres ]] || die "$A has no database (add database = postgres to tando.conf, then tando up)"
  local port=${2:-} hn=${3:-} who=${SUDO_USER:-root} out sock i
  [[ $port =~ ^[0-9]{4,5}$ ]] && ((10#$port >= 1024 && 10#$port <= 65535)) || die "bad port"
  [[ $hn =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,31}$ ]] || die "bad host name"
  [[ $who != tando-d-* ]] || die "a CI deploy key cannot open the studio"
  [[ $who =~ ^[A-Za-z_][A-Za-z0-9_.-]{0,31}$ ]] || die "bad admin name"
  [[ -x $STUDIO ]] || die "the studio is not installed on <host>: tando host setup <host>"
  systemctl is-active -q tando-studio.service || systemctl start tando-studio.service 2> /dev/null ||
    die "the studio service does not run on <host>: tando host setup <host> (sudo journalctl -u tando-studio shows why)"
  for ((i = 0; i < 50; i++)); do [[ -S $STUDIO_RUN/ctl ]] && break; sleep 0.1; done
  out=$("$STUDIO" ctl code "$who" "$A" "$port" "$hn" 2>&1) || die "${out#error=}"
  [[ $out =~ ^code=[A-Za-z0-9_-]+\ probe=[A-Za-z0-9_-]+\ sock=(/run/tando-studio/u/[A-Za-z0-9_.-]+/s)$ ]] || die "the studio service answered: $out"
  sock=${BASH_REMATCH[1]}
  [[ -S $sock && ! -L $sock ]] && chown "$who" "$sock" && chmod 600 "$sock" || die "could not hand $sock to $who"
  AUDIT_NOTE="read-only, port $port"
  echo "$out"
}
# db-studio-lower: (tando-studio-lower.service) every <app>.<pid> the front dropped in lower/
cmd_db_studio_lower() {
  need_root
  local f n a pid
  for f in "$STUDIO_RUN"/lower/*; do
    [[ -f $f ]] || continue
    n=${f##*/}; rm -f "$f"; a=${n%.*} pid=${n##*.}
    valid_app "$a" && [[ -f $R/apps/$a/app.conf ]] || continue
    ( app "$a"; DB_ROLE=$(db_role); studio_lower "$pid" ) ||
      echo "tando-agent: warning: could not lower the priority of the studio's database process $pid ($a)" >&2
  done
  return 0
}
cmd_db_studio_ls() { # [app]: database=0|1 for the app, installed=0|1, service=1 (this version), the
  # service's row; without an app also every app: app <name> <database 0|1> <database bytes> <state>
  need_root
  if [[ -n ${1:-} ]]; then app "$1"; echo "database=$([[ ${C[database]:-} == postgres ]] && echo 1 || echo 0)"; fi
  echo "installed=$([[ -x $STUDIO ]] && echo 1 || echo 0)"
  echo "service=1"
  studio_rows
  [[ -z ${1:-} ]] || return 0
  local f a db sizes="" sz st
  load "$R/host.conf" H
  [[ ${H[postgres]:-} == yes ]] && sizes=$(pgsql -F ' ' -c "SELECT datname, pg_database_size(datname) FROM pg_database WHERE datname LIKE 'tando\_%'" 2> /dev/null)
  for f in "$R"/apps/*/app.conf; do
    [[ -f $f ]] || continue
    a=${f%/app.conf}; a=${a##*/}; db=0; sz=-
    grepq -x 'database=postgres' "$f" && { db=1; sz=$(awk -v d="tando_${a//-/_}" '$1 == d { print $2 }' <<< "$sizes"); }
    st=$(systemctl is-active "tando-$a.service" 2> /dev/null); [[ -n $st ]] || st=unknown
    grepq -x 'recipe=static' "$f" && st=static
    row app "$a" "$db" "${sz:--}" "$st"
  done
}
cmd_db_studio_stop() { # [app]: end the app's helpers; without one every token and helper (a restart)
  need_root
  local n=0 out
  if [[ -n ${1:-} ]]; then
    app "$1"
    out=$(studio_ctl revoke "$A") && [[ $out =~ ^revoked=([0-9]+)$ ]] && n=${BASH_REMATCH[1]}
  else
    if out=$(studio_ctl ls) && [[ $out =~ helpers=([a-z0-9,-]+)$ && ${BASH_REMATCH[1]} != - ]]; then
      n=$(tr ',' '\n' <<< "${BASH_REMATCH[1]}" | grep -c .)
    fi
    if systemctl is-enabled -q tando-studio.service 2> /dev/null; then
      systemctl restart tando-studio.service || die "could not restart the studio service"
    fi
  fi
  AUDIT_NOTE="$n stopped"
  echo "stopped=$n"
}
# <<< db studio

# shell <app> [hex]: a shell as the app's user, in the app's own sandbox (props, kind job: the same
# user, read-only system, private /tmp, /dev and IPC, shared/ writable, no listening socket), with
# the app's env, in its current release: `tando ssh <app>` (interactive, over ssh -t) and
# `tando ssh <app> -- <command>` (the command hex-encoded, so no shell between the client and here
# parses it; a terminal when ssh has one, else its stdin and stdout are piped). Root only: a CI
# deploy key never gets here (tando-gate allows no such verb, and its sudo rules name none).
# shell-put <app>: the command of `tando ssh <app> -- cmd` arrives hex-encoded on stdin (never in
# an argv: sudo's and systemd-run's command lines are readable in /proc) and waits in a root-only
# file under /run/tando/shell; `shell <app> @<token>` hands it to the unit as a credential
SHELL_Q=/run/tando/shell
cmd_shell_put() {
  need_root; app "$1"
  local hex="" t f
  IFS= read -r -n 8200 hex || [[ -n $hex ]] || die "no command on stdin"
  shell_decode "$hex"
  install -d -m 700 -o root -g root /run/tando "$SHELL_Q"
  find "$SHELL_Q" -type f -mmin +60 -delete 2> /dev/null   # left by a client that went away
  t=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n') f=$SHELL_Q/$A.$t
  (umask 077; printf '%s\n' "$SHELL_CMD" > "$f") || die "could not store the command"
  echo "token=$t"
}
shell_decode() { # hex -> SHELL_CMD, or die
  local hex=$1 s
  # (not one regex with {1,4096}: compiling that took 4 s of CPU on a small server)
  [[ -n $hex && ${#hex} -le 8192 && $((${#hex} % 2)) = 0 && $hex != *[!0-9a-f]* ]] || die "bad command (hex)"
  # \x before every pair (one sed: a loop of ${hex:i:2} under UTF-8 cost 0.5 s of CPU for 8192)
  s=$(sed 's/../\\x&/g' <<< "$hex")
  [[ $s != *'\x00'* ]] || die "bad command (NUL)"
  printf -v SHELL_CMD '%b' "$s"
  no_ctrl "${SHELL_CMD//$'\t'/ }" || die "the command has control characters"
}
cmd_shell() {
  need_root; app "$1"
  local hex=${2:-} cmd="" s="" p=() x mode=--pty qf=""
  if [[ $hex == @* ]]; then   # a command stored by shell-put
    [[ $hex =~ ^@[0-9a-f]{32}$ ]] || die "bad command token"
    qf=$SHELL_Q/$A.${hex#@}
    [[ -f $qf && ! -L $qf ]] || die "the command expired or was already run; run tando ssh again"
  fi
  [[ ${C[recipe]:-node} != container ]] || die "$A runs in a container; a shell inside it is not supported (tando logs -a $A)"
  has_unit || die "$A is a static site: it has no process, so there is no sandbox to open a shell in"
  [[ -d $D/current/ ]] || die "$A has no current release yet (tando up first)"
  id "$AU" &> /dev/null || die "the user $AU does not exist"
  if [[ -n $qf ]]; then
    cmd=$(< "$qf"); [[ -n $cmd ]] || die "empty command"
    AUDIT_NOTE="command: ${cmd:0:120}"
    [[ -t 0 ]] || mode=--pipe
  elif [[ -n $hex ]]; then   # older clients: the command as an argument
    shell_decode "$hex"; cmd=$SHELL_CMD
    AUDIT_NOTE="command: ${cmd:0:120}"
    [[ -t 0 ]] || mode=--pipe
  else
    # lint: allow RL04 a message, not a command: "(ssh -t)" is text
    [[ -t 0 ]] || die "an interactive shell needs a terminal (ssh -t); tando ssh $A -- <command> runs one command"
  fi
  # (ProcSubset=pid stays off here: ps, free and top read /proc/meminfo and /proc/stat)
  while IFS= read -r x; do [[ $x == ProcSubset=* ]] || p+=(-p "$x"); done < <(props - job)
  [[ ${C[recipe]:-} == python && -d $D/current/.venv ]] && p+=(-E "VIRTUAL_ENV=$D/current/.venv" -E "PATH=$D/current/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
  audit_done 0
  # the app's own port for curl (binding it stays denied); no history file in shared/
  p+=(-E "PORT=${C[port]:-}" -E HISTFILE=/dev/null -E "TERM=${TERM:-xterm}" -p "WorkingDirectory=$D/current")
  if [[ -n $qf ]]; then
    # the command as a credential (/run/credentials/<unit>/cmd, the unit's user only): no argv of
    # sudo, systemd-run or bash carries it; the file goes when the unit stops
    # shellcheck disable=SC2016 # expanded by the shell inside the unit
    exec systemd-run --quiet "$mode" --wait --collect --unit="tando-$A-shell-$$" \
      -p Description="tando shell $A" "${p[@]}" -p "LoadCredential=cmd:$qf" -p "ExecStopPost=+/bin/rm -f $qf" \
      /bin/bash --norc --noprofile -c '. "$CREDENTIALS_DIRECTORY/cmd"'
  fi
  if [[ -n $cmd ]]; then
    exec systemd-run --quiet "$mode" --wait --collect --unit="tando-$A-shell-$$" \
      -p Description="tando shell $A" "${p[@]}" /bin/bash --norc --noprofile -c "$cmd"
  fi
  exec systemd-run --quiet --pty --wait --collect --unit="tando-$A-shell-$$" -p Description="tando shell $A" \
    "${p[@]}" -E "PS1=$A:\\w\\$ " /bin/bash --norc --noprofile -i
}

# ---- destroy, unlock -----------------------------------------------------------------------

cmd_destroy() { # app [purge]: remove the app; keep a final backup of its data unless purge
  need_root
  valid_app "${1:-}" || die "invalid app name"
  # an app directory without app.conf (a first tando up interrupted early): nothing was deployed,
  # there is no data; it goes, with the user only when that interrupted configure made it
  if [[ -d $R/apps/$1 && ! -f $R/apps/$1/app.conf ]]; then
    A=$1 D=$R/apps/$1
    if [[ ${2:-} == plan ]]; then printf '%s\n' releases=0 env=0 data= database= backups=0 jobs=0 final=0; return 0; fi
    if [[ -f $D/.creating ]] && getent passwd "tando-$A" > /dev/null; then
      pkill -KILL -u "tando-$A" 2> /dev/null; sleep 0.2
      uid_lock
      userdel "tando-$A" || die "could not remove the user tando-$A (userdel failed); run tando destroy again"
      groupdel "tando-$A" 2> /dev/null; groupdel "tando-m-$A" 2> /dev/null
      exec 14>&-
    fi
    rm -rf "${D:?}"; rm -f "/etc/systemd/system/$(app_slice)"
    echo "destroyed=$A"; return 0
  fi
  app "$1"
  [[ -n ${C[adopted_from]:-} ]] && die "$A was adopted from ${C[adopted_from]}.service: use tando adopt undo"
  local purge=${2:-} id f pv
  # its previews go first: they hold copies of its keys and env, and an app made later under its
  # name must not find them
  if [[ $purge != plan && -z ${C[preview_of]:-} ]]; then
    for f in "$R"/apps/*/app.conf; do
      [[ -f $f ]] && grepq -x "preview_of=$A" "$f" || continue
      pv=${f%/app.conf}; pv=${pv##*/}
      valid_preview_name "$A" "$pv" || continue
      "$AGENT" destroy "$pv" purge > /dev/null ||
        die "could not remove the preview $pv of $A; nothing of $A was removed (tando destroy -a $pv, then again)"
      echo "preview_destroyed=$pv"
    done
  fi
  if [[ $purge == plan ]]; then   # what there is to remove, for the question the client asks
    echo "releases=$(find "$D/releases" -mindepth 1 -maxdepth 1 -type d | wc -l)"
    echo "env=$(grep -c . "$D/env")"
    echo "data=$([[ -n ${C[data]:-}${C[data_dir]:-} ]] && du -sb "$ADATA" 2> /dev/null | cut -f1)"
    echo "database=${C[database]:-}"
    db_remote && { echo "db_remote=${H[db_host]}"; echo "db_node=${H[db_node]:-}"; }
    echo "backups=$(find "$BK/$A" -mindepth 1 -maxdepth 1 2> /dev/null | grep -c .)"
    echo "jobs=$(job_names | grep -c .)"
    echo "workers=$(worker_names | grep -c .)"
    echo "final=$(has_backup_data && echo 1 || echo 0)"
    return 0
  fi
  lock 300
  load "$D/state" S
  # a recorded operation: from here a destroy cut off by a kill or a reboot is finished by recover
  # (the user asked for it), with the final backup taken again when it was cut off too
  st phase destroy destroy_purge "$purge" destroy_step backup ||
    die "could not save the state (disk full?); nothing removed"
  destroy_finish
}
# destroy_finish: the rest of a destroy (destroy_step backup: the final backup first, unless
# purge; then remove: every step may run again after a cut, and the app's directory goes last)
destroy_finish() {
  local purge=${S[destroy_purge]:-} id f
  if [[ ${S[destroy_step]:-backup} == backup ]]; then
    bk_tmp_clean      # (a final backup's that was cut off)
    # (no user any more: an earlier destroy got that far, after its final backup)
    if [[ $purge != purge ]] && has_backup_data && id "$AU" &> /dev/null; then
      fp ds.stop
      systemctl stop "tando-$A" "tando-${A}_worker-*"
      # (the app runs again when nothing is removed)
      # (in this shell, not $(...): it keeps the handler for a dropped ssh session)
      backup_take final > /dev/null || { st phase idle destroy_purge "" destroy_step ""
        [[ -z ${S[stopped]:-} && -n ${S[current]:-} ]] && restart_app && workers_follow all
        die "final backup failed; nothing removed (use --purge to skip it)"; }
      id=$BK_ID
      echo "backup=$BK/$A/$id"
    fi
    st destroy_step remove
  fi
  fp ds.units
  # this app's units only: app names may contain "-", so tando-<app>-* would also match hello-2's
  local units=() u
  while IFS= read -r u; do units+=("$u"); done < <(app_units)
  # (timers and workers are enabled: their links in *.wants go with them)
  for u in "${units[@]}"; do [[ $u == *.timer || $u == *.socket || $u == tando-"$A"_worker-*.service ]] && systemctl disable -q --now "$u" 2> /dev/null; done
  systemctl disable -q --now "tando-$A.service" 2> /dev/null
  # every unit of the app, running jobs and transients included, then every process of its user
  ((${#units[@]})) && { systemctl stop "${units[@]}" 2> /dev/null; systemctl kill -s KILL "${units[@]}" 2> /dev/null; }
  local uid i; uid=$(id -u "$AU" 2> /dev/null)
  for ((i = 0; i < 50; i++)); do
    pgrep -u "$AU" > /dev/null 2>&1 || break
    pkill -KILL -u "$AU" 2> /dev/null; sleep 0.2
  done
  pgrep -u "$AU" > /dev/null 2>&1 &&
    die "processes of $AU survive a kill: $(pgrep -u "$AU" | tr '\n' ' ')- nothing removed; run tando destroy again"
  for u in "${units[@]}"; do rm -f "/etc/systemd/system/$u"; done
  [[ -x $STUDIO ]] && studio_ctl revoke "$A" > /dev/null   # (its studio helpers: killed with the user's processes above)
  rm -f "/etc/systemd/system/tando-$A.service" "/etc/systemd/system/$(app_slice)"
  systemctl daemon-reload
  fp ds.site
  rm -f "/etc/caddy/tando/$A.caddy" "/etc/tmpfiles.d/tando-journal-$A.conf"
  rm -rf "/etc/systemd/system/systemd-journald@tando-$A.service.d" "/etc/systemd/system/systemd-journald-sync@tando-$A.service.d"
  caddy_lock; systemctl reload caddy || echo "warning=caddy reload failed" >&2; exec 11>&-
  fp ds.db
  # (on a data node: the client drops it there, data-db drop; this node cannot)
  [[ ${C[database]:-} == postgres ]] && ! db_remote && { db_drop || echo "warning=could not drop the database" >&2; }
  if [[ ${C[recipe]:-node} == container ]]; then
    podman images --format '{{.Repository}}:{{.Tag}}' | grep "^localhost/tando-$A:" |
      xargs -r podman rmi -f > /dev/null 2>&1
    # (run/<app>-<port>.env: the port by its digits, so app foo never takes foo-2's files)
    for f in "$R/run/$A-"*.env; do [[ ${f#"$R/run/$A-"} =~ ^[0-9]+\.env$ ]] && rm -f "$f"; done
  fi
  [[ -x $LOGS ]] && "$LOGS" app-remove "$A" > /dev/null
  # (SUDO_USER=root: a preview removed by its app's deploy key runs here with that key's user in
  # SUDO_USER, and the gate's admin mode refuses deploy users; this process is root's)
  [[ -x $R/bin/tando-gate ]] && { SUDO_USER=root $R/bin/tando-gate admin remove "$A" > /dev/null ||
    echo "warning=could not remove the deploy user" >&2; }
  rm -f "/var/lib/tando/metrics/$A.tsv" "/var/lib/tando/metrics/$A.tsv.1" "/var/lib/tando/metrics/$A.disk" "/var/lib/tando/metrics/$A.disk.1" \
    "/var/lib/tando/metrics/$A.db" "/var/lib/tando/metrics/$A.db.1" "/var/lib/tando/metrics/$A.dbtop"
  [[ -x $R/bin/tando-watch ]] && "$R/bin/tando-watch" forget "$A" > /dev/null   # its alert state
  rm -rf "${EVID:?}/$A"   # (a suspended app's evidence: cmd_hold)
  # leftovers of the uid outside the app's directory, then the user; its uid is never handed out
  # again. The app's directory goes last: a destroy interrupted before it finds the app again and
  # finishes (an earlier order left a user tando-<app> that blocked a new app of that name)
  if [[ -n $uid ]]; then
    find /dev/shm /tmp /var/tmp -xdev -user "$uid" -delete 2> /dev/null
    grep -qx "$uid" "$R/retired-uids" 2> /dev/null || echo "$uid" >> "$R/retired-uids"
  fi
  # the gids are retired like the uid (the same list: new_uid hands out neither again); read
  # before userdel, which removes the user's own group
  local g gid
  for g in "tando-$A" "tando-m-$A"; do
    gid=$(getent group "$g" | cut -d: -f3)
    [[ $gid =~ ^[0-9]+$ ]] && { grep -qx "$gid" "$R/retired-uids" 2> /dev/null || echo "$gid" >> "$R/retired-uids"; }
  done
  fp ds.user
  uid_lock
  if getent passwd "tando-$A" > /dev/null && ! userdel "tando-$A"; then
    die "could not remove the user tando-$A (userdel failed); run tando destroy again to finish"
  fi
  for g in "tando-$A" "tando-m-$A"; do groupdel "$g" 2> /dev/null; done
  exec 14>&-
  systemctl reset-failed "tando-$A.service" ${units[@]+"${units[@]}"} "tando-down@tando-$A.service" 2> /dev/null
  # its slice: stopped once nothing of the app runs in it, so systemd unloads it (no file left)
  systemctl stop "$(app_slice)" 2> /dev/null; systemctl reset-failed "$(app_slice)" 2> /dev/null
  units_unload "$(app_slice)"
  [[ $purge == purge ]] && rm -rf "${BK:?}/$A"
  # (the user is gone: fw_sync leaves the app out although its app.conf is still there)
  fp ds.fw
  fw_sync || echo "warning=could not reload the loopback rules (tando doctor)" >&2
  # the app's directory last, in one rename (a cut rm -rf could take app.conf and leave the rest,
  # which no recover finds): what a cut leaves of the renamed one, recover-all removes
  fp ds.dir
  mv -T "$D" "$R/apps/.gone-$A.$$" && rm -rf "${R:?}/apps/.gone-$A.$$"
  echo "destroyed=$A"
}

cmd_unlock() { # app: clear an upload lease left by a client that went away
  need_root; app "$1"; lease_lock
  load "$D/upload" L
  if [[ -z ${L[token]:-} ]]; then echo "held=0"; return; fi
  if [[ -n ${L[id]:-} ]] && lease_live; then
    die "release ${L[id]} is activating; that lease is freed when it has copied the upload"
  fi
  echo "held=1"; echo "who=${L[who]}"; echo "age=$(lease_age)"
  rm -f "$D/upload"
  local du; du=$(deploy_user) && { pkill -KILL -u "$du" 2> /dev/null || true; }   # end the deploy key's uploads with their lease
  return 0
}

# ---- verbs: views ----------------------------------------------------------------------

app_row() { # name of the array with this unit's systemctl fields
  local -n _u=$1
  local mem=0 max=${_u[MemoryMax]:-} up=0 k v
  local mono=${_u[ActiveEnterTimestampMonotonic]:-0} cpu=${_u[CPUUsageNSec]:-0}
  # (the unit's cgroup: in its app's slice; one deployed before the slices existed: system.slice)
  local cgd=/sys/fs/cgroup/tando.slice/tando-${A//-/\\x2d}.slice/tando-$A.service
  [[ -d $cgd ]] || cgd=$CG/tando-$A.service
  local state=${_u[ActiveState]:-inactive} stat=$cgd/memory.stat
  # memory shown is anon + shmem; MemoryCurrent also counts reclaimable page cache
  if [[ -r $stat ]]; then
    while read -r k v; do [[ $k == anon || $k == shmem ]] && mem=$((mem + v)); done < "$stat"
  fi
  [[ $max =~ ^[0-9]+$ ]] || max=0
  [[ $cpu =~ ^[0-9]+$ ]] || cpu=0
  [[ $state == active && $mono != 0 ]] && up=$((UPT - mono / 1000000))
  has_unit || { [[ -n ${S[current]:-} ]] && state=active; }   # static: served by Caddy
  [[ -n ${S[down]:-} ]] && state=failed
  [[ -n ${S[stopped]:-} ]] && state=stopped   # stopped by the user (tando stop); inactive = it died
  [[ ${S[phase]:-idle} != idle ]] && state=deploying
  row app "$A" "$state" "${C[port]:-}" "${S[current]:-}" "${S[status_${S[current]:-x}]:-}" \
    "$mem" "$max" "$cpu" "${_u[NRestarts]:-0}" "$up" "$(link)" "${C[recipe]:-}" \
    "${C[backup]:-off}" "${S[last_backup]:-}" "${C[database]:-}" ${LG[$A]:-- - - -} "$(app_domains)" \
    "${C[cpu]:--}" "${C[tasks]:-1024}" "${C[max_conns]:-256}" "${C[max_requests]:--}" "$(cpu_minute)"
  # (LG: 4 words, split on purpose; then the app's limits, cpu "-" = none; then cpu_minute)
}
# cpu_minute: the app's CPU over tando-metrics' last sample (about the last minute), per mille of
# one core: the usec of the last line over the seconds since the line before; "-" without two
# lines, a gap over 10 minutes, or a last sample older than 3 minutes. srv/status: cpuMinute.
cpu_minute() {
  local f=/var/lib/tando/metrics/$A.tsv ml t1 t2 u2 dt
  [[ -r $f ]] || { echo -; return; }
  mapfile -t ml < <(tail -n 2 "$f" 2> /dev/null)
  ((${#ml[@]} == 2)) || { echo -; return; }
  IFS=$'\t' read -r t1 _ <<< "${ml[0]}"
  IFS=$'\t' read -r t2 _ u2 _ <<< "${ml[1]}"
  [[ $t1 =~ ^[0-9]{1,12}$ && $t2 =~ ^[0-9]{1,12}$ && $u2 =~ ^[0-9]{1,15}$ ]] || { echo -; return; }
  dt=$((t2 - t1))
  if ((dt < 1 || dt > 600 || EPOCHSECONDS - t2 > 180)); then echo -; return; fi
  echo $((u2 / (dt * 1000)))
}
# restore_cut_row: a restore cut off while it replaced the data (restore_cut in the state, until a
# restore ends): one row for tando status and ls: the backup to restore again, the safety backup,
# what was being replaced. srv/status prints the same row.
restore_cut_row() {
  [[ -n ${S[restore_cut]:-} ]] || return 0
  row restorecut "$A" "${S[restore_cut_id]:--}" "${S[restore_cut_safety]:--}" "${S[restore_cut_what]:-data}"
}
app_domains() { local x o=""; for x in ${C[domains]:-}; do o+="${o:+,}${x%|*}"; done; echo "${o:--}"; }

# status [app]: a host row and one row per app; with an app also its releases and history
cmd_status() {
  local l k v a names=() units=() la mt=0 ma=0 cpus dt du
  load "$R/host.conf" H
  if [[ -n ${1:-} ]]; then
    app "$1"; names=("$1")
  else
    for a in "$R"/apps/*/app.conf; do   # apps whose metadata this caller may read
      [[ -r $a ]] && { a=${a%/app.conf}; names+=("${a##*/}"); }
    done
  fi
  read -r UPT _ < /proc/uptime; UPT=${UPT%.*}
  CG=/sys/fs/cgroup/system.slice
  read -r la _ < /proc/loadavg
  while read -r k v _; do
    case $k in MemTotal:) mt=$v;; MemAvailable:) ma=$v;; esac
  done < /proc/meminfo
  # no forks for the host name and CPU count; df is the one left (statfs has no /proc file)
  local hn x part lo hi; cpus=0
  read -r hn < /proc/sys/kernel/hostname
  IFS=, read -ra part < /sys/devices/system/cpu/online
  for x in "${part[@]}"; do
    lo=${x%-*} hi=${x#*-}; cpus=$((cpus + hi - lo + 1))
  done
  { read -r _; read -r _ dt du _; } < <(df -Pk /)
  row host "$hn" "$cpus" "$la" $((mt * 1024)) $(((mt - ma) * 1024)) $((dt * 1024)) \
    $((du * 1024)) "$UPT"
  # the server's clock and tando version, for the client's skew line (srv/status prints the same)
  local sv=""; { IFS= read -r sv || :; } < "$R/VERSION" 2> /dev/null
  row server "$EPOCHSECONDS" "${sv:-unknown}"
  # host care's counts (tando-host's summary, root 600), as tando-status prints them
  local hk hv hat _h1 htodo hfail hwarn
  if [[ -r /var/lib/tando/hostcare/summary ]]; then
    while IFS=$'\t' read -r hk hv hat _h1 htodo hfail hwarn _; do
      [[ $hk == summary && $hv == 1 ]] && { row hostcare "$htodo" "$hfail" "$hwarn" "$hat"; break; }
    done < /var/lib/tando/hostcare/summary
  fi
  ((${#names[@]})) || return 0
  # log sizes (tando-logs caches its journal counts for a minute): appended to the app rows as
  # bytes on disk (journal + request log), the journal cap, lines in 24 h, lines per hour
  declare -gA LG=()
  local r jb cap ab lines hl
  if [[ $EUID -eq 0 && -x $LOGS ]]; then
    local lk lr lsrc
    while IFS=$'\t' read -r r a jb cap ab lines _ _ hl _ _ lk lr lsrc _; do
      [[ $r == logs ]] || continue
      [[ $jb =~ ^[0-9]+$ ]] || jb=0
      [[ $ab =~ ^[0-9]+$ ]] || ab=0
      LG[$a]="$((jb + ab)) ${cap:--} ${lines:--} ${hl:--}"
      [[ $a == "${1:-}" ]] && LC="${lk:--} ${lr:--} ${lsrc:--}"   # retention, request log budget, cap source
    done < <("$LOGS" log-stats ${1:+"$1"} 2> /dev/null)
  fi
  for a in "${names[@]}"; do units+=("tando-$a.service"); done
  declare -A U
  local i=0
  # one systemctl call for all apps; blocks are separated by empty lines
  while IFS= read -r l; do
    if [[ -n $l ]]; then U[${l%%=*}]=${l#*=}; continue; fi
    ( A=${names[i]} D=$R/apps/${names[i]}; load "$D/app.conf" C; load "$D/state" S; app_row U; worker_rows; restore_cut_row )
    U=(); i=$((i + 1))
  done < <(systemctl show -p ActiveState,MemoryMax,CPUUsageNSec,NRestarts \
             -p ActiveEnterTimestampMonotonic "${units[@]}"; echo)
  if [[ -n ${1:-} ]]; then
    [[ -n ${LC:-} ]] && row logcfg "$1" ${LC}   # (3 words, split on purpose)
    cmd_releases "$1"; cmd_history "$1" 5
    local x; for x in ${C[domains]:-}; do row domain "${x%|*}" "${x#*|}" "$(cert_expiry "${x%|*}")"; done
    # the last 16 minutes from tando-metrics (m rows: bucket, memory, cpu per mille, restarts, state)
    [[ -x $R/bin/tando-metrics ]] && "$R/bin/tando-metrics" read "$1" 16 60 2> /dev/null
  fi
  # with an app, its offsite state (the file tando-offsite keeps; srv/status prints the same row)
  if [[ -n ${1:-} && -r /var/lib/tando/offsite/state/$1 ]]; then
    local -A OB=(); load "/var/lib/tando/offsite/state/$1" OB
    [[ ${OB[enabled]:-} == 1 ]] && row offsite "${OB[last_upload]:-0}" "${OB[pending]:-0}" "${OB[oldest_pending]:-0}" \
      "${OB[alert_hours]:-6}" "${OB[creds]:-}" "${OB[error]:-}"
  fi
  [[ -x $R/bin/tando-watch ]] && "$R/bin/tando-watch" brief ${1:+"$1"}   # active alerts
  return 0
}

cmd_releases() {
  app "$1"
  local i cur last
  for i in $(releases_by_seq | tac); do
    cur=0 last=0
    [[ $i == "${S[current]:-}" ]] && cur=1
    [[ $i == "${S[last_good]:-}" ]] && last=1
    row rel "$i" "${S[status_$i]:-pending}" "$cur" "$last"
  done
}
# the verb releases: its rows, then where the app was last deployed from (user@machine:path;
# tando-dash deploys from that folder). Not in status (cmd_status lists the releases too).
cmd_releases_verb() {
  cmd_releases "$@"
  [[ -n ${C[origin]:-} ]] && row origin "${C[origin]}"
  return 0
}

cmd_history() { # [app] [n]   (a lone number is the count)
  [[ -n ${1:-} && -z ${2:-} && $1 =~ ^[0-9]+$ ]] && set -- "" "$1"
  local n=${2:-20} f
  [[ $n =~ ^[0-9]+$ ]] || die "bad count"
  if [[ -n ${1:-} ]]; then
    valid_app "$1" || die "invalid app name"
    set -- "$R/apps/$1/history.tsv"
  else
    set -- "$R"/apps/*/history.tsv
  fi
  for f; do
    [[ -r $f ]] || continue
    f=${f%/history.tsv}
    tail -n "$n" "$f/history.tsv" | awk -F '\t' 'NF == 12 || NF == 13' | sed "s/^/hist\t${f##*/}\t/"
  done
}

# ---- env: stored double-quoted with \ " ` $ escaped; systemd reads that back verbatim ----

env_load() {
  local -n _e=$1
  local line k v out i c
  _e=()
  while IFS= read -r line; do
    k=${line%%=*} v=${line#*=}
    v=${v#\"}; v=${v%\"}; out=""
    for ((i = 0; i < ${#v}; i++)); do
      c=${v:i:1}
      if [[ $c == '\' ]]; then i=$((i + 1)); c=${v:i:1}; fi
      out+=$c
    done
    _e[$k]=$out
  done < "$D/env"
}
env_save() { # array [file, default $D/env]
  local -n _e=$1
  local k v tmp dest=${2:-$D/env}
  tmp=$(mktemp "$D/.env.XXXXXX") || return 1   # (its own name: never shared with another writer)
  chown "root:$AU" "$tmp" && chmod 640 "$tmp" || { rm -f "$tmp"; return 1; }
  # written whole to a temp file, flushed to disk, then renamed: a full disk or a power cut leaves
  # the old env or the new one, never half of it
  if for k in "${!_e[@]}"; do
       v=${_e[$k]//\\/\\\\}; v=${v//\"/\\\"}; v=${v//\`/\\\`}; v=${v//\$/\\\$}
       printf '%s="%s"\n' "$k" "$v"
     done | sort > "$tmp" && sync "$tmp" && mv -f "$tmp" "$dest"; then return 0; fi
  rm -f "$tmp"; return 1
}

protected_key() {
  case $1 in
    PORT|HOME|TANDO_DATA_DIR|DATABASE_PATH) return 0;;
    DATABASE_URL|DATABASE_URL_DIRECT) [[ ${C[database]:-} == postgres ]];;
    *) return 1;;
  esac
}
mask_url() { # postgres://role:secret@host/db -> postgres://role:****@host/db
  local u=$1 pre post
  [[ $u == *://*:*@* ]] || { echo "$u"; return; }
  pre=${u%%@*} post=${u#*@}
  echo "${pre%:*}:****@$post"
}

# ---- the env changelog: $D/env.log (root 600), one line per change of the app's env, newest last,
# the newest 200 kept. NAMES only (added, changed, removed): never a value, a length or a hash.
# Fields (tab-separated, "-" for none): epoch, who, verb (set unset import database), note,
# added, changed, removed (key names, comma-separated, sorted). ----
ENVLOG_MAX=200
# envlog_args args after the app (env-set/env-unset): note64=<base64 of the note>, via=import
envlog_args() {
  local a n
  ENV_NOTE="" ENV_VIA=""
  for a; do
    case $a in
      note64=*)
        n=$(printf '%s' "${a#note64=}" | base64 -d 2> /dev/null; echo x) || die "bad note"
        n=${n%x}
        no_ctrl "$n" || die "the note has control characters (one line of plain text)"
        ((${#n} <= 200)) || die "the note is over 200 characters"
        san_v "$n"; ENV_NOTE=$SAN;;
      via=import) ENV_VIA=import;;
      *) die "env: unknown argument";;
    esac
  done
}
# envlog_diff old new verb: ENV_LINE, the entry for the change from old to new (key names only)
envlog_diff() {
  local -n _o=$1 _n=$2
  local k add="" chg="" rem="" v=$3
  [[ $v == set && ${ENV_VIA:-} == import ]] && v=import
  for k in "${!_n[@]}"; do
    if [[ -z ${_o[$k]+x} ]]; then add+="$k"$'\n'; elif [[ ${_o[$k]} != "${_n[$k]}" ]]; then chg+="$k"$'\n'; fi
  done
  for k in "${!_o[@]}"; do [[ -n ${_n[$k]+x} ]] || rem+="$k"$'\n'; done
  envlog_line "$v" "$add" "$chg" "$rem"
}
# envlog_line verb added changed removed (newline-separated names): ENV_LINE
envlog_line() {
  local who=${SUDO_USER:-${TANDO_AUDIT_WHO:-root}} f out="" l
  san_v "$who"; who=${SAN:0:32}
  for f in "$2" "$3" "$4"; do
    l=$(printf '%s' "$f" | sort | paste -sd, -)
    out+=$'\t'${l:--}
  done
  ENV_LINE="$(now)"$'\t'"${who:--}"$'\t'"$1"$'\t'"${ENV_NOTE:--}$out"
}
# envlog_put verb added changed removed: one entry at once (tando's own changes; names, space-separated)
envlog_put() { envlog_line "$1" "${2// /$'\n'}" "${3// /$'\n'}" "${4// /$'\n'}"; envlog_append <<< "$ENV_LINE"; }
# envlog_append: the entry on stdin added to the log, the newest 200 kept; written whole to a temp
# file, flushed, renamed (the way env_save writes). A log that cannot be written never fails the
# change itself: it warns.
envlog_append() {
  local f=$D/env.log tmp
  tmp=$(mktemp "$D/.envlog.XXXXXX") && chmod 600 "$tmp" &&
    { { [[ ! -f $f || -L $f ]] || tail -n $((ENVLOG_MAX - 1)) "$f"; cat; } > "$tmp" && sync "$tmp" && mv -f "$tmp" "$f"; } && return 0
  [[ -n ${tmp:-} ]] && rm -f "$tmp"
  echo "tando-agent: warning: could not write the env changelog of $A (disk full?)" >&2
  return 0
}
# envlog_commit: the entry of a change that stayed (env.entry, written beside env.next) goes into the log
envlog_commit() {
  [[ -f $D/env.entry ]] || return 0
  envlog_append < "$D/env.entry"
  rm -f "$D/env.entry"
}
# env-log <app> [n]: the changelog, newest first, as rows
#   envlog <n> <epoch> <who> <verb> <note> <added> <changed> <removed>   (n: 1 is the newest)
# A change without a note gets a generated one ("set 2 keys", "removed 1 key"). Names only.
cmd_env_log() {
  need_root
  local f n=${2:-}
  valid_app "${1:-}" || die "invalid app name"
  [[ -z $n || $n =~ ^[1-9][0-9]{0,3}$ ]] || die "env log: the entry number is a positive number"
  if [[ -d $R/apps/$1 ]]; then f=$R/apps/$1/env.log
  elif [[ -d $R/staged/$1 ]]; then f=$R/staged/$1/env.log
  else die "no such app: $1"; fi
  [[ -f $f && ! -L $f ]] || { echo count=0; return 0; }
  tac "$f" | awk -F '\t' -v want="$n" '
    function cnt(s,   a) { return s == "-" ? 0 : split(s, a, ",") }
    function keys(c) { return c " " (c == 1 ? "key" : "keys") }
    NF == 7 && (want == "" || NR == want) {
      note = $4
      if (note == "-") {
        if ($3 == "unset") note = "removed " keys(cnt($7))
        else if ($3 == "database") note = "database set up"
        else note = ($3 == "import" ? "imported " : "set ") keys(cnt($5) + cnt($6))
      }
      printf "envlog\t%d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", NR, $1, $2, $3, note, $5, $6, $7
    }
    END { }'
}

# env set|unset|ls <app>: set reads KEY=VALUE lines, unset reads KEY lines, from stdin.
# Output: changed=0|1, restarted=0|1 and, when not restarted, why=<nothing-deployed|stopped|static>.
# For an app that does not exist yet the values are staged ($R/staged/<app>/env, root 600; staged=1)
# and the first configure (tando up) makes them the app's env: a required secret can be set first.
cmd_env() {
  need_root
  local op=$1 line k
  declare -A E
  envlog_args "${@:3}"
  if valid_app "${2:-}" && [[ ! -e $R/apps/$2 ]] && [[ $op != ls || -f $R/staged/$2/env ]]; then
    staged_lock
    # (looked at again under the lock: a first configure may have created the app meanwhile)
    [[ ! -e $R/apps/$2 ]] && { env_staged "$op" "$2"; return; }
    exec 3>&-
  fi
  app "${2:-}"
  [[ $op == ls ]] || { recover; lock 120; }
  env_load E
  declare -A OLD=(); for k in "${!E[@]}"; do OLD[$k]=${E[$k]}; done
  env_edit "$op" || return 0
  # the same values again: nothing to save, nothing to restart
  if [[ ${#E[@]} == "${#OLD[@]}" ]]; then
    local same=1
    for k in "${!E[@]}"; do [[ -n ${OLD[$k]+x} && ${OLD[$k]} == "${E[$k]}" ]] || { same=0; break; }; done
    ((same)) && { echo changed=0; echo healthy=1; return 0; }
  fi
  envlog_diff OLD E "$op"   # (names only: ENV_LINE)
  # nothing runs on the env now (static, nothing deployed, stopped): it is only saved
  if ! has_unit || [[ -z ${S[current]:-} || -n ${S[stopped]:-} ]]; then
    { fp env.save && env_save E; } || die "could not write the env file (disk full?); nothing changed"
    envlog_append <<< "$ENV_LINE"
    echo changed=1; echo restarted=0
    if ! has_unit; then echo why=static; elif [[ -z ${S[current]:-} ]]; then echo why=nothing-deployed; else echo why=stopped; fi
    echo healthy=1; return
  fi
  # was it serving before? Then a change that breaks it is undone, as a failed deploy is
  local was_up=0
  [[ -z ${S[down]:-} ]] && systemctl -q is-active "tando-$A" && was_up=1
  # the change is recorded first (phase env): a crash from here on ends in recover, which cleans
  # up a pre-flight cut short, or finishes the change once the new env is written (env.next)
  st phase env env_revert "$was_up" || die "could not save the state (disk full?); nothing changed"
  env_gone() { rm -f "$D/.env.check" "$D/env.prev" "$D/env.next" "$D/env.entry"; st phase idle env_revert ""; die "$1"; }
  # a running app is first started with the new env beside the live one (on the pre-flight port,
  # like a deploy): an env it does not start with is refused before anything restarts
  if [[ ${C[recipe]:-node} != container ]] && systemctl -q is-active "tando-$A"; then
    env_save E "$D/.env.check" || env_gone "could not write the env file (disk full?); nothing changed"
    if ! { fp env.check && env_preflight "$D/.env.check"; }; then
      rm -f "$D/.env.check"
      local out SAN; out=$(grep -v 'systemd\[\|tando-.*\.service: ' "$D/activation.log" 2> /dev/null | grep . | tail -2 | tr '\n' ' ' | cut -c1-300)
      san_v "$out"
      env_gone "$A does not start with the new env (pre-flight: $PROBE_WHY${SAN:+; it said: $SAN}), so nothing was changed and it was not restarted"
    fi
    rm -f "$D/.env.check"
  fi
  # the old env (env.prev) and the new one (env.next), each whole: from here on recover finishes
  # the change (the new env in place, restart, check, the old one back if it breaks the app)
  { fp env.save && env_save OLD "$D/env.prev" && env_save E "$D/env.next"; } ||
    env_gone "could not write the env file (disk full?); nothing changed"
  # (the entry last: a crash before it loses the entry, never writes one for a change not made)
  printf '%s\n' "$ENV_LINE" > "$D/env.entry" && chmod 600 "$D/env.entry"
  fp env.saved
  echo changed=1
  echo restarted=1
  env_finish
  case $ENV_RES in
    ok) echo healthy=1;;
    kept) echo healthy=0
      echo "tando-agent: $A was not healthy before this change either, so the new env was kept; undo it with tando env set or tando env unset (tando env ls shows the values)" >&2;;
    reverted) AUDIT_RESULT=reverted
      die "the app failed its health check with the new env ($ENV_WHY), so the previous env was put back and $A runs on it again: nothing changed (tando logs shows the app's output)";;
    norevert) die "the app fails its health check with the new env ($ENV_WHY), and the previous env could not be written back (disk full?): fix the value with tando env set, or tando env unset it";;
    *) die "the app fails its health check with the new env ($ENV_WHY); the previous env was put back, but $A does not answer with it either: tando logs, tando doctor";;
  esac
}

# env_finish: phase env (cmd_env, or recover after a crash): the new env in place, the app
# restarted on it and checked; a failure puts the previous env back when the app was serving
# before. ENV_RES: ok, kept (not healthy before either), reverted, broken (not healthy on the
# previous env either), norevert (the previous env could not be written back). ENV_WHY: the check.
env_finish() {
  ENV_RES=ok ENV_WHY=""
  [[ -f $D/env.next ]] && mv -f "$D/env.next" "$D/env"
  # (a restart that failed leaves the old process answering: its answer says nothing of the env)
  if restart_app && fp env.verify && via_caddy "$(app_unit)"; then
    workers_follow all || echo "tando-agent: $WF_WHY" >&2      # (the workers on the new env too)
    envlog_commit; rm -f "$D/env.prev"; st phase idle env_revert ""; return 0
  fi
  ENV_WHY=${PROBE_WHY:-the app could not be restarted (${WC_WHY:-systemctl restart failed})}
  if [[ ${S[env_revert]:-} == 1 && -f $D/env.prev ]]; then
    if fp env.revert && mv -f "$D/env.prev" "$D/env"; then
      restart_app
      if via_caddy "$(app_unit)"; then ENV_RES=reverted; else ENV_RES=broken; fi
    else ENV_RES=norevert; fi
  else ENV_RES=kept; fi
  # (a change that was put back is not a change of the env; one that stayed is logged)
  case $ENV_RES in reverted|broken) rm -f "$D/env.entry";; *) envlog_commit;; esac
  rm -f "$D/env.prev"
  st phase idle env_revert ""
}

# env_preflight file: the current release with this env file on the pre-flight port, health-checked
# (PROBE_WHY on failure; the app's output in activation.log)
env_preflight() {
  local cand=$1 spare=${C[preflight_port]:-$((${C[port]:-0} + 100))} unit="tando-$A-envcheck-$$" args=() x rc=0
  local rel=$D/releases/${S[current]}
  [[ -d $rel ]] || return 0   # (nothing to try it with: the restart's own check decides)
  ss -Hltn "sport = :$spare" | grepq . && { PROBE_WHY="pre-flight port $spare is in use"; return 1; }
  while IFS= read -r x; do [[ $x == "EnvironmentFile=$D/env" ]] && x="EnvironmentFile=$cand"; args+=(-p "$x"); done < <(props "$spare" preflight)
  systemd-run --quiet --collect --unit="$unit" "${args[@]}" -p "WorkingDirectory=$rel" "$AGENT" exec-app "$A" "$rel" ||
    { PROBE_WHY="could not start the pre-flight unit"; return 1; }
  if ! { probe "${C[health_timeout]:-60}" "$unit" "http://127.0.0.1:$spare$(health_path)" && own_listener "$spare" "$unit.service"; }; then
    app_journal -u "$unit" -n 60 --no-pager -o cat > "$D/activation.log" 2>&1; rc=1
  fi
  systemctl stop "$unit" 2> /dev/null
  return $rc
}

# env_staged op app: env set/unset/ls of an app that is not on this server yet
# staged_lock: env set of apps not created yet, and the first configure that takes their values,
# one at a time (fd 3, $R/staged/.lock, root only; env set holds it to the end of the verb, a
# configure until the app's files are written)
staged_lock() {
  install -d -m 700 -o root -g root "$R/staged" || die "could not create $R/staged"
  exec 3>"$R/staged/.lock"; chmod 600 "$R/staged/.lock"
  flock -w 60 3 || die "another env change of an app not created yet takes over 60 s; try again"
}
env_staged() {
  [[ -f $R/host.conf ]] || die "host not set up (tando host setup)"
  local k
  A=$2 D=$R/staged/$2 AU=root
  local -A C=()   # (no database yet: DATABASE_URL may be staged; tando's own value wins later)
  declare -A E=()
  [[ -f $D/env ]] && env_load E
  [[ $1 == ls ]] || install -d -m 700 -o root -g root "$R/staged" "$D"
  declare -A OLD=(); for k in "${!E[@]}"; do OLD[$k]=${E[$k]}; done
  env_edit "$1" || return 0
  envlog_diff OLD E "$1"
  if ((${#E[@]})); then env_save E; chmod 600 "$D/env"; envlog_append <<< "$ENV_LINE"; else rm -rf "${D:?}"; fi
  echo changed=1; echo staged=1; echo restarted=0; echo why=not-created; echo healthy=1
}

# env-names <app>: the NAMES of the app's environment variables, one `env <KEY>` row each, sorted;
# never a value, so it is not audited as a reveal (env-ls is) and a dashboard can list them without
# ever holding a secret. Only the key part of each line is read; values are not even parsed.
cmd_env_names() {
  need_root
  valid_app "${1:-}" || die "invalid app name"
  local f line k
  if [[ ! -e $R/apps/$1 && -f $R/staged/$1/env ]]; then f=$R/staged/$1/env
  else app "$1"; f=$D/env; fi
  [[ -f $f ]] || return 0
  while IFS= read -r line; do
    k=${line%%=*}
    [[ $k =~ ^[A-Za-z_][A-Za-z0-9_]*$ && $line == *=* ]] && echo "env	$k"
  done < "$f" | sort -u
}

# env_edit op: apply stdin to E (set/unset), or list E (ls); returns 1 when there is nothing to save
env_edit() {
  local line k
  case $1 in
    ls)
      for k in "${!E[@]}"; do
        if [[ $k == DATABASE_URL || $k == DATABASE_URL_DIRECT ]]; then row env "$k" "$(mask_url "${E[$k]}")"; else row env "$k" "${E[$k]}"; fi
      done | sort
      return 1;;
    set)
      while IFS= read -r line; do
        k=${line%%=*}
        [[ $k =~ ^[A-Za-z_][A-Za-z0-9_]*$ && $line == *=* ]] || die "bad key: $k"
        protected_key "$k" && die "$k is set by tando"
        no_ctrl "${line#*=}" || die "control characters in the value of $k"
        E[$k]=${line#*=}
      done;;
    unset)
      local nokey="" n=0
      while IFS= read -r k; do
        [[ $k =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "bad key: $k"
        protected_key "$k" && die "$k is set by tando"
        if [[ -n ${E[$k]+x} ]]; then unset "E[$k]"; n=$((n + 1)); else nokey+=" $k"; fi
      done
      [[ -n $nokey ]] && echo "missing=${nokey# }"
      ((n)) || { echo changed=0; echo healthy=1; return 1; };;
    *) die "env: set, unset or ls";;
  esac
  return 0
}

# stop: Caddy answers 503 "stopped" at once (switched before the process stops, so requests in
# flight finish), and the unit is disabled so a reboot keeps it stopped.
# start/restart: proxy again first (Caddy holds new requests), then start; none fail.
cmd_svc() { # start|stop|restart app
  need_root; app "$2"; recover
  [[ -n ${S[current]:-} ]] || die "nothing deployed yet"
  lock 120; load "$D/state" S
  [[ $1 == stop ]] || held_refuse
  # each is a phase of its own: a crash in the middle leaves it recorded, and recover finishes it
  # (stop: stopped; start, restart: running)
  if [[ $1 == stop ]]; then
    [[ -n ${S[stopped]:-} ]] && { echo already=1; echo healthy=1; return; }
    S[stopped]=1; unset "S[down]"
    st phase stop || die "could not save the state"
    if ! { fp svc.caddy && stop_app; }; then
      unset "S[stopped]"; st phase idle; restart_app
      die "${WC_WHY:-systemctl stop failed}; $A was not stopped"
    fi
    st phase idle
    echo healthy=1
    return
  fi
  if has_unit && ! own_listener "${C[port]}" "tando-$A.service" && [[ $PROBE_WHY == *outside* ]]; then
    die "port ${C[port]} of $A is held by another process ($PROBE_WHY); stop it, then tando $1"
  fi
  if [[ $1 == start && -z ${S[stopped]:-}${S[down]:-} ]] && { ! has_unit || systemctl is-active -q "tando-$A"; }; then
    echo already=1; echo healthy=1; return
  fi
  st phase "$1" || die "could not save the state"
  if ! restart_app; then st phase idle; die "${WC_WHY:-systemctl $1 failed}"; fi
  workers_follow all || echo "tando-agent: $WF_WHY" >&2
  st phase idle
  fp svc.check
  if via_caddy "$(app_unit)"; then echo healthy=1; else echo healthy=0; fi
}

# app-down <unit>: run by tando-down@ when an app's unit has failed for good (start limit):
# Caddy answers 503 at once instead of holding requests for a process that is not coming back.
# (When the lock stays busy longer than its wait, recover sets down itself: rec_service)
cmd_app_down() {
  need_root; app "${1#tando-}"
  # wait for a command that holds the app (it may be what failed), then look again
  lockfile "$D/lock"; exec 9>"$D/lock"; flock -w 300 9 || return 0
  lock_mark app-down
  load "$D/state" S
  [[ $(systemctl show -P ActiveState "tando-$A") == failed ]] || return 0
  [[ -z ${S[stopped]:-} ]] || return 0
  S[down]=1
  fp down.caddy
  write_caddy || return 0          # (the page first: the state says down once visitors get it)
  save "$D/state" S
}

cmd_logs() { # app [n] [follow]
  app "$1"
  local n=${2:-100} follow=()
  [[ $n =~ ^[0-9]+$ ]] || die "bad count"
  [[ ${3:-} == follow ]] && follow=(-f)
  local j; j=$(jns)
  exec journalctl ${j:+"$j"} -u "tando-$A.service" -n "$n" --no-pager -o short-iso "${follow[@]}"
}

# exec-app <app> [dir]: runs as the app user inside its unit. The start command comes from
# app.conf. Without start_shell it is split on spaces and run with no shell.
cmd_exec_app() {
  app "$1"
  local dir=${2:-$D/current} argv
  [[ $dir == "$D/current" || $dir == "$D"/releases/* ]] || die "bad dir"
  cd "$dir" || die "no release"
  # the release's own settings (start command, recipe...), when app.conf describes another one:
  # a release in its pre-flight, or one a later deploy changed app.conf for (start_snap)
  local rid; rid=$(pwd -P); rid=${rid##*/}
  rel_conf "$rid"
  case ${C[recipe]:-node} in
    container) exec_container "$dir";;
    next) export HOSTNAME=127.0.0.1;;      # Next standalone binds to $HOSTNAME
    workerd) exec_workerd "$dir";;
    python) [[ -d $dir/.venv ]] && export VIRTUAL_ENV=$dir/.venv PATH="$dir/.venv/bin:$PATH";;
  esac
  [[ ${C[node_lite]:-} == true && ( ${C[recipe]:-node} == node || ${C[recipe]:-} == next ) && -x $R/lite/node ]] &&
    export PATH="$R/lite:$PATH"
  if [[ ${C[start_shell]:-} == true ]]; then exec /bin/sh -c "${C[start]}"; fi
  read -ra argv <<< "${C[start]}"
  exec "${argv[@]}"
}

# container: root Podman (podman itself needs root here, see docs/ARCHITECTURE.md), but the container
# runs as the app's own uid (one-uid user namespace: container root = tando-<app>), with no
# capabilities, no new privileges, a read-only root filesystem, published on 127.0.0.1 only
exec_container() {
  local dir=$1 img uid gid envf cport=${C[container_port]:-8080} k args
  [[ $EUID -eq 0 ]] || die "container apps start as root"
  img=$(< "$dir/IMAGE") || die "no image in $dir"
  uid=$(id -u "tando-$A") gid=$(id -g "tando-$A")
  declare -A E
  env_load E
  envf=$R/run/$A-$PORT.env
  install -d -m 700 "$R/run"
  for k in "${!E[@]}"; do printf '%s=%s
' "$k" "${E[$k]}"; done > "$envf"
  chmod 600 "$envf"
  # slirp4netns (a user-space network per container, port forwarded by its own process) rather
  # than the netavark bridge: with the bridge's NAT, a request in flight across a container switch
  # could hang instead of failing fast and being retried by Caddy
  args=(-d --sdnotify=conmon --rm --replace --init --name "tando-$A-$PORT" --cgroups=split --log-driver=passthrough
    --network=slirp4netns:port_handler=slirp4netns
    --pull=never --uidmap "0:$uid:1" --gidmap "0:$gid:1" --user 0:0 --read-only --cap-drop=all
    --security-opt=no-new-privileges -p "127.0.0.1:$PORT:$cport" -e "PORT=$cport" --env-file "$envf")
  if [[ -n ${C[data]:-} ]]; then   # podman (root) would mount a planted symlink's target
    shared_ok data || die "shared/data is not a directory of $AU (a symbolic link?): refusing to mount it"
    args+=(-v "$D/shared/data:${C[data]}")
  fi
  exec podman run "${args[@]}" "$img"
}

cmd_container_stop() { # app (ExecStop of a container unit): stop gracefully, then remove
  valid_app "${1:-}" || die "invalid app name"
  [[ ${PORT:-} =~ ^[0-9]+$ ]] || die "no PORT"
  podman stop -i -t 10 "tando-$1-$PORT" > /dev/null
  podman rm -f -i "tando-$1-$PORT" > /dev/null
}

# ---- scheduled jobs: ExecStart is always this runner; the command lives only in app.conf ----

trim() { local s=$1; s=${s%"${s##*[![:space:]]}"}; echo "${s#"${s%%[![:space:]]*}"}"; }

# Jobs take effect with a verified release and go back with it: each release keeps the jobs of
# the tando.conf it was deployed with ($D/jobs/<id>, root 600), and the job units are always
# those of the current release (jobs_follow, after a verify, a rollback or a recovery). A deploy
# whose release fails never changes the schedule. A release from before this rule has no such
# file: its jobs are those of app.conf.
jobs_snap() { # id: record the jobs of app.conf (C) as release id's
  local k
  # (mkdir, never install -d: that would recreate an app directory a destroy has just removed)
  [[ -d $D/jobs ]] || { mkdir -m 700 "$D/jobs" && chown root:root "$D/jobs"; } || return 1
  for k in "${!C[@]}"; do ! job_key "$k" || printf '%s=%s\n' "$k" "${C[$k]}"; done | sort > "$D/jobs/$1.tmp" &&
    mv -f "$D/jobs/$1.tmp" "$D/jobs/$1" || { rm -f "$D/jobs/$1.tmp"; return 1; }
}
# A release's settings belong to it, like its code: every tando.conf setting it was deployed with
# ($D/start/<id>: start, health... and memory, path, jobs; readable by the app: exec-app runs as its
# user and takes the start command from it). A release without such a file starts with app.conf's:
# it is the newest one. A file written before this rule has only start, start_shell, health and
# health_expect (no conf=1): only those come back from it.
# start_back: app.conf says again how the live release (or the one going live: a rollback, a
# revert) starts, is checked and runs (conf_put then makes the unit file follow)
start_back() { # live id
  local k
  local -A RS=()
  valid_id "${1:-}" && [[ -f $D/start/$1 ]] || return 0
  load "$D/start/$1" RS
  if [[ ${RS[conf]:-} == 1 ]]; then rec_put RS C
  else
    for k in start start_shell health health_expect; do
      [[ -n ${RS[$k]+x} ]] || continue                    # (a file from before a key was recorded)
      if [[ -n ${RS[$k]} ]]; then C[$k]=${RS[$k]}; else unset "C[$k]"; fi
    done
  fi
  save "$D/app.conf" C
}
start_snap() { # id: record release id's settings (app.conf, C, as it is now)
  local g=root
  getent group "tando-m-$A" > /dev/null && meta_group_ok && g=tando-m-$A
  [[ -d $D/start ]] || { mkdir -m 750 "$D/start" && chown "root:$g" "$D/start"; } || return 1
  # (start, start_shell, health, health_expect always: empty is a value too)
  # (keys=: the settings this agent knows; one the record lacks was not set. A later key is not in
  # it: rec_put keeps the app's value of that one)
  { printf 'conf=1\nkeys=%s\nstart=%s\nstart_shell=%s\nhealth=%s\nhealth_expect=%s\n' "${CONF_KEYS_A[*]} job.* worker.*" \
      "${C[start]:-}" "${C[start_shell]:-}" "${C[health]:-}" "${C[health_expect]:-}"
    conf_text C | grep -Ev '^(start|start_shell|health|health_expect)='; true; } > "$D/start/$1.tmp" &&
    [[ $(head -1 "$D/start/$1.tmp") == conf=1 ]] &&
    chown "root:$g" "$D/start/$1.tmp" && chmod 640 "$D/start/$1.tmp" &&
    mv -f "$D/start/$1.tmp" "$D/start/$1" || { rm -f "$D/start/$1.tmp"; return 1; }
}
# rel_conf id: C takes release id's own settings (start/<id>); a file from before conf=1: its
# start command only
rel_conf() {
  local k
  valid_id "${1:-}" && [[ -r $D/start/$1 ]] || return 0
  local -A RS=(); load "$D/start/$1" RS
  if [[ ${RS[conf]:-} == 1 ]]; then rec_put RS C
  elif [[ -n ${RS[start]:-} ]]; then C[start]=${RS[start]} C[start_shell]=${RS[start_shell]:-}
  fi
  return 0
}
# conf_key key: a setting of tando.conf (what configure takes from the client): it belongs to a
# release. The rest of app.conf is the server's own (port, created, domains, origin, adopt's)
CONF_KEYS_A=(recipe image container_port build_memory start start_shell release release_shell release_timeout
  health path data writable backup database db_statement_timeout db_idle_tx_timeout db_temp_limit
  memory health_timeout soak cpu tasks max_conns max_requests stop_timeout hold log_max log_keep
  log_rate access_log request_log_max health_expect health_fails health_recover job_timeout job_spread
  job_missed assets compress priority db_pool db_direct idle_stop tmp_size io disk response_timeout body_max cold_timeout node_lite)
CONF_KEYS=" ${CONF_KEYS_A[*]} "
# what a record of the first agent that recorded every setting knew (conf=1 without keys=)
CONF_KEYS1="${CONF_KEYS% job_spread job_missed assets compress priority db_pool db_direct idle_stop tmp_size io disk response_timeout body_max cold_timeout node_lite } job.* "
conf_key() {
  case $1 in job.*|worker.*) return 0;; *[[:space:]]*|'') return 1;; esac
  [[ $CONF_KEYS == *" $1 "* ]]
}
# rec_put record target: target (C, or a copy of it) takes a release's recorded settings (a conf=1
# record of start/<id>). A setting the record knows (its keys=) but does not have was not set for
# that release: it goes. One the record does not know (written before that setting existed) keeps
# target's value: a rollback to an older release never drops what it could not record
rec_put() {
  local -n _rp=$1 _rt=$2
  local k g known=" ${_rp[keys]:-$CONF_KEYS1} "
  for k in "${!_rt[@]}"; do
    conf_key "$k" && [[ -z ${_rp[$k]+x} ]] || continue
    g=$k; [[ $k == *.* ]] && g="${k%%.*}.*"
    [[ $known == *" $g "* ]] && unset "_rt[$k]"
  done
  for k in "${!_rp[@]}"; do conf_key "$k" && _rt[$k]=${_rp[$k]}; done
  return 0
}
# conf_text array: its tando.conf settings, sorted key=value lines
conf_text() {
  local -n _ct=$1
  local k
  for k in "${!_ct[@]}"; do if conf_key "$k"; then printf '%s=%s\n' "$k" "${_ct[$k]}"; fi; done | sort
}
# conf_copy from to: one associative array into another (the whole of it)
conf_copy() {
  local -n _cf=$1 _cto=$2
  local k
  _cto=(); for k in "${!_cf[@]}"; do _cto[$k]=${_cf[$k]}; done
}
# conf_stage: C's tando.conf settings into $D/confs/<checksum>; prints the checksum (the conf id).
# Kept a day after its last configure (prune)
conf_stage() {
  local t h
  [[ -d $D/confs ]] || { mkdir -m 700 "$D/confs" && chown root:root "$D/confs"; } || return 1
  t=$(conf_text C) || return 1
  # (the domains of tando.conf this deploy adds when it goes live: configure's DOM_STAGE)
  [[ -z ${DOM_STAGE:-} ]] || t+=$'\n'"domain_add=$DOM_STAGE"
  h=$(printf '%s\n' "$t" | cksum | cut -d' ' -f1)
  [[ $h =~ ^[0-9]+$ ]] || return 1
  if [[ -f $D/confs/$h ]] && cmp -s "$D/confs/$h" <(printf '%s\n' "$t"); then touch "$D/confs/$h"
  else printf '%s\n' "$t" > "$D/confs/$h.tmp" && [[ -s $D/confs/$h.tmp ]] && mv -f "$D/confs/$h.tmp" "$D/confs/$h" ||
         { rm -f "$D/confs/$h.tmp"; return 1; }
  fi
  echo "$h"
}
# conf_put: app.conf, the unit file and the backup timer as C says (Caddy's site follows at the
# app's next restart_app or write_caddy). Only what differs is written; systemd is reloaded only
# when the unit file changed
conf_put() {
  local bk
  local pr; pr=$(sed -n 's/^priority=//p' "$D/app.conf" 2> /dev/null)
  bk=$(sed -n 's/^backup=//p' "$D/app.conf" 2> /dev/null)
  save "$D/app.conf" C || return 1
  WU_CHANGED=0
  write_unit || return 1
  ((WU_CHANGED)) && systemctl daemon-reload
  [[ $pr == "${C[priority]:-}" ]] || prio_sync
  [[ $bk == "${C[backup]:-}" ]] || sync_backup_timer
  [[ -x $LOGS ]] && "$LOGS" app-setup "$A" > /dev/null
  db_follow
  return 0
}
# shellcheck disable=SC2034  # J is read by sync_jobs through its nameref
jobs_load() { # array: the jobs of the current release (none without one)
  local -n _jl=$1
  local id=${S[current]:-} k
  _jl=()
  if [[ -n $id && -f $D/jobs/$id ]]; then load "$D/jobs/$id" _jl
  elif [[ -n $id ]]; then for k in "${!C[@]}"; do ! job_key "$k" || _jl[$k]=${C[$k]}; done; fi
  return 0
}
jobs_follow() { # the job units become those of the current release (none without one)
  local -A J=()
  jobs_load J
  sync_jobs J
}
# job_key key: a setting that belongs to the jobs (and goes with a release): job.<name>,
# job.<name>.timeout, job_timeout
job_key() { [[ $1 == job.* || $1 == job_timeout || $1 == job_spread || $1 == job_missed ]]; }
# job_names [array]: the names of the jobs in app.conf (or the array), sorted
job_names() {
  local -n _jn=${1:-C}
  local k
  for k in "${!_jn[@]}"; do [[ $k != job.* || $k == job.*.* ]] || echo "${k#job.}"; done | sort
}
# Job units are tando-<app>_job-<name>.service and .timer. "_" is in neither an app nor a job name,
# so a unit name says exactly whose job it is. The form before, tando-<app>-job-<name>, did not:
# app x-job-y's own service was also job y of app x, and app foo's glob tando-foo-job-* took the
# timers of app foo-job (sync_jobs of foo deleted them). Units of that form are this app's only by
# their runner line (old_job_owner), and sync_jobs replaces them with the new ones.
job_unit() { echo "tando-${A}_job-$1"; }   # name -> unit name without .service/.timer
# job_busy unit: a run of the job is going on (a oneshot is "activating" while it runs, and
# "deactivating" while its job-end hook runs: is-active says neither)
job_busy() { case $(systemctl show -P ActiveState "$1" 2> /dev/null) in activ*|deactivating|reloading) return 0;; esac; return 1; }
JOB_SPREAD=15      # seconds a job's start is spread over when its period is unknown (job_spread sets it)
JOB_SPREAD_MAX=600 # the default spread: a sixth of the job's period, at most this (hourly: 10 min)
# job_spread_for calendar: the default spread of a job (seconds): a sixth of the time between its
# next two runs, at most JOB_SPREAD_MAX. 100 apps' hourly jobs then start over 10 minutes, not in
# the same 15 s (each timer at its own fixed offset: FixedRandomDelay)
job_spread_for() {
  local t
  local o; o=$(systemd-analyze calendar --iterations=2 "$1" 2> /dev/null)
  # (the "(in UTC)" lines are there only when the server's zone is not UTC)
  t=$(sed -n 's/^ *(in UTC): //p' <<< "$o" | head -2)
  # (the second time: "Iter. #2:" in older systemd, "Iteration #2:" in 259)
  [[ $t == ?*$'\n'?* ]] || t=$(sed -n 's/^ *Next elapse: //p; s/^ *Iter\. #2: //p; s/^ *Iteration #2: //p' <<< "$o" | head -2)
  [[ $t == ?*$'\n'?* ]] || { echo "$JOB_SPREAD"; return 0; }
  t=$(( $(date -d "$(tail -1 <<< "$t")" +%s 2> /dev/null || echo 0) - $(date -d "$(head -1 <<< "$t")" +%s 2> /dev/null || echo 0) ))
  ((t > 0)) || { echo "$JOB_SPREAD"; return 0; }
  t=$((t / 6)); ((t > JOB_SPREAD_MAX)) && t=$JOB_SPREAD_MAX
  echo "$t"
}
JOB_TIMEOUT=3600   # seconds a job may run unless job_timeout or job.<name>.timeout says otherwise
# old_job_owner unit: the app a unit of the form before belongs to, from the line its service file
# was written with (ExecStart=<agent> run-job <app> <name>, which no other app's unit has); fails
# for any other unit
old_job_owner() {
  local b=${1%.service} l a n x
  b=${b%.timer}
  [[ $b == tando-*-job-* && -f /etc/systemd/system/$b.service ]] || return 1
  l=$(grep -m1 "^ExecStart=$AGENT run-job " "/etc/systemd/system/$b.service") || return 1
  read -r _ _ a n x <<< "$l"
  [[ -z $x && $b == "tando-$a-job-$n" ]] && valid_app "$a" && echo "$a"
}
# sync_jobs [array]: the units of exactly these jobs (default: app.conf's); only what differs is
# written, systemd is reloaded once and only then, a timer is enabled only when it is not yet.
# A job runs at most its timeout (job.<name>.timeout, else job_timeout, else JOB_TIMEOUT seconds):
# TimeoutStartSec of its oneshot unit, so systemd ends it and records the result "timeout" (tando
# jobs, tando jobs run and the job alert say so). Returns 1 when a unit could not be written or
# enabled (a full disk): the caller does not count it done (op_trailer: recovery syncs them again)
sync_jobs() {
  local -n _jobs=${1:-C}
  local k n f x cal to b st want=" " changed=0 new=() rc=0 sp ms per paused=" "
  [[ -f $D/jobpaused ]] && paused=" $(tr '\n' ' ' < "$D/jobpaused")"
  for n in $(job_names "${1:-C}"); do
    k=job.$n
    cal=$(trim "${_jobs[$k]%%|*}")
    if ! systemd-analyze calendar "$cal" &> /dev/null; then
      echo "tando-agent: bad schedule for job $n: $cal (left out)" >&2; continue
    fi
    to=${_jobs[$k.timeout]:-${_jobs[job_timeout]:-$JOB_TIMEOUT}}
    [[ $to =~ ^[1-9][0-9]{0,4}$ ]] || to=$JOB_TIMEOUT
    sp=${_jobs[$k.spread]:-${_jobs[job_spread]:-}}
    [[ $sp =~ ^[0-9]{1,4}$ ]] || sp=$(job_spread_for "$cal")
    ms=${_jobs[$k.missed]:-${_jobs[job_missed]:-run}}; per=true; [[ $ms == skip ]] && per=false
    want+="$n "
    b=$(job_unit "$n"); f=/etc/systemd/system/$b
    [[ -f $f.service && -f $f.timer ]] || changed=1
    # (a file cut short by a full disk is never installed: each must end with its last line)
    if ! { fp jobs.write &&
           { printf '[Unit]\nDescription=tando job %s %s\n\n[Service]\nType=oneshot\n' "$A" "$n"
             printf 'ExecStart=%s run-job %s %s\nWorkingDirectory=%s\nTimeoutStartSec=%s\n' "$AGENT" "$A" "$n" "$(job_dir)" "$to"
             # the run's start and end are recorded by the agent as root (a hook that fails changes
             # nothing: "-"; "+": outside the job's sandbox): the history and the log of the run
             printf 'ExecStartPre=-+%s job-begin %s %s\nExecStopPost=-+%s job-end %s %s\n' "$AGENT" "$A" "$n" "$AGENT" "$A" "$n"
             # a time of the timer that passed while a run was still going on is skipped, not run
             # at once when that run ends (job-due: systemd would start the job right away)
             printf 'ExecCondition=+%s job-due %s %s\n' "$AGENT" "$A" "$n"
             props - job
             echo "# end"
           } > "$f.service.new" && [[ $(tail -1 "$f.service.new") == "# end" ]] &&
           { printf '[Unit]\nDescription=tando job timer %s %s\n\n[Timer]\nOnCalendar=%s\nAccuracySec=1s\nPersistent=%s\n' "$A" "$n" "$cal" "$per"
             ((sp > 0)) && printf 'RandomizedDelaySec=%s\nFixedRandomDelay=yes\n' "$sp"
             printf '\n[Install]\nWantedBy=timers.target\n'
           } > "$f.timer.new" && [[ $(tail -1 "$f.timer.new") == WantedBy=timers.target ]]; }; then
      rm -f "$f.service.new" "$f.timer.new"
      echo "tando-agent: could not write the units of job $n (disk full?)" >&2; rc=1; continue
    fi
    for x in service timer; do
      if cmp -s "$f.$x.new" "$f.$x"; then rm -f "$f.$x.new"
      elif mv -f "$f.$x.new" "$f.$x"; then changed=1
      else rm -f "$f.$x.new"; echo "tando-agent: could not install the $x of job $n" >&2; rc=1; fi
    done
    new+=("$b.timer")
  done
  # units of the form before that are this app's (migration): the new unit takes over the timer's
  # last run (its stamp: a Persistent timer that missed a run while the server was off still runs
  # it), then the old one goes; never another app's unit of a similar name
  for f in /etc/systemd/system/tando-"$A"-job-*.service; do
    [[ -f $f ]] || continue
    b=${f##*/}; b=${b%.service}
    [[ $(old_job_owner "$b") == "$A" ]] || continue
    n=${b#tando-"$A"-job-}
    st=/var/lib/systemd/timers/stamp-$b.timer
    if [[ $want == *" $n "* && -f $st && ! -f /var/lib/systemd/timers/stamp-$(job_unit "$n").timer ]]; then
      cp -p "$st" "/var/lib/systemd/timers/stamp-$(job_unit "$n").timer"
    fi
    systemctl disable -q --now "$b.timer" 2> /dev/null
    # (its service's failed state would stay in systemctl --failed as "not-found failed" once the
    # file is gone: seen on a real server upgraded from 0.1.1, until it rebooted)
    systemctl reset-failed "$b.service" "$b.timer" 2> /dev/null
    rm -f "/etc/systemd/system/$b.timer" "$f" "$st"; changed=1
  done
  for f in /etc/systemd/system/tando-"$A"_job-*.timer; do
    [[ -f $f ]] || continue
    b=${f##*/}; b=${b%.timer}; n=${b#tando-"$A"_job-}
    [[ $want == *" $n "* ]] && continue
    systemctl disable -q --now "$b.timer"
    rm -f "$f"; changed=1
    # a run still going on finishes within its own timeout (a data job is never cut off half-way):
    # its unit file stays until it ends, then its job-end hook removes it (job_gone). Removed
    # now, systemd would end the run after 90 s and keep a "not-found failed" unit
    if job_busy "$b.service"; then
      echo "tando-agent: job $n of $A is no longer in tando.conf; its run in progress finishes first" >&2
    else rm -f "${f%.timer}.service"; systemctl reset-failed "$b.service" 2> /dev/null; fi
    [[ $paused == *" $n "* ]] && job_unpause "$n"   # (added again later, a job is not paused)
  done
  # the unit of a removed job whose last run has ended since (its job-end hook did not get to it)
  for f in /etc/systemd/system/tando-"$A"_job-*.service; do
    [[ -f $f && ! -f ${f%.service}.timer ]] || continue
    b=${f##*/}; b=${b%.service}
    job_busy "$b.service" && continue
    rm -f "$f"; systemctl reset-failed "$b.service" 2> /dev/null; changed=1
  done
  ((changed)) && dreload
  # the timers not yet enabled and running, in one call (200 jobs: one systemctl, not 200)
  local todo=() off=()
  for k in ${new[@]+"${new[@]}"}; do
    x=${k#"tando-${A}_job-"}
    # paused: the timer is off and stays off (tando jobs resume); a held app's are all off (cmd_hold)
    if [[ -n ${S[hold]:-} || $paused == *" ${x%.timer} "* ]]; then
      systemctl -q is-enabled "$k" 2> /dev/null || systemctl -q is-active "$k" && off+=("$k")
      continue
    fi
    systemctl -q is-enabled "$k" 2> /dev/null && systemctl -q is-active "$k" && continue
    todo+=("$k")
  done
  ((${#off[@]})) && systemctl disable -q --now "${off[@]}" 2> /dev/null
  # (a timer systemd has not read yet: host setup's one reload comes too late for it)
  ((${#todo[@]})) && [[ -n ${DR_FLAG:-} && -f $DR_FLAG ]] && systemctl daemon-reload
  ((${#todo[@]})) && { systemctl enable -q --now "${todo[@]}" || rc=1; }
  return $rc
}

# where jobs run: the current release, or shared/ when the app user cannot read the release
job_dir() { if has_unit && [[ ${C[recipe]:-node} != container ]]; then echo "$D/current"; else echo "$D/shared"; fi; }

cmd_run_job() { # app name (as the app user)
  app "$1"
  local cmd=${C[job.$2]:-}
  [[ -n $cmd ]] || die "no such job"
  cd "$(job_dir)" || die "no release"
  exec /bin/bash -c "${cmd#*|}"
}

# The journal side of a job's runs, shared by job-run, the run hooks and job-log. A run's lines are
# those its unit wrote after a cursor taken before it started (the comment in cmd_job_run says why
# not its invocation id or a time window): the unit's stdout/stderr, in its app's journal namespace
# (or the system journal when it has none).
# (only this app's namespace and the main journal: --namespace='*' opens every app's journal
# files, so with N apps each job start read N namespaces)
job_jq() { local j; j=$(jns); JQ=(journalctl ${j:+"$j"} "_SYSTEMD_UNIT=$1" _TRANSPORT=stdout -o cat --no-pager); }
job_jsync() { local j; j=$(jns); journalctl --sync 2> /dev/null; [[ -n $j ]] && journalctl "$j" --sync 2> /dev/null; return 0; }
job_cursor() { # unit: the cursor of the last line it wrote (empty: none yet)
  local JQ; job_jq "$1"
  "${JQ[@]}" -n 1 --show-cursor 2> /dev/null | sed -n 's/^-- cursor: //p'
}
job_hist_dir() { [[ -d $D/jobhist ]] || { mkdir -m 700 "$D/jobhist" && chown root:root "$D/jobhist"; } 2> /dev/null; [[ -d $D/jobhist ]]; }
job_unpause() { # name: the job is no longer paused
  [[ -f $D/jobpaused ]] || return 0
  grep -vx -- "$1" "$D/jobpaused" > "$D/jobpaused.tmp"; mv -f "$D/jobpaused.tmp" "$D/jobpaused"
  [[ -s $D/jobpaused ]] || rm -f "$D/jobpaused"
}
# job-begin / job-end <app> <name>: run by the job's unit as root (ExecStartPre, ExecStopPost; a
# failing hook never changes the job's result). They keep the history of the job: one line per run
# in $D/jobhist/<name> (start, seconds, result, exit status, the journal cursor its output started
# after; never the output itself), the last 50 runs, whatever the journal has rotated away.
# job slots: at most job_slots runs of jobs (all apps together; host.conf, default the number of
# CPUs, at least 2) at once. A run waits in job-begin for a slot ($R/jobslots/<i>, made with mkdir:
# atomic), holds it until its job-end, and takes over one whose run has ended without a job-end
# (its unit no longer runs, or it is this same unit: a unit runs once at a time). The wait counts
# in the job's timeout.
job_slots() {
  local k=${H[job_slots]:-}
  [[ $k =~ ^[1-9][0-9]{0,2}$ ]] || { k=$(nproc 2> /dev/null || echo 2); ((k < 2)) && k=2; }
  echo "$k"
}
job_slot_take() { # unit
  local k i d u t
  [[ -d $R/jobslots ]] || mkdir -m 700 "$R/jobslots" 2> /dev/null
  k=$(job_slots)
  while :; do
    for ((i = 1; i <= k; i++)); do
      d=$R/jobslots/$i
      if mkdir "$d" 2> /dev/null; then echo "$1" > "$d/unit"; return 0; fi
      u=$(cat "$d/unit" 2> /dev/null)
      if [[ -z $u ]]; then   # (just made by another run: its unit comes in a moment)
        t=$(stat -c %Y "$d" 2> /dev/null) || continue
        (( $(now) - t > 10 )) || continue
      elif [[ $u != "$1" ]] && job_busy "$u"; then continue; fi
      echo "$1" > "$d/unit"; return 0     # (its run is over: taken over)
    done
    sleep 1
  done
}
job_slot_give() { # unit
  local d
  for d in "$R"/jobslots/*/; do
    [[ $(cat "$d/unit" 2> /dev/null) == "$1" ]] && rm -rf "${d:?}"
  done
  return 0
}
cmd_job_begin() {
  need_root; app "$1"
  local n=${2:-} cur
  [[ $n =~ ^[a-z][a-z0-9-]{0,20}$ ]] || return 0
  job_slot_take "$(job_unit "$n").service"
  job_jsync
  cur=$(job_cursor "$(job_unit "$n").service")
  job_hist_dir || return 0
  printf '%s\n%s\n' "$(ds)" "$cur" > "$D/jobhist/$n.run.tmp" && mv -f "$D/jobhist/$n.run.tmp" "$D/jobhist/$n.run"
}
cmd_job_end() {
  need_root; app "$1"
  local n=${2:-} f t0="" cur="" t1 res=${SERVICE_RESULT:-} st=${EXIT_STATUS:-} lines
  [[ $n =~ ^[a-z][a-z0-9-]{0,20}$ ]] || return 0
  # a time skipped by job-due is no run: nothing in the history
  [[ $res == exec-condition ]] && return 0
  job_slot_give "$(job_unit "$n").service"
  job_hist_dir || return 0
  f=$D/jobhist/$n; t1=$(ds)
  echo "$t1" > "$f.end"   # (when this run ended, in tenths of a second: job-due)
  # a job removed from tando.conf while this run went on: its unit goes once the run has ended
  [[ -f /etc/systemd/system/$(job_unit "$n").timer ]] || job_gone "$n"
  [[ -f $f.run ]] && { { read -r t0; read -r cur; } < "$f.run"; }
  [[ $t0 =~ ^[0-9]+$ ]] || t0=$t1
  [[ $res =~ ^[a-z-]{1,20}$ ]] || res=unknown
  [[ $res == success ]] && st=0
  [[ $st =~ ^[A-Za-z0-9_-]{1,12}$ ]] || st=-
  printf '%s\t%s.%s\t%s\t%s\t%s\n' "$((t0 / 10))" "$(((t1 - t0) / 10))" "$(((t1 - t0) % 10))" "$res" "$st" "$cur" >> "$f"
  rm -f "$f.run"
  # (at most 50 runs: cut back to 50 when it has 70, so that most runs only append)
  lines=$(wc -l < "$f")
  if ((lines > 70)); then tail -n 50 "$f" > "$f.tmp" && mv -f "$f.tmp" "$f"; fi
  return 0
}

# job_gone name: the unit of a job removed from tando.conf, once its last run has ended. Called by
# that run's own job-end (ExecStopPost: the unit is still deactivating then), so the removal waits
# in a unit of its own (job-gone) for the run's unit to be inactive or failed.
job_gone() {
  systemd-run --quiet --no-block --collect --unit="tando-${A}_jobgone-$1" "$AGENT" job-gone "$A" "$1" > /dev/null 2>&1 ||
    echo "tando-agent: the unit of removed job $1 stays until the next deploy removes it" >&2
}
cmd_job_gone() {
  need_root; app "$1"
  local n=${2:-} u i
  [[ $n =~ ^[a-z][a-z0-9-]{0,20}$ ]] || return 0
  u=$(job_unit "$n")
  [[ -f /etc/systemd/system/$u.timer ]] && return 0   # (added again since)
  for ((i = 0; i < 600; i++)); do   # (at most a minute: ExecStopPost ends within its own timeout)
    case $(systemctl show -P ActiveState "$u.service") in inactive|failed) break;; esac
    sleep 0.1
  done
  lock 60
  [[ -f /etc/systemd/system/$u.timer ]] && return 0
  rm -f "/etc/systemd/system/$u.service" "$D/jobhist/$n.end"
  systemctl daemon-reload
  systemctl reset-failed "$u.service" 2> /dev/null
  return 0
}
# job-due <app> <name>: the job's ExecCondition (as root). A timer whose time passed while the
# job's previous run was still going on starts the job again as soon as that run ends (systemd
# counts the next time from the last one it fired at). That time is skipped (COMMANDS.md: the time
# that was missed is not run): the job starts only when a time of its schedule came after the end
# of its last run. A run by hand (job-run: $D/jobhist/<name>.now) always starts; so does every run
# when the end of the last one or the next time is not known (an older systemd: no --base-time).
cmd_job_due() {
  need_root; app "$1"
  local n=${2:-} cal e nx now
  [[ $n =~ ^[a-z][a-z0-9-]{0,20}$ ]] || return 0
  [[ -z ${S[hold]:-} ]] || exit 1   # (held: no job runs, by its timer or by hand)
  [[ -f $D/jobhist/$n.now ]] && { rm -f "$D/jobhist/$n.now"; return 0; }
  read -r e 2> /dev/null < "$D/jobhist/$n.end" || return 0
  [[ $e =~ ^[0-9]{10,12}$ ]] || return 0
  cal=$(sed -n 's/^OnCalendar=//p' "/etc/systemd/system/$(job_unit "$n").timer" 2> /dev/null)
  [[ -n $cal ]] || return 0
  # (the time in UTC: "(in UTC): ..." when the server's zone is another, else "Next elapse: ...")
  nx=$(systemd-analyze calendar --base-time="@$((e / 10))" "$cal" 2> /dev/null |
    sed -n 's/^ *\(Next elapse\|(in UTC)\): [A-Za-z]* \([0-9-]* [0-9:]*\) UTC$/\2/p' | tail -1)
  [[ -n $nx ]] && nx=$(date -u -d "$nx" +%s 2> /dev/null) || return 0
  now=$(ds)
  # (silent: a line here would be in the journal between two runs, read as the last run's output.
  # systemd notes the skip itself. Exit 1: ExecCondition skips; the dispatcher would make a return 0)
  ((now >= nx * 10)) || exit 1
  return 0
}

# job-run <app> <name>: run a scheduled job now, in its own unit (tando-<app>_job-<name>.service:
# the fixed runner run-job and the job sandbox, props - job), wait for it, then print its output
# (log=<line>, the last 200 lines of this run) and result=, status= (its exit status), secs=.
# A run the timer started already is waited for, not doubled.
cmd_job_run() {
  need_root; app "$1"
  local n=${2:-} u inv t0 l SAN
  [[ $n =~ ^[a-z][a-z0-9-]{0,20}$ && -n ${C[job.$n]:-} ]] || die "$A has no job ${n//[^A-Za-z0-9_-]/?} (tando jobs lists them)"
  u=$(job_unit "$n").service
  held_refuse
  [[ -f /etc/systemd/system/$u ]] ||
    die "job $n is not scheduled yet: jobs take effect with the first verified release that has them (tando up; tando status)"
  AUDIT_NOTE="job $n"
  t0=$(ds)
  # the job's stdout/stderr of this run is what its unit wrote after the last line it had written
  # before (a cursor), in its app's journal namespace (or the system journal when it has none).
  # Not by invocation id: journald reads the id from the process, and a job that ends within
  # milliseconds is gone by then (seen: its lines stored without the id). Not by time either: the
  # clock a command reads and journald's stamps were seen half a second apart on a virtual machine.
  # A unit runs one job at a time, so every line of it after the cursor is this run's.
  local i out cur="" JQ jq; job_jq "$u"; jq=("${JQ[@]}")
  jsync() { job_jsync; }
  jsync
  cur=$(job_cursor "$u")
  # (a run by hand is never refused by systemd's start limit, which a job that failed a few times
  # in a row would have reached: the old result would then be printed as this run's)
  systemctl reset-failed "$u" 2> /dev/null
  # (a run by hand is not a time of the schedule: job-due lets it start)
  job_hist_dir && : > "$D/jobhist/$n.now"
  systemctl start "$u" < /dev/null 2> /dev/null   # (a oneshot: returns when the job has ended)
  rm -f "$D/jobhist/$n.now"   # (a run the timer had started was waited for: no flag is left)
  inv=$(systemctl show -P InvocationID "$u")
  if [[ $inv =~ ^[0-9a-f]{32}$ ]]; then
    # journald may still be writing the last lines: wait up to 3 s for them
    for i in 1 2 3 4 5 6; do
      jsync
      if [[ -n $cur ]]; then out=$("${jq[@]}" --after-cursor="$cur" 2> /dev/null | tail -n 200)
      else out=$("${jq[@]}" -n 200 2> /dev/null); fi
      [[ -n $out ]] && break
      sleep 0.5
    done
    [[ -n $out ]] && while IFS= read -r l; do san_v "$l"; echo "log=$SAN"; done <<< "$out"
  fi
  # this run's result is the history line its own job-end wrote (started at t0 or later): the unit's
  # Result belongs to its LAST start, and a timer start that came as this run ended is skipped by
  # job-due ("exec-condition") and would be printed as this run's (seen with a 20 s schedule).
  # systemd's own answer only when the history has no line of this run (an older unit, no hook)
  local res="" st="" hs hd hr hc
  if [[ -f $D/jobhist/$n ]]; then
    while IFS=$'\t' read -r hs hd hr hc _; do
      [[ $hs =~ ^[0-9]+$ ]] && ((hs >= t0 / 10 - 1)) && { res=$hr st=$hc; }
    done < <(tail -n 5 "$D/jobhist/$n")
  fi
  if [[ -z $res || $res == exec-condition ]]; then
    res=$(systemctl show -P Result "$u") st=$(systemctl show -P ExecMainStatus "$u")
  fi
  echo "result=$res"
  echo "status=$st"
  echo "timeout=$(systemctl show -P TimeoutStartUSec "$u")"
  echo "secs=$(el "$t0")"
  [[ $res == success ]] || AUDIT_RESULT=1
  return 0
}

# jobs <app> [full]: one `job` row per job (name, schedule, next, last run, result, exit status,
# command), then `jobx` (name, on|paused|running, duration of the last run, the next 3 run times as
# the server writes them: "full" only, it starts systemd-analyze once per job) and `zone`. The last
# run is the last line of the job's history (job-end); a job from before it has systemd's memory.
cmd_jobs() {
  app "$1"
  local k n line last x hs hd hr hc nx nxt state paused=" " lq u
  declare -A U
  [[ -f $D/jobpaused ]] && paused=" $(tr '\n' ' ' < "$D/jobpaused")"
  for n in $(job_names); do
    k=job.$n; U=(); u=$(job_unit "$n")
    while IFS= read -r line; do U[${line%%=*}]=${line#*=}; done < <(
      systemctl show --timestamp=unix -p NextElapseUSecRealtime,LastTriggerUSec "$u.timer"
      systemctl show --timestamp=unix -p Result,ExecMainStatus,ExecMainStartTimestamp,ActiveState "$u.service")
    # the last run: the timer's, or a later one by hand (tando jobs run) or as its timer does
    last=${U[LastTriggerUSec]#@} x=${U[ExecMainStartTimestamp]#@}
    [[ $x =~ ^[0-9]+$ ]] && { [[ ! $last =~ ^[0-9]+$ ]] || ((x > last)); } && last=$x
    hs="" hd=- hr=${U[Result]:-} hc=${U[ExecMainStatus]:-}
    if [[ -f $D/jobhist/$n ]]; then
      while IFS=$'\t' read -r x line lq nxt _; do hs=$x hd=$line hr=$lq hc=$nxt; done < "$D/jobhist/$n"
      [[ $hs =~ ^[0-9]+$ ]] && last=$hs
    fi
    state=on; [[ ${U[ActiveState]:-} == activ* ]] && state=running
    # no run has ended yet (no history; systemd says success until one has): never, or running
    # while the first goes on. A time job-due skipped is no run either (its unit has no start)
    if [[ -z $hs && ( $state == running || ! ${U[ExecMainStartTimestamp]#@} =~ ^[1-9][0-9]*$ ) ]]; then
      last="" hc=""; if [[ $state == running ]]; then hr=running; else hr=""; fi
    fi
    [[ $paused == *" $n "* ]] && state=paused
    nx=("" "" "")
    if [[ ${2:-} == full && $state != paused ]]; then
      local i=0
      while IFS= read -r line; do
        [[ $line =~ ^[[:space:]]*(Next\ elapse|Iteration\ \#[0-9]+):\ [A-Za-z]{3}\ ([0-9-]+\ [0-9:]+\ [A-Za-z0-9+:/_-]+)$ ]] || continue
        nx[i++]=${BASH_REMATCH[2]}
      done < <(systemd-analyze calendar --iterations=3 "$(trim "${C[$k]%%|*}")" 2> /dev/null)
    fi
    row job "$n" "${C[$k.cron]:-$(trim "${C[$k]%%|*}")}" "${U[NextElapseUSecRealtime]#@}" "$last" "$hr" "$hc" "$(trim "${C[$k]#*|}")"
    row jobx "$n" "$state" "$hd" "${nx[0]}" "${nx[1]}" "${nx[2]}"
  done
  x=$(readlink /etc/localtime 2> /dev/null); row zone "$(date +%Z)" "${x#*zoneinfo/}"
}

# job-pause <app> <name> pause|resume: switch a job's timer off and on again without touching
# tando.conf. The name goes into $D/jobpaused, which sync_jobs reads: a paused job's timer is never
# enabled, so a deploy, a recovery or a reboot leaves it off. A run in progress finishes; a run by
# hand (tando jobs run) still works.
cmd_job_pause() {
  need_root; app "$1"
  local n=${2:-} how=${3:-}
  [[ $how == pause || $how == resume ]] || die "job-pause: pause or resume"
  lock 30
  local -A J=(); jobs_load J
  [[ $n =~ ^[a-z][a-z0-9-]{0,20}$ && -n ${J[job.$n]:-} ]] || die "$A has no job ${n//[^A-Za-z0-9_-]/?} (tando jobs lists them)"
  AUDIT_NOTE="job $n $how"
  if [[ $how == pause ]]; then
    { [[ -f $D/jobpaused ]] && grep -vx -- "$n" "$D/jobpaused"; echo "$n"; } | sort > "$D/jobpaused.tmp" &&
      mv -f "$D/jobpaused.tmp" "$D/jobpaused" || die "could not record the pause (disk full?)"
    chmod 600 "$D/jobpaused"
  else
    job_unpause "$n"
    # (a Persistent timer made up what it missed while it was off: a resume would start the job at
    # once. The time of its last run is the stamp's: now, so that the next run is the next time.)
    touch "/var/lib/systemd/timers/stamp-$(job_unit "$n").timer" 2> /dev/null
  fi
  sync_jobs J || die "could not update the timer of job $n (disk full?)"
  echo "job=$n"; echo "state=$([[ $how == pause ]] && echo paused || echo on)"
}

# job-log <app> <name> [count]: the output of the last runs (default 3, at most 50), newest last.
# A run's lines are those after the journal cursor its history line holds, up to the cursor of the
# next run (the run in progress, or the end): counted, never by time or invocation id. A run whose
# lines the journal has rotated away says so (gone=1). Rows: run (start, seconds, result, status),
# then log=<line> (the last 200 lines of the run), or gone=1.
cmd_job_log() {
  need_root; app "$1"
  local n=${2:-} cnt=${3:-3} u f i t s d r c cu l ta tb out; local -a H=() JQ
  [[ $n =~ ^[a-z][a-z0-9-]{0,20}$ && -n ${C[job.$n]:-} ]] || die "$A has no job ${n//[^A-Za-z0-9_-]/?} (tando jobs lists them)"
  [[ $cnt =~ ^[0-9]{1,2}$ ]] && ((cnt >= 1 && cnt <= 50)) || die "how many runs: 1 to 50"
  f=$D/jobhist/$n; u=$(job_unit "$n").service
  [[ -s $f ]] || { echo "runs=0"; return 0; }
  job_jsync; job_jq "$u"
  mapfile -t H < "$f"
  local end=""   # the cursor the newest run's lines end at: a run in progress starts there
  [[ -f $f.run ]] && end=$(sed -n 2p "$f.run")
  local first=$((${#H[@]} - cnt)); ((first < 0)) && first=0
  for ((i = first; i < ${#H[@]}; i++)); do
    IFS=$'\t' read -r t d r s c <<< "${H[i]}"
    row run "$t" "$d" "$r" "$s"
    # the end of this run: the start of the next (its history line), or of the one in progress
    cu=$end
    ((i + 1 < ${#H[@]})) && { IFS=$'\t' read -r _ _ _ _ cu <<< "${H[i + 1]}"; }
    # (the last line before the run is still in the journal, or the run's own lines may be cut)
    if [[ -n $c ]] && (($("${JQ[@]}" --cursor="$c" -n 1 2> /dev/null | wc -l) == 0)); then echo "gone=1"; continue; fi
    if [[ -n $c ]]; then ta=$("${JQ[@]}" --after-cursor="$c" 2> /dev/null | wc -l); else ta=$("${JQ[@]}" 2> /dev/null | wc -l); fi
    tb=0
    if [[ -n $cu ]]; then tb=$("${JQ[@]}" --after-cursor="$cu" 2> /dev/null | wc -l)
    elif ((i + 1 < ${#H[@]})); then tb=$ta; fi   # (the next run's cursor is empty: it started on an empty journal)
    ((ta -= tb)); ((ta < 0)) && ta=0
    out=""
    if ((ta > 0)); then
      if [[ -n $c ]]; then out=$("${JQ[@]}" --after-cursor="$c" 2> /dev/null | head -n "$ta" | tail -n 200)
      else out=$("${JQ[@]}" 2> /dev/null | head -n "$ta" | tail -n 200); fi
    fi
    [[ -n $out ]] && while IFS= read -r l; do san_v "$l"; echo "log=$SAN"; done <<< "$out"
  done
  [[ -f $f.run && $(systemctl show -P ActiveState "$u") == activ* ]] && echo "running=1"
  return 0
}

# ---- workers ------------------------------------------------------------------------------------
#
# worker.<name> = <command> in tando.conf: a long-running process beside the web one (a queue
# consumer, a websocket server, a scheduler). Each is its own unit tando-<app>_worker-<name>.service
# ("_" is in neither an app nor a worker name, and "_worker-" is not "_job-": a unit name says
# exactly whose worker it is), in the app's slice, as the app's user, with the sandbox, env file
# and working directory (the release) of the web unit, no port, not in Caddy. Its command runs
# with sh -c when it has shell syntax, else as its words (exec-worker: the release's own
# settings, start/<id>). Settings per worker:
# worker.<name>.memory (default: the app's memory) and worker.<name>.stop_timeout (seconds SIGTERM
# gets before SIGKILL, default WORKER_GRACE). Restart=always with a backoff and no start limit: a
# worker that keeps crashing is restarted for ever (status, ls and the worker alert say so) and
# never takes the web process down. Not for static sites, not for containers (v1).
#
# Lifecycle: the workers that run are always those of the release `current` points at
# (workers_follow, one idempotent step). At a deploy or a rollback they follow once the web
# process passed its check through Caddy (finish): old workers stop gracefully, then the new ones
# start (one systemctl restart per unit: two generations never run together); the soak (or
# WORKER_SETTLE seconds without one) watches them with the web process, and a worker that does
# not stay up fails the release like a web crash (revert: the fallback's workers come back). A
# deploy whose web check fails never touches the running workers. Every step happens inside an
# operation's phase, before its end is committed: a crash anywhere is finished by recover, which
# runs finish or revert again; rec_service makes them follow in idle too (a reboot: the units are
# enabled and start on the release current points at).
WORKER_GRACE=30   # seconds a stopping worker may finish its work (worker.<name>.stop_timeout)
WORKER_SETTLE=3   # seconds new workers must stay up when the operation has no soak (a rollback)
worker_unit() { echo "tando-${A}_worker-$1"; }   # name -> unit name without .service
# worker_names [array]: the workers of app.conf (or the array), sorted
worker_names() {
  local -n _wn=${1:-C}
  local k
  for k in "${!_wn[@]}"; do [[ $k != worker.* || $k == worker.*.* ]] || echo "${k#worker.}"; done | LC_ALL=C sort
}
# worker_rows: one row per worker of the live release (app.conf), after its app row (srv/status
# prints the same): worker <app> <name> <state> <restarts> <memory> <max>. state: systemd's,
# "restarting" when it crashed and waits for its automatic restart, "stopped" when the app is;
# memory: anon + shmem of its cgroup; max: its MemoryMax (0: none)
worker_rows() {
  [[ " ${!C[*]}" == *" worker."* ]] || return 0
  local n u l st mem k v max
  for n in $(worker_names); do
    u=$(worker_unit "$n").service
    local -A W=()
    while IFS= read -r l; do W[${l%%=*}]=${l#*=}; done < <(systemctl show -p ActiveState,SubState,NRestarts,MemoryMax "$u" 2> /dev/null)
    st=${W[ActiveState]:-inactive}
    [[ $st == activating && ${W[SubState]:-} == auto-restart ]] && st=restarting
    [[ -n ${S[stopped]:-} ]] && st=stopped
    mem=0
    if [[ -r /sys/fs/cgroup/tando.slice/$(app_slice)/$u/memory.stat ]]; then
      while read -r k v; do [[ $k == anon || $k == shmem ]] && mem=$((mem + v)); done < "/sys/fs/cgroup/tando.slice/$(app_slice)/$u/memory.stat"
    fi
    max=${W[MemoryMax]:-}; [[ $max =~ ^[0-9]+$ ]] || max=0
    l=${W[NRestarts]:-0}; [[ $l =~ ^[0-9]+$ ]] || l=0
    row worker "$A" "$n" "$st" "$l" "$mem" "$max"
  done
}
# worker_file array name: the unit file of that worker, as the array's settings say
worker_file() {
  local -n _wf=$1
  local n=$2 mem keep=${C[memory]-} had=${C[memory]+x} rs=""
  mem=${_wf[worker.$n.memory]:-${_wf[memory]:-256M}}
  ((SD_V >= 254)) && rs=$'RestartSteps=6\nRestartMaxDelaySec=60\n'
  printf '[Unit]\nDescription=tando worker %s %s\nAfter=network.target\nStartLimitIntervalSec=0\n\n[Service]\n' "$A" "$n"
  printf 'ExecStart=%s exec-worker %s %s\nWorkingDirectory=%s/current\n' "$AGENT" "$A" "$n" "$D"
  printf 'Restart=always\nRestartSec=2\n%sTimeoutStopSec=%s\nSyslogIdentifier=%s\n' "$rs" \
    "${_wf[worker.$n.stop_timeout]:-$WORKER_GRACE}" "tando-$A-$n"
  # the job sandbox (no listening socket), with this worker's memory (and Node's heap cap from it)
  C[memory]=$mem
  props - job
  if [[ -n $had ]]; then C[memory]=$keep; else unset "C[memory]"; fi
  printf '\n[Install]\nWantedBy=multi-user.target\n'
}
# worker_runs unit id: it runs release id (or waits for its automatic restart, which starts what
# current points at: id). The release is the TANDO_RELEASE exec-worker gave it, else its cwd
worker_runs() {
  local -A U=(); local l r
  while IFS= read -r l; do U[${l%%=*}]=${l#*=}; done < <(systemctl show -p ActiveState,SubState,MainPID "$1" 2> /dev/null)
  case ${U[ActiveState]:-}:${U[SubState]:-} in
    activating:auto-restart) return 0;;
    active:*) ;;
    *) return 1;;
  esac
  [[ ${U[MainPID]:-0} =~ ^[1-9][0-9]*$ ]] || return 1
  r=$(tr '\0' '\n' < "/proc/${U[MainPID]}/environ" 2> /dev/null | sed -n 's/^TANDO_RELEASE=//p' | head -1)
  [[ -n $r ]] || { r=$(readlink "/proc/${U[MainPID]}/cwd" 2> /dev/null); r=${r#"$D"/releases/}; r=${r%%/*}; }
  [[ $r == "$2" ]]
}
# workers_follow [all]: the worker units become those of the release current points at, each
# running it; with "all" every one restarts (tando restart, a new env). None runs when the app is
# stopped or has no release (their units stay, disabled). A worker no longer configured is stopped
# (its stop_timeout), disabled and removed. Only what differs is touched; an app that has no
# workers and had none returns at once. Sets WK_UNITS (the units that must run). Returns 1 (WF_WHY)
# when a unit could not be written or started.
# shellcheck disable=SC2034  # WC is read by worker_names and worker_file through their namerefs
workers_follow() {
  local id u f n changed=0 run=() gone=() off=() want=" "
  WK_UNITS=() WF_WHY=""
  # (no worker in the settings and no unit of one: nothing to do, no fork; every recover asks)
  [[ " ${!C[*]}" == *" worker."* ]] || compgen -G "/etc/systemd/system/tando-${A}_worker-*.service" > /dev/null || return 0
  id=$(cur_link)
  local -A WC=()
  conf_copy C WC
  if valid_id "$id" && [[ -r $D/start/$id ]] && grepq -x conf=1 "$D/start/$id"; then
    local -A RS=(); load "$D/start/$id" RS; rec_put RS WC
  fi
  local names; names=$(worker_names WC)
  # (static and container apps have none: their units, if any, go)
  { has_unit && [[ ${C[recipe]:-node} != container ]]; } || names=""
  local stopped=${S[stopped]:-}; [[ -n $id ]] || stopped=1
  for n in $names; do
    u=$(worker_unit "$n").service f=/etc/systemd/system/$u
    want+="$n "
    if ! { fp wk.write && worker_file WC "$n" > "$f.new" && [[ $(tail -1 "$f.new") == WantedBy=multi-user.target ]]; }; then
      rm -f "$f.new"; WF_WHY="could not write the unit of worker $n (disk full?)"; return 1
    fi
    if cmp -s "$f.new" "$f"; then rm -f "$f.new"
    elif mv -f "$f.new" "$f"; then changed=1; [[ ${1:-} == all ]] || run+=("$u")
    else rm -f "$f.new"; WF_WHY="could not install the unit of worker $n"; return 1; fi
    if [[ -n $stopped ]]; then off+=("$u"); else WK_UNITS+=("$u"); fi
  done
  for f in /etc/systemd/system/tando-"$A"_worker-*.service; do
    [[ -f $f ]] || continue
    u=${f##*/}; n=${u#tando-"$A"_worker-}; n=${n%.service}
    [[ $want == *" $n "* ]] || gone+=("$u")
  done
  # removed ones first, each given its stop_timeout to finish
  if ((${#gone[@]})); then
    { fp wk.stop && systemctl disable -q --now "${gone[@]}" 2> /dev/null; } ||
      { WF_WHY="could not stop worker ${gone[0]#tando-"$A"_worker-}"; return 1; }
    for u in "${gone[@]}"; do rm -f "/etc/systemd/system/$u"; done
    systemctl reset-failed "${gone[@]}" 2> /dev/null; changed=1
  fi
  ((changed)) && systemctl daemon-reload
  if ((${#off[@]})); then
    { fp wk.stop && systemctl disable -q --now "${off[@]}" 2> /dev/null; } || { WF_WHY="could not stop the workers"; return 1; }
    return 0
  fi
  ((${#WK_UNITS[@]})) || return 0
  if [[ ${1:-} == all ]]; then run=("${WK_UNITS[@]}")
  else
    for u in "${WK_UNITS[@]}"; do
      [[ " ${run[*]} " == *" $u "* ]] || worker_runs "$u" "$id" || run+=("$u")
    done
  fi
  # one call: systemd stops each old process (its stop_timeout) and then starts the new one, all
  # workers at once (a deploy waits for the slowest stop, not for their sum)
  if ((${#run[@]})); then
    systemctl reset-failed "${run[@]}" 2> /dev/null
    { fp wk.start && systemctl restart "${run[@]}"; } || { WF_WHY="the workers could not be started (systemctl restart failed)"; return 1; }
  fi
  local todo=()
  for u in "${WK_UNITS[@]}"; do systemctl -q is-enabled "$u" 2> /dev/null || todo+=("$u"); done
  ((${#todo[@]})) && { systemctl enable -q "${todo[@]}" 2> /dev/null || { WF_WHY="could not enable the workers"; return 1; }; }
  return 0
}
# wk_state units...: "<unit> <ActiveState>/<SubState> <NRestarts>" per unit
wk_state() {
  (($#)) || return 0
  systemctl show -p Id,ActiveState,SubState,NRestarts "$@" 2> /dev/null | awk -F= '
    $1 == "Id" { u = $2 } $1 == "ActiveState" { s = $2 } $1 == "SubState" { ss = $2 } $1 == "NRestarts" { n = $2 }
    /^$/ { if (u != "") print u, s "/" ss, n; u = "" } END { if (u != "") print u, s "/" ss, n }'
}
# workers_ok base: every worker in WK_UNITS runs and was not restarted since base (wk_state's
# output then); WF_WHY names the first that is not. An empty answer (systemd busy) counts as up.
workers_ok() {
  local u s n b
  while read -r u s n; do
    [[ -n $u ]] || continue
    b=$(awk -v u="$u" '$1 == u { print $3 }' <<< "$1")
    if [[ ${s%/*} != active || ( $n =~ ^[0-9]+$ && $b =~ ^[0-9]+$ && $n != "$b" ) ]]; then
      n=${u#tando-"$A"_worker-}; WF_WHY="worker ${n%.service}: $(soak_why "$u")"; return 1
    fi
  done < <(wk_state "${WK_UNITS[@]}")
  return 0
}

# exec-worker <app> <name>: runs as the app user inside the worker's unit, in the release current
# pointed at when it started; the command comes from that release's own settings (start/<id>)
cmd_exec_worker() {
  app "$1"
  local n=${2:-} rid
  rid=$(pwd -P); rid=${rid##*/}
  valid_id "$rid" || die "no release"
  rel_conf "$rid"
  local cmd=${C[worker.$n]:-}
  [[ -n $cmd ]] || die "release $rid has no worker ${n//[^a-z0-9-]/?}"
  [[ ${C[recipe]:-node} == python && -d $PWD/.venv ]] && export VIRTUAL_ENV=$PWD/.venv PATH="$PWD/.venv/bin:$PATH"
  export TANDO_RELEASE=$rid TANDO_WORKER=$n
  # shell syntax: sh -c; else the words themselves, so the worker is the unit's main process and
  # gets its stop signal once, from systemd
  case $cmd in *[\|\&\;\<\>\$\`\"\'\(\)\*\?\~\{\}\#\\]*) exec /bin/sh -c "$cmd";; esac
  local argv; read -ra argv <<< "$cmd"
  exec "${argv[@]}"
}

# ---- hold: an app taken off line by the control plane (app.hold, app.release) -----------------
# hold <app> pause|suspend [message]: the app is stopped as by `tando stop` (its web unit, workers
# and wake socket off and disabled: a reboot keeps it so) and Caddy answers 503 "<app> is paused"
# (or suspended, with the message after it). Its job timers are off (sync_jobs), its daily backup
# is skipped (its data stays as it is), and deploy, start, restart, rollback, a restore and a job
# run are refused until `release`. The state keeps hold (the reason), hold_since, hold_note,
# hold_pre_stopped (it was stopped before: release keeps it stopped) and hold_release (the release
# that was current: never pruned while held). suspend (an abuse takedown) also freezes evidence
# first: the app's journal, its request logs, the current release's id and file sums, in
# $EVID/<app>/<time>/ (root 700, with SHA256SUMS); kept until the app is destroyed.
EVID=/var/lib/tando/ctl/evidence
# what a message may hold: it goes into the Caddyfile between double quotes, where a brace would
# be a placeholder ({env.*}, {file.*}) and a quote or backslash would end or escape the string
HOLD_NOTE_RE="^[A-Za-z0-9 .,:;!?'()/@+_-]{1,200}\$"
held_refuse() { # what is refused while the app is held
  [[ -z ${S[hold]:-} ]] || die "$A is held (${S[hold]}): release it first"
}
# hold_page: the text Caddy answers with while the app is held (write_caddy)
hold_page() {
  local t="$A is paused"
  [[ ${S[hold]} == suspend ]] && t="$A is suspended"
  [[ -n ${S[hold_note]:-} && ${S[hold_note]} =~ $HOLD_NOTE_RE ]] && t+=". ${S[hold_note]}"
  echo "$t"
}
# hold_evidence: the suspended app's journal, request logs and release, frozen (HE_DIR)
hold_evidence() {
  local t d f j id=${S[current]:-}
  t=$(date -u +%Y%m%d-%H%M%S)
  install -d -m 700 -o root -g root /var/lib/tando/ctl "$EVID" "$EVID/$A" || return 1
  d=$EVID/$A/$t; [[ -e $d ]] && d+=-$$
  install -d -m 700 -o root -g root "$d" || return 1
  HE_DIR=$d
  ( umask 077
    j=$(jns)
    # (the app's own namespace when it has one: every unit of the app logs there)
    if [[ -n $j ]]; then journalctl --namespace="tando-$A" -o export --no-pager > "$d/journal.export"
    else journalctl -u "tando-$A.service" -u "tando-${A}_*" -o export --no-pager > "$d/journal.export"; fi
    for f in "/var/log/tando/$A"/access.log*; do [[ -f $f && ! -L $f ]] && cp -p -- "$f" "$d/"; done
    valid_id "$id" && [[ -f $D/sums/$id && ! -L $D/sums/$id ]] && cp -p -- "$D/sums/$id" "$d/release.sums"
    printf 'app=%s\nreason=suspend\nrelease=%s\ntime=%s\nby=%s\nnote=%s\n' "$A" "${id:--}" "$(now)" "${SUDO_USER:-root}" "${S[hold_note]:-}" > "$d/info"
    cd "$d" && sha256sum -- * > SHA256SUMS ) || return 1
  chmod -R go= "$d"
}
cmd_hold() { # app pause|suspend [message]
  need_root; app "$1"; recover
  local why=${2:-} note=${3:-}
  [[ $why == pause || $why == suspend ]] || die "hold: pause or suspend"
  [[ -z $note || $note =~ $HOLD_NOTE_RE ]] ||
    die "hold: the message is at most 200 letters, digits, spaces and . , : ; ! ? ' ( ) / @ + _ -"
  lock 300; load "$D/state" S
  AUDIT_NOTE="$why"
  if [[ -n ${S[hold]:-} ]]; then
    # a suspend is lifted only by release (a pause must not soften it); a pause becomes a suspend
    [[ ${S[hold]} == suspend && $why == pause ]] && die "$A is held (suspend): release it first"
    if [[ ${S[hold]} == "$why" ]]; then
      st hold_note "$note" || die "could not save the state (disk full?)"
      write_caddy || die "${WC_WHY:-Caddy refused the site}"
      echo already=1; echo hold="$why"; return 0
    fi
  fi
  local pre=${S[stopped]:-}
  [[ -n ${S[hold]:-} ]] && pre=${S[hold_pre_stopped]:-}
  S[hold_note]=$note
  if [[ $why == suspend ]]; then
    if hold_evidence; then echo "evidence=$HE_DIR"
    else echo "tando-agent: the evidence of $A could not be written in full (disk full?); it is held all the same" >&2; echo evidence=0; fi
  fi
  S[hold]=$why S[hold_since]=$(now) S[hold_pre_stopped]=$pre S[hold_release]=${S[current]:-} S[stopped]=1
  unset "S[down]"
  # (phase stop: a hold cut off here is finished by recover as a stop; the state says held already)
  st phase stop || die "could not save the state (disk full?); $A is not held"
  if ! { fp hold.stop && stop_app; }; then
    # (logged, not undone: a takedown that half worked is finished by the next recover)
    die "${WC_WHY:-systemctl stop failed}; $A is held, but not all of it stopped yet (recovery retries)"
  fi
  jobs_follow || echo "tando-agent: the job timers of $A could not be stopped yet: recovery retries" >&2
  st phase idle
  echo hold="$why"; echo held=1; echo healthy=1
}
cmd_release() { # app
  need_root; app "$1"; recover
  lock 300; load "$D/state" S
  [[ -n ${S[hold]:-} ]] || { echo already=1; echo held=0; echo healthy=1; return 0; }
  local was=${S[hold]} pre=${S[hold_pre_stopped]:-}
  AUDIT_NOTE="was $was"
  unset "S[hold]" "S[hold_since]" "S[hold_note]" "S[hold_pre_stopped]" "S[hold_release]"
  if [[ -n $pre || -z ${S[current]:-} ]]; then
    # stopped before the hold (tando stop): it stays stopped, with the stopped page
    save "$D/state" S || die "could not save the state (disk full?)"
    write_caddy || echo "tando-agent: ${WC_WHY:-Caddy refused the site}" >&2
    jobs_follow || echo "tando-agent: the job timers of $A could not be updated yet: recovery retries" >&2
    echo released="$was"; echo stopped=1; echo healthy=1; return 0
  fi
  # (phase start: cut off, recover starts it)
  st phase start || die "could not save the state (disk full?); $A is still held"
  if ! restart_app; then
    st phase idle
    die "${WC_WHY:-systemctl start failed}: $A is released but did not start (it is stopped: tando start)"
  fi
  workers_follow all || echo "tando-agent: $WF_WHY" >&2
  jobs_follow || echo "tando-agent: the job timers of $A could not be updated yet: recovery retries" >&2
  st phase idle
  echo released="$was"
  if via_caddy "$(app_unit)"; then echo healthy=1; else echo healthy=0; fi
}

# ---- dispatch ------------------------------------------------------------------------------

verb=${1:-}
shift || true
# one audit line per mutating verb and per read of a secret; deploys are written by the activation
case $verb in
  setup) audit setup -;;
  runtime) audit runtime -;;
  domain-add|domain-rm) audit "$verb" "${1:-}";;
  activate|run-activation) audit deploy "${1:-}";;
  configure|rollback|env-set|env-unset|env-ls|start|stop|restart|unlock|destroy|backup-run|\
  backup-restore|backup-cat|db-url|db-psql|shell|job-run|job-pause|hold|release) audit "$verb" "${1:-}";;
  db-studio|db-studio-code|db-studio-stop) audit "$verb" "${1:-}";;
  backup-drill) audit "$verb" "${1:-}";;
  data-link|data-unlink|db-link) audit "$verb" -;;
  data-db) audit "$verb" "${2:-}";;
  db-remote-set) audit "$verb" "${1:-}";;
  preview-up|preview-rm) audit "$verb" "${2:-}";;
esac
# Verbs that change an app run to their end when the ssh session that started them drops: the
# next write to the closed connection would otherwise kill the agent half-way (an app stopped
# for a restore and never started again, a new env never checked). Their output then goes
# nowhere. (A handler, not an ignored signal: the commands they run keep the default.)
case $verb in
  configure|rollback|env-set|env-unset|start|stop|restart|destroy|backup-run|backup-restore|domain-add|domain-rm|preview-up|preview-rm|backup-drill|hold|release)
    trap 'exec > /dev/null 2>&1' PIPE HUP;;
esac
case $verb in
  info) cmd_info;;
  setup) cmd_setup "$@";;
  runtime) cmd_runtime "$@";;
  domain-add) cmd_domain add "$@";;
  domain-rm) cmd_domain rm "$@";;
  domain-ls) cmd_domain ls "$@";;
  domain-check) cmd_domain_check "$@";;
  doctor) cmd_doctor "$@";;
  configure) cmd_configure "$@";;
  begin) cmd_begin "$@";;
  end) cmd_end "$@";;
  activate) cmd_activate "$@";;
  run-activation) cmd_run_activation "$@";;
  recover) cmd_recover "$@";;
  recover-all) cmd_recover_all;;
  rollback) cmd_rollback "$@";;
  deploy-status) cmd_deploy_status "$@";;
  status) cmd_status "$@";;
  status-follow) die "no live view without tando-status: run tando host setup";;
  releases) cmd_releases_verb "$@";;
  history) cmd_history "$@";;
  env-set) cmd_env set "$@";;
  env-unset) cmd_env unset "$@";;
  env-ls) cmd_env ls "$@";;
  env-names) cmd_env_names "$@";;
  env-log) cmd_env_log "$@";;
  start|stop|restart) cmd_svc "$verb" "$@";;
  hold) cmd_hold "$@";;
  release) cmd_release "$@";;
  logs|log-stats|log-doctor|req-summary|req-tail|req-errors|audit-read|errors)
    if [[ $verb == logs ]] && valid_app "${1:-}" &&
       [[ $(sed -n 's/^recipe=//p' "$R/apps/$1/app.conf" 2> /dev/null) == static ]]; then
      die "$1 is a static site: it has no process and no app log; tando requests shows its requests"
    fi
    if [[ ! -x $LOGS ]]; then
      [[ $verb == logs ]] && cmd_logs "$@" && exit 0
      die "tando-logs is not installed: run tando host setup"
    fi
    exec "$LOGS" "$verb" "$@";;
  exec-app) cmd_exec_app "$@";;
  exec-worker) cmd_exec_worker "$@";;
  exec-release) cmd_exec_release "$@";;
  run-job) cmd_run_job "$@";;
  jobs) cmd_jobs "$@";;
  unlock) cmd_unlock "$@";;
  app-down) cmd_app_down "$@";;
  container-stop) cmd_container_stop "$@";;
  destroy) cmd_destroy "$@";;
  backup-run) cmd_backup_run "$@";;
  backup-all) cmd_backup_all;;   # the backup queue (tando-backups.service)
  backup-drill) cmd_backup_drill "$@";;
  origin-update) cmd_origin_update "$@";;   # the daily refresh of the edge's ranges (tando-origin.service)
  backup-drill-all) cmd_backup_drill_all;;   # the monthly drills (tando-drill.service)
  preview-up) cmd_preview_up "$@";;
  preview-ls) cmd_preview_ls "$@";;
  preview-rm) cmd_preview_rm "$@";;
  preview-sweep) cmd_preview_sweep;;   # tando-previews.service, hourly
  backup-ls) cmd_backup_ls "$@";;
  backup-cat) cmd_backup_cat "$@";;
  backup-restore) cmd_backup_restore "$@";;
  db-url) cmd_db_url "$@";;
  db-psql) cmd_db_psql "$@";;
  db-info) cmd_db_info "$@";;
  data-link) cmd_data_link "$@";; data-unlink) cmd_data_unlink "$@";; data-db) cmd_data_db "$@";; data-renew) cmd_data_renew;; data-ca) cmd_data_ca;;
  db-link) cmd_db_link "$@";; db-remote-set) cmd_db_remote_set "$@";;
  db-studio) cmd_db_studio "$@";; db-studio-ls) cmd_db_studio_ls "$@";; db-studio-stop) cmd_db_studio_stop "$@";;
  db-studio-code) cmd_db_studio_code "$@";; db-studio-lower) cmd_db_studio_lower "$@";;
  shell) cmd_shell "$@";;
  shell-put) cmd_shell_put "$@";;
  busy) cmd_busy "$@";;
  job-run) cmd_job_run "$@";;
  idle-stopped) cmd_idle_stopped "$@";;
  job-begin) cmd_job_begin "$@";; job-end) cmd_job_end "$@";; job-due) cmd_job_due "$@";; job-gone) cmd_job_gone "$@";; job-pause) cmd_job_pause "$@";; job-log) cmd_job_log "$@";;
  host)   # host care (docs/HOSTCARE.md): the server itself, answered by tando-host (Go, srv/hostcare)
    need_root
    [[ -x $R/bin/tando-host ]] || die "host care is not installed on <host>: tando host setup <host> installs it"
    exec "$R/bin/tando-host" "$@";;
  adopt-scan|adopt-apply|adopt-run|adopt-status|adopt-undo|adopt-undo-run|adopt-site)
    # `tando adopt` (docs/MIGRATION.md): the client installs $R/bin/tando-adopt before calling these
    [[ -f $R/bin/tando-adopt && $(stat -c %U:%a "$R/bin/tando-adopt") == root:[67][04][04] ]] ||
      die "the adopt helper is not installed: run tando adopt from the laptop"
    # lint: allow RL03 R is /opt/tando; the helper is checked above: root's, writable by root only
    . "$R/bin/tando-adopt"
    "cmd_${verb//-/_}" "$@";;
  *) die "unknown verb: $verb";;
esac; DISPATCHED=1
# (an error inside $(( )) ends the whole case above, not the script: never report that as done)
[[ -n ${DISPATCHED:-} ]] || { AUDIT_NOTE="aborted by an internal error"; exit 1; }
exit 0
