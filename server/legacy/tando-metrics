#!/bin/bash
# tando-metrics: per-minute samples of every tando app, for graphs (tando top, tando status).
# Installed as /opt/tando/bin/tando-metrics (root 755); run by tando-metrics.timer.
#
#   tando-metrics sample                       append one line per app and one for the host
#   tando-metrics read <app|host> <points> <bucket seconds>
#                                              the last <points> buckets, averaged
#
# Files: /var/lib/tando/metrics/<app>.tsv (and <app>.tsv.1, the previous half), one line a minute:
#   time  mem_bytes (anon + shmem)  cpu_usec_since_last_sample  restarts  state(r|s|f|a)
# host.tsv: time  load1x100  mem_used_bytes  mem_total_bytes
# Each file covers at most 3.5 days or 5100 lines, then becomes .1 (the old .1 is dropped), so an
# app keeps at most 7 days, about 2 x 160 KB. Reading needs no root (files are 644).
# Nothing keeps running; a sample costs one systemctl call and a few /sys reads.
set -uo pipefail
umask 022

R=/opt/tando
M=${TANDO_METRICS_DIR:-/var/lib/tando/metrics}
CG=/sys/fs/cgroup/system.slice
SPAN=302400        # seconds per file (3.5 days)
MAXLINES=5100

die() { echo "tando-metrics: $*" >&2; exit 1; }

# rotate file start_var lines_var: start a new file when the current one is full
rotate() {
  local f=$1 start=$2 lines=$3
  if (( lines >= MAXLINES || (start > 0 && NOW - start >= SPAN) )); then
    [[ -f $f ]] && mv -f "$f" "$f.1"
    return 0
  fi
  return 1
}

cmd_sample() {
  [[ $EUID -eq 0 ]] || die "sample runs as root (from tando-metrics.timer)"
  [[ -d $M ]] || mkdir -p "$M" || die "cannot create $M"
  NOW=$(printf '%(%s)T' -1)
  declare -A PU PS PN          # previous usec, file start time, line count, from $M/.state
  local a u s n names=() units=() f k v l i
  if [[ -r $M/.state ]]; then
    while read -r a u s n; do [[ -n $a ]] && { PU[$a]=$u PS[$a]=$s PN[$a]=$n; }; done < "$M/.state"
  fi
  for f in "$R"/apps/*/app.conf; do
    [[ -f $f ]] || continue
    a=${f%/app.conf}; a=${a##*/}
    [[ $a =~ ^[a-z][a-z0-9-]{1,25}$ ]] || continue
    names+=("$a"); units+=("tando-$a.service")
  done
  local state_out=""
  if ((${#names[@]})); then
    declare -A U
    i=0
    while IFS= read -r l; do
      if [[ -n $l ]]; then U[${l%%=*}]=${l#*=}; continue; fi
      ((i < ${#names[@]})) || break
      a=${names[i]}
      local mem=0 usec=0 d st rs=${U[NRestarts]:-0} file=$M/$a.tsv
      cgd=/sys/fs/cgroup/tando.slice/tando-${a//-/\\x2d}.slice/tando-$a.service   # (its app's slice)
      [[ -d $cgd ]] || cgd=$CG/tando-$a.service
      if [[ -r $cgd/memory.stat ]]; then
        while read -r k v; do [[ $k == anon || $k == shmem ]] && mem=$((mem + v)); done < "$cgd/memory.stat"
      fi
      if [[ -r $cgd/cpu.stat ]]; then
        while read -r k v; do [[ $k == usage_usec ]] && { usec=$v; break; }; done < "$cgd/cpu.stat"
      fi
      d=$((usec - ${PU[$a]:-$usec}))
      ((d < 0)) && d=$usec                       # the unit restarted: its counter began again
      case ${U[ActiveState]:-inactive} in
        active) st=r;; failed) st=f;; inactive) st=s;; *) st=a;;
      esac
      s=${PS[$a]:-0} n=${PN[$a]:-0}
      if rotate "$file" "$s" "$n" || ((s == 0)); then s=$NOW n=0; fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$NOW" "$mem" "$d" "$rs" "$st" >> "$file"
      state_out+="$a $usec $s $((n + 1))"$'\n'
      U=(); i=$((i + 1))
    done < <(systemctl show -p ActiveState,NRestarts "${units[@]}"; echo)
  fi
  # host
  local la mt=0 ma=0 file=$M/host.tsv
  read -r la _ < /proc/loadavg
  while read -r k v _; do
    case $k in MemTotal:) mt=$v;; MemAvailable:) ma=$v; break;; esac
  done < /proc/meminfo
  s=${PS[.host]:-0} n=${PN[.host]:-0}
  if rotate "$file" "$s" "$n" || ((s == 0)); then s=$NOW n=0; fi
  la=${la/./}; la=$((10#$la))
  printf '%s\t%s\t%s\t%s\n' "$NOW" "$la" $(((mt - ma) * 1024)) $((mt * 1024)) >> "$file"
  state_out+=".host 0 $s $((n + 1))"$'\n'
  printf '%s' "$state_out" > "$M/.state.tmp" && mv -f "$M/.state.tmp" "$M/.state"
}

# read <app|host> <points> <bucket>: rows "m <bucket start> <mem avg> <cpu permille avg>
# <restarts max> <last state>" for buckets with data, oldest first, after "mx <bucket> <now>".
# Host rows: "h <bucket start> <load x100 avg> <mem used avg> <mem total>".
cmd_read() {
  local who=${1:-} pts=${2:-60} bk=${3:-60} f need now from
  [[ $who == host || $who =~ ^[a-z][a-z0-9-]{1,25}$ ]] || die "bad app name"
  [[ $pts =~ ^[0-9]{1,4}$ && $pts -ge 1 && $pts -le 2000 ]] || die "bad point count"
  [[ $bk =~ ^[0-9]{2,5}$ && $bk -ge 60 && $bk -le 86400 ]] || die "bad bucket"
  f=$M/$who.tsv
  now=$(printf '%(%s)T' -1)
  from=$(( (now / bk - pts + 1) * bk ))
  need=$(( pts * bk / 60 + 2 ))
  printf 'mx\t%s\t%s\n' "$bk" "$now"
  [[ -r $f || -r $f.1 ]] || return 0
  local t a b c d e pt=0 cb=-1 n=0 s1=0 s2=0 mx=0 last="" cpu dt tot=0
  while IFS=$'\t' read -r t a b c d; do
    [[ $t =~ ^[0-9]+$ ]] || continue
    if [[ $who == host ]]; then
      cpu=$a e=$c
    else
      dt=$((t - pt)); ((pt == 0 || dt <= 0 || dt > 600)) && dt=60
      cpu=$((b / (dt * 1000)))                 # usec over dt seconds -> permille of one core
    fi
    pt=$t
    ((t < from)) && continue
    local bb=$((t / bk * bk))
    if ((bb != cb)); then
      if ((n > 0)); then
        if [[ $who == host ]]; then printf 'h\t%s\t%s\t%s\t%s\n' "$cb" $((s1 / n)) $((s2 / n)) "$tot"
        else printf 'm\t%s\t%s\t%s\t%s\t%s\n' "$cb" $((s2 / n)) $((s1 / n)) "$mx" "$last"; fi
      fi
      cb=$bb n=0 s1=0 s2=0 mx=0
    fi
    if [[ $who == host ]]; then s1=$((s1 + cpu)) s2=$((s2 + b)) tot=$e
    else s1=$((s1 + cpu)) s2=$((s2 + a)); ((c > mx)) && mx=$c; last=$d; fi
    n=$((n + 1))
  done < <({ [[ -r $f.1 ]] && tail -n "$need" "$f.1"; [[ -r $f ]] && tail -n "$need" "$f"; } | tail -n "$need")
  if ((n > 0)); then
    if [[ $who == host ]]; then printf 'h\t%s\t%s\t%s\t%s\n' "$cb" $((s1 / n)) $((s2 / n)) "$tot"
    else printf 'm\t%s\t%s\t%s\t%s\t%s\n' "$cb" $((s2 / n)) $((s1 / n)) "$mx" "$last"; fi
  fi
}

case ${1:-} in
  sample) cmd_sample;;
  read) shift; cmd_read "$@";;
  *) die "usage: tando-metrics sample | read <app|host> <points> <bucket seconds>";;
esac
exit 0
